---
import "../styles/global.css";
import Header from "../components/layout/Header.astro"
import Footer from "../components/layout/Footer.astro"
import Logo from "../components/ui/Logo.astro"
import CustomLoader from "../components/ui/CustomLoader.astro"

import { get } from "../lib/strapi";

const { titulo, descripcion, imagen, tipo = "website", keywords } = Astro.props;

const siteConfig = await get("site-config", { populate: "*" });
const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const siteName = siteConfig?.siteName;
const defaultDescription = siteConfig?.tagline;
const defaultKeywords = keywords;
const primaryColor = siteConfig?.primaryColor;
const urlActual = Astro.url.href;
const tituloCompleto = titulo ? `${titulo} | ${siteName}` : siteName;
const descripcionFinal = descripcion || defaultDescription;
const imagenFinal = imagen;

const faviconUrl = siteConfig?.favicon?.url
  ? `${PUBLIC_STRAPI_URL}${siteConfig.favicon.url}`
  : "/favicon.svg";

const logoUrl = siteConfig?.logo?.url
  ? `${PUBLIC_STRAPI_URL}${siteConfig.logo.url}`
  : "/logo.svg";

const logoAlt = siteConfig?.logoAlt;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme) {
        document.documentElement.setAttribute('data-theme', theme);
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcionFinal} />
    <meta name="keywords" content={defaultKeywords} />
    <meta name="author" content={siteName} />

    <title>{tituloCompleto}</title>

    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={urlActual} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:image" content={imagenFinal} />
    <meta property="og:site_name" content={siteName} />

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={faviconUrl} />

    <link rel="canonical" href={urlActual} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <meta name="theme-color" content={primaryColor} />
    <meta name="robots" content="index, follow" />
  </head>

  <body class="flex flex-col min-h-screen bg-bg-primary">
    <div id="global-loader" class="fixed inset-0 bg-bg-primary z-9999 flex items-center justify-center transition-opacity duration-300">
      <CustomLoader size={60} color={primaryColor} />
    </div>

    <Header siteConfig={siteConfig} logoUrl={logoUrl} logoAlt={logoAlt} />

    <script>
      window.addEventListener("load", () => {
        const loader = document.getElementById("global-loader");
        if (loader) {
          loader.style.opacity = "0";
          setTimeout(() => {
            loader.style.display = "none";
          }, 300);
        }
      });
    </script>

    <main id="main-content" class="grow">
      <slot />
    </main>

    <Footer siteConfig={siteConfig} logoUrl={logoUrl} logoAlt={logoAlt} />
  </body>
</html>
