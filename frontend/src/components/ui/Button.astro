---
interface Props {
  content?: string;
  link?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  isExternal?: boolean;
  className?: string;
  type?: "button" | "submit" | "reset";
  onclick?: string;
  id?: string;
}

const {
  content,
  link,
  variant = "primary",
  isExternal = false,
  className = "",
  type,
  onclick,
  id,
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center rounded-lg font-semibold transition-all duration-200 cursor-pointer";

const variantClasses: Record<string, string> = {
  primary: "bg-primary text-text-inverse hover:bg-primary-dark px-6 py-3",
  secondary: "bg-secondary text-text-inverse hover:bg-secondary-light px-6 py-3",
  outline: "border-2 border-primary text-primary hover:bg-primary-pale px-6 py-3 font-semibold",
  ghost: "text-primary hover:text-primary-dark px-6 py-3",
};

const getVariantClass = (v: string) => {
  return variantClasses[v] || variantClasses.primary;
};

const buttonClasses = `${baseClasses} ${getVariantClass(variant)} ${className}`;
---

{
  type ? (
    <button type={type} class={buttonClasses} onclick={onclick} id={id}>
      <slot>{content}</slot>
    </button>
  ) : (
    <a
      href={link}
      class={buttonClasses}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
      id={id}
    >
      <slot>{content}</slot>
    </a>
  )
}
