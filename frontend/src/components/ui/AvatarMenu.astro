---
import Avatar from "./Avatar.astro"

interface Props {
  avatarSrc?: string;
  username?: string;
}

const { avatarSrc, username = "Usuario" } = Astro.props;
const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const resolvedSrc = avatarSrc
  ? (avatarSrc.startsWith("http") ? avatarSrc : `${PUBLIC_STRAPI_URL}${avatarSrc}`)
  : undefined;
---

<div id="avatar-menu-wrapper" class="relative">
  <!-- Avatar trigger -->
  <button
    id="avatar-trigger"
    type="button"
    class="relative p-1 rounded-full cursor-pointer transition-colors hover:bg-bg-secondary focus:outline-none focus:ring-2 focus:ring-primary/40"
    aria-label="Menú de usuario"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <Avatar src={resolvedSrc} size="sm" />
  </button>

  <!-- Dropdown -->
  <div
    id="avatar-dropdown"
    class="avatar-dropdown"
    role="menu"
    aria-label="Opciones de usuario"
  >
    <!-- User info header -->
    <div class="avatar-dropdown__header">
      <span class="avatar-dropdown__username" id="avatar-dropdown-username">{username}</span>
    </div>

    <div class="avatar-dropdown__divider"></div>

    <!-- Menu items -->
    <a href="/perfil#pedidos" class="avatar-dropdown__item" role="menuitem">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-seam shrink-0" viewBox="0 0 16 16">
        <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/>
      </svg>
      <span>Pedidos</span>
    </a>

    <a href="/perfil" class="avatar-dropdown__item" role="menuitem">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person shrink-0" viewBox="0 0 16 16">
        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
      </svg>
      <span>Mi cuenta</span>
    </a>

    <div class="avatar-dropdown__divider"></div>

    <button
      id="logout-btn"
      type="button"
      class="avatar-dropdown__item avatar-dropdown__item--danger"
      role="menuitem"
    >
      <!-- bi-box-arrow-right -->
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" style="flex-shrink:0">
        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
      </svg>
      <span>Cerrar sesión</span>
    </button>
  </div>
</div>

<style>
  .avatar-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 14rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    overflow: hidden;
    z-index: 100;

    /* Hidden by default */
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.95);
    pointer-events: none;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .avatar-dropdown.is-open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .avatar-dropdown__header {
    padding: 0.75rem 1rem;
  }

  .avatar-dropdown__username {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-primary);
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .avatar-dropdown__divider {
    height: 1px;
    background-color: var(--border-color);
  }

  .avatar-dropdown__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    color: var(--text-primary);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .avatar-dropdown__item:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .avatar-dropdown__item--danger {
    color: var(--error);
  }

  .avatar-dropdown__item--danger:hover {
    background-color: color-mix(in srgb, var(--error) 8%, transparent);
    color: var(--error);
  }

  .avatar-dropdown__icon {
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }
</style>

<script>
  import { $user } from "../../stores/appStore";

  const wrapper = document.getElementById("avatar-menu-wrapper");
  const trigger = document.getElementById("avatar-trigger");
  const dropdown = document.getElementById("avatar-dropdown");
  const logoutBtn = document.getElementById("logout-btn");
  const usernameEl = document.getElementById("avatar-dropdown-username");

  // Keep username in sync with store
  $user.subscribe((user) => {
    if (usernameEl && user?.username) {
      usernameEl.textContent = user.username;
    }
  });

  function openDropdown() {
    dropdown?.classList.add("is-open");
    trigger?.setAttribute("aria-expanded", "true");
  }

  function closeDropdown() {
    dropdown?.classList.remove("is-open");
    trigger?.setAttribute("aria-expanded", "false");
  }

  function toggleDropdown() {
    const isOpen = dropdown?.classList.contains("is-open");
    if (isOpen) {
      closeDropdown();
    } else {
      openDropdown();
    }
  }

  // Toggle on avatar click
  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleDropdown();
  });

  // Close on click outside
  document.addEventListener("click", (e) => {
    if (wrapper && !wrapper.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeDropdown();
    }
  });

  // Close on menu item click (links)
  dropdown?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeDropdown();
    });
  });

  // Logout
logoutBtn?.addEventListener("click", async () => {
    closeDropdown();
    const { clearCartOnLogout } = await import("../../utils/cartService");
    clearCartOnLogout();
    localStorage.clear(); // limpia TODO de una vez
    window.location.href = "/login";
});
</script>
