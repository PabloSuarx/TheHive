---
interface Props {
  src?: string;
  alt?: string;
  size?: "sm" | "md" | "lg";
  className?: string;
}

const { src, alt = "Avatar de usuario", size = "md", className = "" } = Astro.props;

const sizeClasses = {
  sm: "w-8 h-8",
  md: "w-10 h-10",
  lg: "w-12 h-12",
};
---

<div
  class:list={[
    "relative p-0.5 rounded-full overflow-hidden flex items-center justify-center bg-transparent border border-primary",
    sizeClasses[size],
    className,
  ]}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    ) : (
      <svg
        class="w-full h-full text-primary fill-current"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
        />
      </svg>
    )
  }
</div>
