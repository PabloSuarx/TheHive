---
interface Props {
  homeLabel?: string;
  separator?: string;
  class?: string;
  currentClass?: string;
}

const { homeLabel = "Home", separator = ">" } = Astro.props;

const paths = Astro.url.pathname.split('/').filter(Boolean);
const parts = paths.map((part, index) => {
  const href = `/${paths.slice(0, index + 1).join('/')}`;
  const label = part.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  return {
    label,
    href,
    isCurrent: index === paths.length - 1,
  };
});
---

<nav aria-label="Breadcrumb" class="flex items-center text-sm text-text-tertiary">
  <ol class="flex items-center flex-wrap">
    <li class="flex items-center">
      <a href="/" class="hover:text-primary transition-colors whitespace-nowrap">{homeLabel}</a>
    </li>
    {parts.map(({ label, href, isCurrent }) => (
      <li class="flex items-center">
        <span class="mx-2 text-divider">{separator}</span>
        {isCurrent ? (
          <span class="font-medium text-text-primary" aria-current="page">{label}</span>
        ) : (
          <a href={href} class="hover:text-primary transition-colors whitespace-nowrap">{label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
