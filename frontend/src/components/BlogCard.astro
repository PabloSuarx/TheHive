---
interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  imageUrl?: string;
  author?: string;
  blogPublishedAt?: string;
  categoryName?: string;
  categorySlug?: string;
  className?: string;
}

const { title, slug, excerpt, imageUrl, author, blogPublishedAt, categoryName, className = '' } = Astro.props;

const placeholder = 'https://images.unsplash.com/photo-1587049352846-4a222e784387?w=600&h=400&fit=crop';
const imgSrc = imageUrl || placeholder;

const formatDate = (dateStr?: string) => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
};

const wordCount = excerpt ? excerpt.split(/\s+/).length : 0;
const readTime = Math.max(3, Math.ceil(wordCount / 40));
---

<article class={`group ${className}`}>
  <a href={`/blog/${slug}`} class="block">
    <div class="relative overflow-hidden rounded-xl mb-4">
      <img src={imgSrc} alt={title} class="w-full h-48 object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
    </div>

    {categoryName && <span class="text-sm text-[#F59E0B] font-semibold">{categoryName}</span>}
    <h3 class="text-xl font-bold text-gray-900 mt-2 mb-2 group-hover:text-[#F59E0B] transition-colors line-clamp-2">{title}</h3>
    
    {excerpt && <p class="text-gray-600 text-sm mb-3 line-clamp-3">{excerpt}</p>}
    
    <div class="flex items-center gap-2 text-sm text-gray-500">
      {author && (<><span>{author}</span><span>•</span></>)}
      {blogPublishedAt && (<><span>{formatDate(blogPublishedAt)}</span><span>•</span></>)}
      <span>{readTime} min lectura</span>
    </div>
    
  </a>
</article>