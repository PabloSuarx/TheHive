---
interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---

<section class:list={["orders-list", className]} id="pedidos">
  <h2 class="orders-list__title">Mis Pedidos</h2>

  <!-- Loading state: hidden by default, shown by script before fetch -->
  <div id="orders-loading" class="orders-list__state hidden" aria-live="polite">
    <svg
      class="orders-list__spinner"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <circle class="spinner-track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
      <path
        class="spinner-fill"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      ></path>
    </svg>
    <p class="orders-list__state-text">Cargando tus pedidos...</p>
  </div>

  <!-- Error state -->
  <div id="orders-error" class="orders-list__state orders-list__state--error hidden" aria-live="assertive">
    <!-- bi-exclamation-circle -->
    <svg xmlns="http://www.w3.org/2000/svg" class="orders-list__state-icon" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
      <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
    </svg>
    <p id="orders-error-message" class="orders-list__state-text">Error al cargar los pedidos.</p>
    <button id="orders-retry-btn" class="orders-list__retry-btn" type="button">Reintentar</button>
  </div>

  <!-- Empty state -->
  <div id="orders-empty" class="orders-list__state hidden" aria-live="polite">
    <!-- bi-box-seam -->
    <svg xmlns="http://www.w3.org/2000/svg" class="orders-list__state-icon" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.34zm-14 0v7.94l6.5 2.34V6.24z"/>
    </svg>
    <p class="orders-list__state-text">Aún no tienes pedidos</p>
  </div>

  <!-- Orders container (populated by JS) -->
  <div id="orders-container" class="orders-list__grid hidden" aria-live="polite"></div>
</section>

<script>
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // ─── DOM refs ───────────────────────────────────────────────────────────────
  const ordersLoading   = document.getElementById("orders-loading");
  const ordersError     = document.getElementById("orders-error");
  const ordersErrorMsg  = document.getElementById("orders-error-message");
  const ordersEmpty     = document.getElementById("orders-empty");
  const ordersContainer = document.getElementById("orders-container");
  const retryBtn        = document.getElementById("orders-retry-btn");

  // ─── Auth ───────────────────────────────────────────────────────────────────
  const jwt    = localStorage.getItem("jwt");
  const userId = localStorage.getItem("userId");

  // ─── UI state machine ────────────────────────────────────────────────────────
  function showOnly(el: HTMLElement | null) {
    [ordersLoading, ordersError, ordersEmpty, ordersContainer].forEach((e) =>
      e?.classList.add("hidden")
    );
    el?.classList.remove("hidden");
  }

  // ─── Bootstrap SVGs (inline) ─────────────────────────────────────────────────
  // bi-clock
  const SVG_CLOCK = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/></svg>`;
  // bi-check-circle
  const SVG_CHECK = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/></svg>`;
  // bi-truck
  const SVG_TRUCK = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456M12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/></svg>`;
  // bi-x-circle
  const SVG_X = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/></svg>`;
  // bi-box-seam (used in card header)
  const SVG_BOX = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" style="opacity:0.55;flex-shrink:0"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.34zm-14 0v7.94l6.5 2.34V6.24z"/></svg>`;

  // ─── Status config ──────────────────────────────────────────────────────────
  const STATUS_CONFIG: Record<string, { label: string; color: string; icon: string }> = {
    procesando: { label: "Procesando", color: "var(--warning)", icon: SVG_CLOCK },
    confirmado: { label: "Confirmado", color: "var(--info)",    icon: SVG_CHECK },
    enviado:    { label: "Enviado",    color: "var(--info)",    icon: SVG_TRUCK },
    entregado:  { label: "Entregado",  color: "var(--success)", icon: SVG_CHECK },
    cancelado:  { label: "Cancelado",  color: "var(--error)",   icon: SVG_X     },
  };


  // ─── Render helpers ──────────────────────────────────────────────────────────
  function fmtDate(isoStr: string): string {
    if (!isoStr) return "—";
    return new Date(isoStr).toLocaleDateString("es-ES", {
      day: "numeric", month: "long", year: "numeric",
    });
  }

  function fmtMoney(n: number): string {
    return n.toLocaleString("es-ES", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function renderOrderLines(lines: any[]): string {
    if (!lines?.length) return "";
    return `
      <ul class="order-card__lines">
        ${lines.map((line) => {
          const name = line.product?.name ?? line.product?.title ?? "Producto";
          return `
            <li class="order-card__line">
              <span class="order-card__line-name">${name}</span>
              <span class="order-card__line-meta">${line.quantity} × ${fmtMoney(line.unitPrice)} €</span>
            </li>`;
        }).join("")}
      </ul>`;
  }

  function renderOrderCard(order: any): string {
    const rawStatus = (order.orderStatus ?? "procesando").toLowerCase();
    const cfg = STATUS_CONFIG[rawStatus] ?? { label: rawStatus, color: "var(--text-tertiary)", icon: "" };
    const orderNum = order.orderNumber ?? `#${order.id}`;
    const placedAt = fmtDate(order.placedAt ?? order.createdAt);
    const total    = fmtMoney(order.total ?? 0);
    const lines    = order.Orders ?? [];

    return `
      <article class="order-card" style="--status-color:${cfg.color}">
        <div class="order-card__header">
          <span class="order-card__number">
            ${SVG_BOX}
            Pedido <span class="order-card__num-id">${orderNum}</span>
          </span>
          <span class="order-card__badge">
            ${cfg.icon}
            ${cfg.label}
          </span>
        </div>
        ${renderOrderLines(lines)}
        <div class="order-card__footer">
          <span class="order-card__date">${placedAt}</span>
          <span class="order-card__total">${total}&nbsp;€</span>
        </div>
      </article>`;
  }

  // ─── Fetch ───────────────────────────────────────────────────────────────────
  async function loadOrders() {
    if (!jwt) {
      showOnly(ordersEmpty);
      return;
    }

    showOnly(ordersLoading);

    try {
      const params = new URLSearchParams({
        "populate[orders][populate][Orders][populate][product]": "*",
        "populate[orders][populate][Address]": "*",
      });

      const res = await fetch(`${STRAPI_URL}/api/users/me?${params}`, {
        headers: { Authorization: `Bearer ${jwt}` },
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json();
      const orders: any[] = data.orders ?? [];

      if (orders.length === 0) {
        showOnly(ordersEmpty);
      } else {
        // Sort client-side by placedAt desc (API/users/me doesn't accept sort param)
        orders.sort((a, b) =>
          new Date(b.placedAt ?? b.createdAt).getTime() -
          new Date(a.placedAt ?? a.createdAt).getTime()
        );
        if (ordersContainer) {
          ordersContainer.innerHTML = orders.map(renderOrderCard).join("");
        }
        showOnly(ordersContainer);
      }
    } catch (err: any) {
      console.error("[OrdersList] fetch error:", err);
      if (ordersErrorMsg) {
        ordersErrorMsg.textContent =
          err?.message?.includes("401")
            ? "Tu sesión ha expirado. Vuelve a iniciar sesión."
            : "Error al cargar los pedidos. Inténtalo de nuevo.";
      }
      showOnly(ordersError);
    }
  }

  // ─── Init ────────────────────────────────────────────────────────────────────
  loadOrders();
  retryBtn?.addEventListener("click", loadOrders);
</script>

<style>
  .orders-list {
    padding: 2rem 1rem 3rem;
  }

  .orders-list__title {
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* ── State containers ── */
  .orders-list__state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    text-align: center;
  }

  .orders-list__state--error { color: var(--error); }

  .orders-list__state-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text-tertiary);
  }

  .orders-list__state--error .orders-list__state-icon { color: var(--error); }

  .orders-list__state-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  .orders-list__state--error .orders-list__state-text { color: var(--error); }

  /* ── Spinner ── */
  .orders-list__spinner {
    width: 2.5rem;
    height: 2.5rem;
    animation: orders-spin 0.9s linear infinite;
    color: var(--primary);
  }
  .spinner-track { opacity: 0.2; }
  .spinner-fill  { opacity: 0.85; }
  @keyframes orders-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ── Retry button ── */
  .orders-list__retry-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--error);
    border: 1px solid var(--error);
    border-radius: 0.5rem;
    background: none;
    cursor: pointer;
    transition: background-color var(--transition-fast);
    margin-top: 0.25rem;
  }
  .orders-list__retry-btn:hover {
    background-color: color-mix(in srgb, var(--error) 10%, transparent);
  }

  /* ── Grid ── */
  .orders-list__grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 42rem;
    margin: 0 auto;
  }

  /* Hidden utility */
  .hidden { display: none !important; }
</style>

<style is:global>
  /* Order cards are injected by JS, so CSS must be global */
  .order-card {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    background-color: var(--bg-primary);
    box-shadow: none;
    transition: border-color var(--transition-fast);
  }

  .order-card:hover { border-color: var(--primary); }

  .order-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
  }

  .order-card__number {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .order-card__num-id {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-weight: 400;
    word-break: break-all;
  }

  .order-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.1875rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    color: var(--status-color);
    background-color: color-mix(in srgb, var(--status-color) 12%, transparent);
  }

  /* Product lines inside a card */
  .order-card__lines {
    list-style: none;
    padding: 0;
    margin: 0 0 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 0.5rem 0;
  }

  .order-card__line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .order-card__line-name {
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .order-card__line-meta {
    color: var(--text-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .order-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .order-card__date {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .order-card__total {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }
</style>
