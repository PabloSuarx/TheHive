---
interface Props {
  className?: string;
  ordersTitle: string;
  ordersLoadingText: string;
  ordersErrorText: string;
  ordersRetryButtonText: string;
  ordersEmptyText: string;
  ordersEmptyIcon: string;
  ordersErrorIcon: string;
  errorMessageExpiredSession: string;
  errorMessageDefault: string;
  orderLabelText: string;
  orderStatusProcessing: string;
  orderStatusConfirmed: string;
  orderStatusShipped: string;
  orderStatusDelivered: string;
  orderStatusCancelled: string;
  orderIconClock: string;
  orderIconCheck: string;
  orderIconTruck: string;
  orderIconX: string;
  orderIconBox: string;
}

const {
  className = "",
  ordersTitle,
  ordersLoadingText,
  ordersErrorText,
  ordersRetryButtonText,
  ordersEmptyText,
  ordersEmptyIcon,
  ordersErrorIcon,
  errorMessageExpiredSession,
  errorMessageDefault,
  orderLabelText,
  orderStatusProcessing,
  orderStatusConfirmed,
  orderStatusShipped,
  orderStatusDelivered,
  orderStatusCancelled,
  orderIconClock,
  orderIconCheck,
  orderIconTruck,
  orderIconX,
  orderIconBox,
} = Astro.props;
---

<section class:list={["py-8 px-4 pb-12", className]} id="pedidos">
  <h2 class="font-bold text-text-primary mb-6 text-center">{ordersTitle}</h2>

  <!-- Loading state: hidden by default, shown by script before fetch -->
  <div id="orders-loading" class="flex-col items-center justify-center gap-3 py-12 px-4 text-center hidden" aria-live="polite">
    <svg
      class="w-10 h-10 animate-spin text-primary"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
      <path
        class="opacity-85"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      ></path>
    </svg>
    <p class="text-[0.9375rem] text-text-secondary mb-0">{ordersLoadingText}</p>
  </div>

  <!-- Error state -->
  <div id="orders-error" class="flex-col items-center justify-center gap-3 py-12 px-4 text-center text-error hidden" aria-live="assertive">
    <div class="w-10 h-10 text-error" set:html={ordersErrorIcon}></div>
    <p id="orders-error-message" class="text-[0.9375rem] text-error mb-0">{ordersErrorText}</p>
    <button id="orders-retry-btn" class="inline-flex items-center gap-1.5 py-1.5 px-4 text-[0.8125rem] font-semibold text-error border border-error rounded-lg bg-transparent cursor-pointer transition-colors duration-150 mt-1 hover:bg-error/10" type="button">{ordersRetryButtonText}</button>
  </div>

  <!-- Empty state -->
  <div id="orders-empty" class="flex-col items-center justify-center gap-3 py-12 px-4 text-center hidden" aria-live="polite">
    <div set:html={ordersEmptyIcon}></div>
    <p class="text-[0.9375rem] text-text-secondary mb-0">{ordersEmptyText}</p>
  </div>

  <!-- Orders container (populated by JS) -->
  <div id="orders-container" class="flex-col gap-3 max-w-2xl mx-auto hidden" aria-live="polite"></div>
</section>

<script define:vars={{
  errorMessageExpiredSession,
  errorMessageDefault,
  orderLabelText,
  orderStatusProcessing,
  orderStatusConfirmed,
  orderStatusShipped,
  orderStatusDelivered,
  orderStatusCancelled,
  orderIconClock,
  orderIconCheck,
  orderIconTruck,
  orderIconX,
  orderIconBox,
}}>
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // ─── DOM refs ───────────────────────────────────────────────────────────────
  const ordersLoading   = document.getElementById("orders-loading");
  const ordersError     = document.getElementById("orders-error");
  const ordersErrorMsg  = document.getElementById("orders-error-message");
  const ordersEmpty     = document.getElementById("orders-empty");
  const ordersContainer = document.getElementById("orders-container");
  const retryBtn        = document.getElementById("orders-retry-btn");

  // ─── Auth ───────────────────────────────────────────────────────────────────
  const jwt    = localStorage.getItem("jwt");
  const userId = localStorage.getItem("userId");

  // ─── UI state machine ────────────────────────────────────────────────────────
  function showOnly(el) {
    [ordersLoading, ordersError, ordersEmpty, ordersContainer].forEach((e) => {
      e?.classList.add("hidden");
      e?.classList.remove("flex");
    });
    el?.classList.remove("hidden");
    el?.classList.add("flex");
  }

  // ─── Status config (using props from Strapi) ────────────────────────────────
  const STATUS_CONFIG = {
    procesando: { label: orderStatusProcessing, color: "var(--warning)", icon: orderIconClock },
    confirmado: { label: orderStatusConfirmed,  color: "var(--info)",    icon: orderIconCheck },
    enviado:    { label: orderStatusShipped,    color: "var(--info)",    icon: orderIconTruck },
    entregado:  { label: orderStatusDelivered,  color: "var(--success)", icon: orderIconCheck },
    cancelado:  { label: orderStatusCancelled,  color: "var(--error)",   icon: orderIconX     },
  };


  // ─── Render helpers ──────────────────────────────────────────────────────────
  function fmtDate(isoStr) {
    if (!isoStr) return "—";
    return new Date(isoStr).toLocaleDateString("es-ES", {
      day: "numeric", month: "long", year: "numeric",
    });
  }

  function fmtMoney(n) {
    return n.toLocaleString("es-ES", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function renderOrderLines(lines) {
    if (!lines?.length) return "";
    return `
      <ul class="list-none p-0 m-0 mb-2.5 flex flex-col gap-1 border-t border-b border-border-default py-2">
        ${lines.map((line) => {
          const name = line.product?.name ?? line.product?.title ?? "Producto";
          return `
            <li class="flex justify-between items-center gap-2 text-[0.8125rem]">
              <span class="text-text-secondary overflow-hidden text-ellipsis whitespace-nowrap">${name}</span>
              <span class="text-text-tertiary whitespace-nowrap shrink-0">${line.quantity} × ${fmtMoney(line.unitPrice)} €</span>
            </li>`;
        }).join("")}
      </ul>`;
  }

  function renderOrderCard(order) {
    const rawStatus = (order.orderStatus ?? "procesando").toLowerCase();
    const cfg = STATUS_CONFIG[rawStatus] ?? { label: rawStatus, color: "var(--text-tertiary)", icon: "" };
    const orderNum = order.orderNumber ?? `#${order.id}`;
    const placedAt = fmtDate(order.placedAt ?? order.createdAt);
    const total    = fmtMoney(order.total ?? 0);
    const lines    = order.Orders ?? [];

    return `
      <article class="p-4 px-5 border border-border-default rounded-xl bg-bg-primary shadow-none transition-colors duration-150 hover:border-primary" style="--status-color:${cfg.color}">
        <div class="flex items-center justify-between gap-2 mb-2.5">
          <span class="inline-flex items-center gap-1.5 font-semibold text-[0.9375rem] text-text-primary">
            ${orderIconBox}
            ${orderLabelText} <span class="text-xs text-text-tertiary font-normal break-all">${orderNum}</span>
          </span>
          <span class="inline-flex items-center gap-1 shrink-0 py-0.5 px-2.5 text-xs font-semibold rounded-full text-[var(--status-color)] bg-[color-mix(in_srgb,var(--status-color)_12%,transparent)]">
            ${cfg.icon}
            ${cfg.label}
          </span>
        </div>
        ${renderOrderLines(lines)}
        <div class="flex items-center justify-between mt-2">
          <span class="text-[0.8125rem] text-text-secondary">${placedAt}</span>
          <span class="font-bold text-base text-text-primary">${total}&nbsp;€</span>
        </div>
      </article>`;
  }

  // ─── Fetch ───────────────────────────────────────────────────────────────────
  async function loadOrders() {
    if (!jwt) {
      showOnly(ordersEmpty);
      return;
    }

    showOnly(ordersLoading);

    try {
      const params = new URLSearchParams({
        "populate[orders][populate][Orders][populate][product]": "*",
        "populate[orders][populate][Address]": "*",
      });

      const res = await fetch(`${STRAPI_URL}/api/users/me?${params}`, {
        headers: { Authorization: `Bearer ${jwt}` },
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json();
      const orders = data.orders ?? [];

      if (orders.length === 0) {
        showOnly(ordersEmpty);
      } else {
        // Sort client-side by placedAt desc (API/users/me doesn't accept sort param)
        orders.sort((a, b) =>
          new Date(b.placedAt ?? b.createdAt).getTime() -
          new Date(a.placedAt ?? a.createdAt).getTime()
        );
        if (ordersContainer) {
          ordersContainer.innerHTML = orders.map(renderOrderCard).join("");
        }
        showOnly(ordersContainer);
      }
    } catch (err) {
      console.error("[OrdersList] fetch error:", err);
      if (ordersErrorMsg) {
        ordersErrorMsg.textContent =
          err?.message?.includes("401")
            ? errorMessageExpiredSession
            : errorMessageDefault;
      }
      showOnly(ordersError);
    }
  }

  // ─── Init ────────────────────────────────────────────────────────────────────
  loadOrders();
  retryBtn?.addEventListener("click", loadOrders);
</script>
