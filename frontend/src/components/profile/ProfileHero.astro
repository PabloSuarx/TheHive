---
import Avatar from "../ui/Avatar.astro"

interface Props {
  className?: string;
  avatarUploadAriaLabel: string;
  avatarCameraIcon: string;
  loadingText: string;
}

const {
  className = "",
  avatarUploadAriaLabel,
  avatarCameraIcon,
  loadingText,
} = Astro.props;
const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
---

<section class:list={["py-12 px-4 bg-linear-to-b from-bg-primary to-bg-secondary", className]} id="profile-hero">
  <div class="max-w-3xl mx-auto flex flex-col items-center gap-6 text-center">
    <!-- Avatar con input oculto para cambiar foto -->
    <div class="relative">
      <button
        type="button"
        id="avatar-upload-trigger"
        class="relative w-24 h-24 rounded-full overflow-hidden cursor-pointer border-3 border-primary bg-bg-secondary p-0 transition-colors duration-250 hover:border-primary-dark group"
        aria-label={avatarUploadAriaLabel}
      >
        <div id="avatar-display" class="w-full h-full rounded-full overflow-hidden [&_img]:w-full [&_img]:h-full [&_img]:object-cover">
          <Avatar size="lg" className="w-full! h-full!" />
        </div>
        <div class="absolute inset-0 flex items-center justify-center bg-overlay-dark text-text-inverse opacity-0 transition-opacity duration-150 rounded-full group-hover:opacity-100" set:html={avatarCameraIcon}>
        </div>
      </button>
      <input
        type="file"
        id="avatar-file-input"
        accept="image/*"
        class="hidden"
        aria-hidden="true"
      />
    </div>

    <!-- Info del usuario -->
    <div class="flex flex-col gap-1">
      <h1 id="profile-username" class="text-[clamp(1.5rem,3vw,2rem)] font-bold text-text-primary mb-0">{loadingText}</h1>
      <p id="profile-email" class="text-sm text-text-secondary mb-0"></p>
    </div>
  </div>
</section>
