---
import Logo from "../ui/Logo.astro"
import AvatarMenu from "../ui/AvatarMenu.astro"
import ThemeToggle from "../ui/ThemeToggle.astro"
import { get } from "../../lib/strapi"
import type { NavLink } from "../../types/header"

const { siteConfig, logoUrl, logoAlt } = Astro.props;

const siteName = siteConfig.siteName;

const navigationData = await get("navigation", { populate: "menuItems" });

const navLinks: NavLink[] = navigationData?.menuItems || [];

const sortedLinks = navLinks.sort((a, b) => a.order - b.order);
---

<header class="bg-bg-primary sticky top-0 z-50">
  <nav
    class="container mx-auto px-4 lg:px-8 py-6"
    aria-label="Navegación principal"
  >
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-3 group"
        aria-label={`${siteName} - Inicio`}
      >
        <div class="w-32 min-h-16 -my-9">
          <Logo logoUrl={logoUrl} logoAlt={logoAlt} />
        </div>
      </a>

      <ul class="hidden lg:flex items-center gap-8">
        {
          sortedLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target={link.newTab ? "_blank" : undefined}
                rel={link.isExternal ? "noopener noreferrer" : undefined}
                class="text-primary transition-colors font-medium relative group"
              >
                {link.label}
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all group-hover:w-full" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-4">
        <!-- User Avatar Menu (Hidden by default, toggled by JS) -->
        <div id="user-menu" class="hidden">
          <AvatarMenu />
        </div>

        <!-- Login Button (Visible by default, toggled by JS) -->
        <a
            id="login-button"
            href="/login"
            class="text-sm font-medium text-primary hover:text-primary-dark transition-colors"
        >
            Iniciar Sesión
        </a>

        <a
          href="/carrito"
          class="relative p-2 text-primary hover:text-primary-dark transition-colors rounded-lg hover:bg-bg-secondary"
          aria-label="Carrito de compra"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cart3" viewBox="0 0 16 16">
            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4M5 13a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
          </svg>
          <span
            class="cart-count absolute -top-1 -right-1 bg-primary text-text-inverse text-xs font-bold rounded-full w-5 h-5 items-center justify-center hidden"
          >
            0
          </span>
        </a>

        <ThemeToggle />

        <button
          id="mobile-menu-button"
          class="lg:hidden text-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary rounded-lg p-2 transition-colors"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
        >
          <svg
            id="menu-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="hidden lg:hidden mt-4 pb-4 border-t border-border-color pt-4"
    >
      <ul class="flex flex-col gap-2">
        {
          sortedLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target={link.newTab ? "_blank" : undefined}
                rel={link.isExternal ? "noopener noreferrer" : undefined}
                class="block text-primary hover:text-primary-dark hover:bg-bg-secondary transition-colors font-medium py-3 px-4 rounded-lg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  import { $user, $isAuthLoading } from "../../stores/appStore";
  import { cartStore, initCartService } from "../../utils/cartService";

  // DOM Elements
  const loginButton = document.getElementById("login-button");
  const userMenu = document.getElementById("user-menu");
  const cartBadge = document.querySelector(".cart-count");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileMenuIcon = document.getElementById("menu-icon");
  const mobileCloseIcon = document.getElementById("close-icon");

  // --- AUTH LOGIC ---

  // Subscribe to user changes
  $user.subscribe((user) => {
    const isAuthenticated = !!user?.jwt;

    if (isAuthenticated) {
      loginButton?.classList.add("hidden");
      userMenu?.classList.remove("hidden");
    } else {
      loginButton?.classList.remove("hidden");
      userMenu?.classList.add("hidden");
    }
  });

  // Validate session on mount
  const validateSession = async () => {
    const user = $user.get();
    if (user?.jwt) {
      try {
        // Verify JWT with Strapi
        // Note: Assuming a custom endpoint or standard /users/me content
         const response = await fetch(`${import.meta.env.PUBLIC_STRAPI_URL}/api/users/me`, {
          headers: {
            Authorization: `Bearer ${user.jwt}`,
          },
        });

        if (!response.ok) {
          throw new Error("Session invalid");
        }
      } catch (error) {
        console.error("Session validation failed:", error);
        $user.set(null); // Clear invalid session
      } finally {
        $isAuthLoading.set(false);
      }
    } else {
      $isAuthLoading.set(false);
    }
  };

  // Run validation
  validateSession();

  // --- CART LOGIC ---

  // Init cart service (loads from Strapi if authenticated, from localStorage if guest)
  initCartService();

  // Subscribe to cart changes
  cartStore.subscribe((state) => {
    const count = parseInt(state.count, 10) || 0;
    if (cartBadge) {
      cartBadge.textContent = count.toString();
      if (count === 0) {
        cartBadge.classList.add("hidden");
        cartBadge.classList.remove("flex");
      } else {
        cartBadge.classList.remove("hidden");
        cartBadge.classList.add("flex");
      }
    }
  });

  // --- UI INTERACTION ---

  const toggleMobileMenu = () => {
    const isOpen = mobileMenuButton?.getAttribute("aria-expanded") === "true";
    mobileMenuButton?.setAttribute("aria-expanded", String(!isOpen));
    mobileMenu?.classList.toggle("hidden");
    mobileMenuIcon?.classList.toggle("hidden");
    mobileCloseIcon?.classList.toggle("hidden");
  };

  mobileMenuButton?.addEventListener("click", toggleMobileMenu);

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      mobileMenuIcon?.classList.remove("hidden");
      mobileCloseIcon?.classList.add("hidden");
      mobileMenuButton?.setAttribute("aria-expanded", "false");
    });
  });
</script>
