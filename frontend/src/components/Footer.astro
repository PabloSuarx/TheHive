---
import { getFooter } from "../lib/strapi";
import Logo from './Logo.astro';

const { siteConfig, logoUrl, logoAlt } = Astro.props;

interface Link {
  id: number;
  label: string;
  url: string;
  column: string;
  order: number;
}
interface Social {
  id: number;
  platform: string;
  url: string;
  icon: string;
}
interface LinksByColumn {
  [key: string]: Link[];
}

const footerData = await getFooter();

const siteName: string = siteConfig.siteName;
const companyDescription: string = footerData.companyDescription;
const copyrightText: string = footerData.copyrightText;
const links: Link[] = footerData.links;
const socialMedia: Social[] = footerData.socialMedia;
const showSocialMedia: boolean = footerData.showSocialMedia;

const linksByColumn = links.reduce<LinksByColumn>((acc, link) => {
  const column = link.column?.trim();
  if (!acc[column]) acc[column] = [];
  acc[column].push(link);
  return acc;
}, {});

const columnOrder = ["General","Empresa", "Ayuda", "Legal"];
---

<footer class="bg-bg-footer text-tertiary mt-auto">
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <a href="/" class="min-h-16 w-96 -my-12.5">
            <Logo logoUrl={logoUrl} logoAlt={logoAlt} />
          </a>
        </div>
        <p class="text-sm text-secondary leading-relaxed">
          {companyDescription}
        </p>

        {
          showSocialMedia && socialMedia.length > 0 && (
            <div class="flex gap-4 pt-2">
              {socialMedia.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 rounded-lg flex items-center justify-center transition-colors"
                  aria-label={social.platform}
                >
                  <span set:html={social.icon} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        columnOrder.map((columnName) => {

          const columnLinks = linksByColumn[columnName];

          return columnLinks && columnLinks.length > 0 ? (

            <div>
              <h3 class="text-inverse font-semibold text-lg mb-4">
                {columnName}
              </h3>
              <ul class="space-y-2">
                {columnLinks
                  .sort((a, b) => a.order - b.order)
                  .map((link) => (
                    <li>
                      <a
                        href={link.url}
                        class="text-sm hover:text-primary transition-colors"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ) 
          : null;
        })
      }
    </div>
  </div>

  <div class="border-t border-divider">
    <div class="container mx-auto px-4 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-secondary text-center md:text-left">
          {copyrightText}
        </p>

        <p class="text-xs text-tertiary text-center md:text-right max-w-md">
          <strong class="text-primary">Proyecto Educativo:</strong> Este sitio web
          fue desarrollado con fines académicos. No se realizan transacciones reales
          ni envíos de productos.
        </p>
      </div>
    </div>
  </div>
</footer>