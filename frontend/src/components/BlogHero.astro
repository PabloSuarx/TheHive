---
import { Image } from "astro:assets";
import type { Blog } from "../types/blog";

interface Props {
    blog: Blog;
    breadcrumName?: string;
    breadcrumBlog?: string;
    imageUrl?: string;
}

const {
    blog,
    breadcrumName = "Inicio",
    breadcrumBlog = "Blog",
    imageUrl,
} = Astro.props;

const formatDate = (dateStr: string) => {
    if (!dateStr) return "";
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};

const wordCount = blog.content
    ? blog.content.replace(/<[^>]*>/g, "").split(/\s+/).length
    : 0;
const readTime = Math.max(3, Math.ceil(wordCount / 200));
---

<section class="relative h-[400px] lg:h-[500px] overflow-hidden">
    {
        imageUrl && (
            <Image
                src={imageUrl}
                alt={blog.title}
                class="absolute inset-0 w-full h-full object-cover"
                width={1920}
                height={1080}
                loading="eager"
            />
        )
    }
    <div
        class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-transparent"
    >
    </div>

    <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-end pb-12"
    >
        <div class="max-w-3xl">
            <nav class="flex mb-4 text-sm font-medium text-white/80">
                <a class="hover:text-white transition-colors" href="/"
                    >{breadcrumName}
                </a>
                <span class="mx-2 text-white/50">/</span>

                <a class="hover:text-white transition-colors" href="/blog"
                    >{breadcrumBlog}
                </a>
                <span class="mx-2 text-white/50">/</span>

                {
                    blog.blog_category && (
                        <>
                            <span class="text-white/80">
                                {blog.blog_category.name}
                            </span>
                            <span class="mx-2 text-white/50">/</span>
                        </>
                    )
                }
                <span class="text-white truncate max-w-[200px]"
                    >{blog.title}
                </span>
            </nav>

            {
                blog.blog_category && (
                    <span class="inline-block px-4 py-1 bg-[#F59E0B] text-white text-sm font-semibold rounded-full mb-4">
                        {blog.blog_category.name}
                    </span>
                )
            }
            <h1
                class="text-3xl lg:text-5xl font-bold text-white mb-6 leading-tight"
            >
                {blog.title}
            </h1>

            <div
                class="flex flex-wrap items-center gap-4 text-white/80 text-sm"
            >
                {
                    blog.author && (
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-linear-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white font-bold text-xs">
                                {blog.author.charAt(0).toUpperCase()}
                            </div>
                            <span>{blog.author}</span>
                        </div>
                    )
                }
                {
                    blog.blogPublishedAt && (
                        <div class="flex items-center gap-1">
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                />
                            </svg>
                            <span>{formatDate(blog.blogPublishedAt)}</span>
                        </div>
                    )
                }
                <div class="flex items-center gap-1">
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    <span>{readTime} min lectura</span>
                </div>
            </div>
        </div>
    </div>
</section>
