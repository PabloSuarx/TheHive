---
import Button from './Button.astro';
import { getButtons } from '../lib/strapi';

interface ButtonData {
  content: string;
  link: string;
  variant: string;
  isExternal: boolean;
}

interface Props {
  name: string;
  className?: string;
}

const { name, className } = Astro.props;

const buttons: ButtonData[] = await getButtons();

const btn = buttons.find(button => button.content === name);
---

{btn ? (
  <Button
    content={btn.content}
    link={btn.link}
    variant={btn.variant}
    isExternal={btn.isExternal}
    className={className}
  />
) : null}