---
import { get } from "../../../lib/strapi"
import type { Testimonial } from "../../../types/home"

const single = await get("testimonials-section", {
  populate: {
    testimonials: {
      populate: "*"
    },
  },
});

const fallbackData = {
  title: "Lo Que Dicen Nuestros Clientes",
  subtitle: "Miles de personas ya disfrutan de nuestra miel",
  testimonials: [
    {
      text: "La mejor miel que he probado nunca. El sabor a azahar es increíble y se nota que es 100% natural. ¡Repito cada mes!",
      author: "María Carmen",
      location: "Málaga",
      rating: 5,
    },
    {
      text: "Excelente calidad y envío rapidísimo. Funciona de maravilla y además está deliciosa. ¡Totalmente recomendable!",
      author: "Javier Pérez",
      location: "Madrid",
      rating: 5,
    },
    {
      text: "Desde que descubrí The Hive no compro otra miel. La de romero es espectacular para el desayuno.",
      author: "Ana Rodríguez",
      location: "Sevilla",
      rating: 5,
    },
  ] as Testimonial[],
};

const data = single || fallbackData;
const testimonials = data.testimonials || [];
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2>{data.title}</h2>
      <p class="text-lead text-text-secondary mt-4">
        {data.subtitle}
      </p>
    </div>

    {
      testimonials.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {testimonials.map((testimonial: Testimonial) => (
            <article class="bg-bg-primary p-8 rounded-2xl border border-divider">
              <div class="flex items-center gap-1 mb-4">
                {[...Array(testimonial.rating)].map(() => (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="bi bi-star-fill text-warning"
                    viewBox="0 0 16 16"
                  >
                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                  </svg>
                ))}
              </div>
              <p class="text-text-secondary mb-6 italic">"{testimonial.text}"</p>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-linear-to-br from-primary to-warning rounded-full flex items-center justify-center text-text-inverse font-bold">
                  {testimonial.author
                    .split(" ")
                    .map((n) => n[0])
                    .join("")}
                </div>
                <div>
                  <div class="font-semibold text-text-primary">
                    {testimonial.author}
                  </div>
                  <div class="text-sm text-text-tertiary">{testimonial.location}</div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-tertiary">No hay testimonios disponibles en este momento.</p>
        </div>
      )
    }
  </div>
