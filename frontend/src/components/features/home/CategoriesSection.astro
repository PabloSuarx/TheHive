---
import CategoryCard from "../category/CategoryCard.astro"

interface Props {
  categories: any[];
  publicStrapiUrl: string;
}

const { categories, publicStrapiUrl } = Astro.props;
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2>Nuestras Categorías</h2>
      <p class="text-lead text-text-secondary mt-4">
        Explora nuestra selección de mieles artesanales, cada una con su
        carácter único
      </p>
    </div>

    {
      categories.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {categories.map((cat) => {
            const imageUrl = cat.image?.url
              ? `${publicStrapiUrl}${cat.image.url}`
              : undefined;

            return (
              <CategoryCard
                name={cat.name}
                slug={cat.slug}
                description={cat.description}
                icon={cat.icon}
                imageUrl={imageUrl}
                productCount={cat.products?.length || 0}
              />
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-grid-3x3-gap mx-auto mb-4 text-text-tertiary" viewBox="0 0 16 16">
            <path d="M4 2v2H2V2zm1 12v-2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m5 10v-2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m5 10v-2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1"/>
          </svg>
          <p class="text-text-tertiary text-lg">
            No hay categorías disponibles todavía.
          </p>
        </div>
      )
    }
  </div>