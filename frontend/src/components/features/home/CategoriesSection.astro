---
import CategoryCard from "../category/CategoryCard.astro"

interface Props {
  categories: any[];
  publicStrapiUrl: string;
  title: string;
  subtitle: string;
  emptyIcon: string;
  emptyMessage: string;
}

const {
  categories,
  publicStrapiUrl,
  title,
  subtitle,
  emptyIcon,
  emptyMessage,
} = Astro.props;
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2>{title}</h2>
      <p class="text-lead text-text-secondary mt-4">
        {subtitle}
      </p>
    </div>

    {
      categories.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {categories.map((cat) => {
            const imageUrl = cat.image?.url
              ? `${publicStrapiUrl}${cat.image.url}`
              : undefined;

            return (
              <CategoryCard
                name={cat.name}
                slug={cat.slug}
                description={cat.description}
                icon={cat.icon}
                imageUrl={imageUrl}
                productCount={cat.products?.length || 0}
              />
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <span set:html={emptyIcon} />
          <p class="text-text-tertiary text-lg">
            {emptyMessage}
          </p>
        </div>
      )
    }
  </div>