---
import CategoryCard from "../category/CategoryCard.astro"

interface Props {
  categories: any[];
  publicStrapiUrl: string;
}

const { categories, publicStrapiUrl } = Astro.props;
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2>Nuestras Categorías</h2>
      <p class="text-lead text-gray-600 mt-4">
        Explora nuestra selección de mieles artesanales, cada una con su
        carácter único
      </p>
    </div>

    {
      categories.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {categories.map((cat) => {
            const imageUrl = cat.image?.url
              ? `${publicStrapiUrl}${cat.image.url}`
              : undefined;

            return (
              <CategoryCard
                name={cat.name}
                slug={cat.slug}
                description={cat.description}
                icon={cat.icon}
                imageUrl={imageUrl}
                productCount={cat.products?.length || 0}
              />
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <span class="text-6xl mb-4 block">🐝</span>
          <p class="text-gray-500 text-lg">
            No hay categorías disponibles todavía.
          </p>
        </div>
      )
    }
  </div>