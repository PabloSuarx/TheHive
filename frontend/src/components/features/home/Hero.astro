---
import { get } from "../../../lib/strapi"
import type { HeroSection, Stat } from "../../../types/home"
import { Image } from 'astro:assets';
import Button from "../../ui/Button.astro"

const heroData = await get("hero-section", {
  populate: "*",
});

const hero: HeroSection = heroData;

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const mainImage = hero.mainImage?.url;
const mainImageUrl = mainImage?.startsWith("http")
  ? mainImage
  : mainImage ? `${PUBLIC_STRAPI_URL}${mainImage}` : "/placeholder.svg";

const button = (hero.button ?? [])[0];
---
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8 text-center lg:text-left">
        <h1 class="text-gradient-honey animate-fade-in-up animation-delay-100">
          {hero.title}
        </h1>

        <p
          class="text-lead text-text-secondary animate-fade-in-up animation-delay-200 max-w-xl mx-auto lg:mx-0"
        >
          {hero.description}
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-in-up animation-delay-300"
        >
          {
            hero?.button && (
              <Button
                link={button.link}
                variant="outline"
                content={button.content}
              />
            )
          }
        </div>

        <div
          class="grid grid-cols-3 gap-8 pt-8 animate-fade-in-up animation-delay-400"
        >
          {
            hero.stat?.map((stat: Stat) => (
              <div class="text-center lg:text-left">
                <div class="text-3xl lg:text-4xl font-bold text-warning">
                  {stat.value}
                </div>
                <div class="text-sm text-text-secondary">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative animate-fade-in-up animation-delay-500">
        <div class="relative z-10">
          <Image
            src={mainImageUrl}
            alt={hero.mainImage?.alternativeText || "/placeholder.svg"}
            width={1000}
            height={1000}
            class="rounded-2xl w-full h-auto"
            loading="eager"
            fit="cover"
          />
        </div>
        <div
          class="absolute -bottom-6 -right-6 w-full h-full bg-linear-to-br from-primary-light to-warning rounded-2xl -z-10 opacity-20"
        >
        </div>
      </div>
    </div>
</div>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }

</style>
