---
import { get } from "../../../lib/strapi"
import type { Feature } from "../../../types/home"

const single = await get("why-choose-us", {
  populate: "*"
});

const features = single.Feature || [];
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2>{single.title}</h2>
      <p class="text-lead text-text-secondary mt-4">
        {single.subtitle}
      </p>
    </div>

    {
      features.length > 0 && (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature: Feature) => (
            <div class="text-center p-8 rounded-2xl hover:border-primary border border-transparent transition-colors">
              <div class="w-16 h-16 text-primary mx-auto mb-6 flex items-center justify-center text-3xl" set:html={feature.icon}>
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-3">
                {feature.title}
              </h3>
              <p class="text-text-secondary">{feature.description}</p>
            </div>
          ))}
        </div>
      )
    }
  </div>
