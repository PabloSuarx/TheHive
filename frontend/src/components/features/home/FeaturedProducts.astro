---
import Button from "../../ui/Button.astro"
import { get } from "../../../lib/strapi"
import type { Product } from "../../../types/product"
import { Image } from "astro:assets";

import StarRating from "../../ui/StarRating.astro"

interface Props {
  buttonsByName: Record<string, any>;
  title: string;
  subtitle: string;
  ecoLabel: string;
  featuredLabel: string;
  buttonText: string;
  emptyMessage: string;
}

const {
  buttonsByName,
  title,
  subtitle,
  ecoLabel,
  featuredLabel,
  buttonText,
  emptyMessage,
} = Astro.props;
const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const products = (await get("products", {
  filters: {
    featured: {
      $eq: true
    }
  },
  populate: {
    mainImage: true,
    reviews: true,
  },
  pagination: {
    limit: 4
  }
})) || [];

const displayProducts = products.length > 0 ? products : [];
---

  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2>{title}</h2>
      <p class="text-lead text-text-secondary mt-4">
        {subtitle}
      </p>
    </div>

    {displayProducts.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          displayProducts.map((product: Product) => {
            const imageUrl = product.mainImage?.url?.startsWith('http')
              ? product.mainImage.url
              : product.mainImage?.url
                ? `${PUBLIC_STRAPI_URL}${product.mainImage.url}`
                : "/placeholder.svg";

            // Calculate rating
            let averageRating = product.rating || 0;
            if (!averageRating && product.reviews && product.reviews.length > 0) {
              averageRating = product.reviews.reduce((acc, review) => acc + (review.rating || 0), 0) / product.reviews.length;
            }
            averageRating = Math.round(averageRating * 2) / 2;

            return (
              <article class="bg-bg-primary rounded-2xl border border-divider hover:border-primary overflow-hidden transition-all group h-full flex flex-col">
                <div class="relative overflow-hidden h-64">
                  <Image
                    src={imageUrl}
                    alt={`${product.name} en frasco`}
                    width={400}
                    height={400}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                  {product.organic && (
                    <span
                      class="absolute top-4 right-4 px-3 py-1 bg-success text-white text-xs font-bold rounded-full"
                    >
                      {ecoLabel}
                    </span>
                  )}
                   {!product.organic && (
                     <span
                      class="absolute top-4 right-4 px-3 py-1 bg-warning text-white text-xs font-bold rounded-full"
                    >
                      {featuredLabel}
                    </span>
                   )}
                </div>
                <div class="p-6 space-y-3 flex flex-col flex-1">
                  <div class="flex flex-col gap-1">
                    <h3 class="text-xl font-bold text-text-primary">{product.name}</h3>
                    <StarRating rating={averageRating} />
                  </div>
                  <p class="text-sm text-text-secondary line-clamp-2 flex-1">{product.shortDescription || product.description}</p>
                  <div class="flex items-center justify-between mt-auto pt-4">
                    <span class="text-2xl font-bold text-warning">
                      {product.price}€
                    </span>
                    <span class="text-sm text-text-tertiary">
                      {product.weightValue}{product.weightUnit}
                    </span>
                  </div>
                  <Button
                    link={`/producto/${product.slug}`}
                    variant="primary"
                    className="w-full mt-4 rounded-xl"
                  >
                    {buttonText}
                  </Button>
                </div>
              </article>
            );
          })
        }
      </div>
    ) : (
       <div class="text-center py-12">
        <p class="text-text-tertiary">{emptyMessage}</p>
      </div>
    )}

    <div class="text-center mt-12">
      {
        buttonsByName["Ver todos los productos"] && (
          <Button
            {...buttonsByName["Ver todos los productos"]}
            className="inline-flex items-center gap-2"
          />
        )
      }
    </div>
  </div>
