---
import BlogCard from "../blog/BlogCard.astro"

interface Props {
  latestBlogs: any[]; 
  publicStrapiUrl: string;
}

const { latestBlogs, publicStrapiUrl } = Astro.props;
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2>Últimas del Blog</h2>
        <p class="text-lead text-text-secondary mt-2">
          Aprende más sobre la miel y sus beneficios
        </p>
      </div>
      <div class="hidden md:block">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-warning font-semibold hover:underline"
        >
          Ver todos
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
          </svg>
        </a>
      </div>
    </div>

    {
      latestBlogs.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {latestBlogs.map((blog) => {
            const imgUrl = blog.featuredImage?.url
              ? `${publicStrapiUrl}${blog.featuredImage.url}`
              : undefined;

            return (
              <BlogCard
                title={blog.title}
                slug={blog.slug}
                excerpt={blog.excerpt}
                imageUrl={imgUrl}
                author={blog.author}
                blogPublishedAt={blog.blogPublishedAt}
                categoryName={blog.blog_category?.name}
                readingTime={blog.readingTime}
              />
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-journal-text mx-auto mb-4 text-text-tertiary" viewBox="0 0 16 16">
            <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
            <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2"/>
            <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z"/>
          </svg>
          <p class="text-text-tertiary text-lg">Pronto publicaremos artículos.</p>
        </div>
      )
    }
  </div>
