---
import BlogCard from "../blog/BlogCard.astro"

interface Props {
  latestBlogs: any[];
  publicStrapiUrl: string;
  title: string;
  subtitle: string;
  linkText: string;
  linkIcon: string;
  emptyIcon: string;
  emptyMessage: string;
}

const {
  latestBlogs,
  publicStrapiUrl,
  title,
  subtitle,
  linkText,
  linkIcon,
  emptyIcon,
  emptyMessage,
} = Astro.props;
---
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2>{title}</h2>
        <p class="text-lead text-text-secondary mt-2">
          {subtitle}
        </p>
      </div>
      <div class="hidden md:block">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-warning font-semibold hover:underline"
        >
          {linkText}
          <span set:html={linkIcon} />
        </a>
      </div>
    </div>

    {
      latestBlogs.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {latestBlogs.map((blog) => {
            const imgUrl = blog.featuredImage?.url?.startsWith("http")
              ? blog.featuredImage.url
              : blog.featuredImage?.url
                ? `${publicStrapiUrl}${blog.featuredImage.url}`
                : undefined;

            return (
              <BlogCard
                title={blog.title}
                slug={blog.slug}
                excerpt={blog.excerpt}
                imageUrl={imgUrl}
                author={blog.author}
                blogPublishedAt={blog.blogPublishedAt}
                categoryName={blog.blog_category?.name}
                readingTime={blog.readingTime}
              />
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <span set:html={emptyIcon} />
          <p class="text-text-tertiary text-lg">{emptyMessage}</p>
        </div>
      )
    }
  </div>
