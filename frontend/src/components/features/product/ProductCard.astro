---
import type { Product } from "../../../types/product"
import { Image } from "astro:assets";
import { get } from "../../../lib/strapi"
import StarRating from "../../ui/StarRating.astro"

interface Props {
  product: Product;
  className?: string;
}

const { product, className = "" } = Astro.props;
const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const formatPrice = (price: number) =>
  price.toLocaleString("es-ES", { minimumFractionDigits: 2 });

const single = await get("product-card").catch(() => null);

const cartIconHtml = single?.icon_add_to_cart ?? `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cart3" viewBox="0 0 16 16"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4M5 13a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/></svg>`;

let averageRating = product.rating || 0;
if (!averageRating && product.reviews && product.reviews.length > 0) {
  averageRating = product.reviews.reduce((acc, review) => acc + (review.rating || 0), 0) / product.reviews.length;
}

averageRating = Math.round(averageRating * 2) / 2;
---

<div
  class={`product-card relative group bg-bg-primary rounded-xl overflow-hidden border border-border-default hover:border-primary transition-all duration-300 h-full flex flex-col ${className}`}
  data-price={product.price}
  data-origin={product.origin}
>
  <div class="relative aspect-4/5 overflow-hidden bg-bg-secondary shrink-0">
    <Image
      src={product.mainImage?.url?.startsWith("http")
        ? product.mainImage.url
        : product.mainImage?.url
          ? `${PUBLIC_STRAPI_URL}${product.mainImage.url}`
          : "/placeholder.svg"}
      alt={product.name}
      width={product.mainImage?.width || 400}
      height={product.mainImage?.height || 500}
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
    />
  </div>
  
  <div class="p-6 flex flex-col flex-1">
    <h3
      class="text-lg font-bold text-text-primary mb-1 group-hover:text-primary transition-colors"
    >
      <a href={`/producto/${product.slug}`} class="before:absolute before:inset-0">{product.name}</a>
    </h3>
    <p class="text-sm text-text-secondary mb-4 line-clamp-1">
      {product.shortDescription}
    </p>

    <div class="flex items-center gap-1 mb-4 mt-auto">
      <StarRating rating={averageRating} reviewsCount={product.reviews?.length || 0} />
    </div>

    <div class="flex items-center justify-between relative z-10 pt-2 border-t border-border-default/50">
      <span class="text-xl font-bold text-text-primary">
        {formatPrice(product.price)}€
      </span>
      <button
        type="button"
        class="add-to-cart-btn size-10 flex items-center justify-center bg-primary text-white hover:bg-primary-dark transition-colors rounded-full cursor-pointer"
        data-product={JSON.stringify(product)}
        aria-label={`Añadir ${product.name} al carrito`}
      >
        <span set:html={cartIconHtml} class="pointer-events-none w-5 h-5 flex items-center justify-center"
        ></span>
      </button>
    </div>
  </div>
</div>

<script>
  import { addToCart } from "../../../utils/cartService";
  import type { Product } from "../../../types/product";

  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest(".add-to-cart-btn") as HTMLButtonElement;

    if (btn) {
      e.preventDefault();
      e.stopPropagation();

      try {
        const productData = btn.dataset.product;
        if (productData) {
          const product: Product = JSON.parse(productData);

          await addToCart({
            productId: product.documentId,
            name: product.name,
            unitPrice: product.price,
            image: product.mainImage?.url ?? "",
            slug: product.slug,
            quantity: 1,
          });

          // Visual feedback
          const originalContent = btn.innerHTML;
          btn.innerHTML = `<span class="text-xs">✔</span>`;
          setTimeout(() => {
            btn.innerHTML = originalContent;
          }, 1500);
        }
      } catch (error) {
        console.error("Error adding to cart:", error);
      }
    }
  });
</script>
