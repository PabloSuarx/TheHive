---
import { Image } from "astro:assets";
import type { Product } from "../../../types/product"

interface Props {
    product: Product;
    breadcrumName?: string;
    breadcrumProducts?: string;
    imageUrl?: string;
}

const {
    product,
    breadcrumName = "Inicio",
    breadcrumProducts = "Productos",
    imageUrl,
} = Astro.props;
---

<!-- Breadcrumb -->
<nav class="bg-bg-secondary py-3">
    <div class="container mx-auto px-4 lg:px-8">
        <ol class="flex items-center gap-2 text-sm text-text-secondary">
            <li>
                <a href="/" class="hover:text-warning transition-colors">
                    {breadcrumName}
                </a>
            </li>
            <li><span class="mx-1">/</span></li>
            <li>
                <a href="/productos" class="hover:text-warning transition-colors">
                    {breadcrumProducts}
                </a>
            </li>
            {
                product.category && (
                    <>
                        <li>
                            <span class="mx-1">/</span>
                        </li>
                        <li>
                            <a
                                href={`/categoria/${product.category.slug}`}
                                class="hover:text-warning transition-colors"
                            >
                                {product.category.name}
                            </a>
                        </li>
                    </>
                )
            }
            <li><span class="mx-1">/</span></li>
            <li class="text-text-primary font-medium">{product.name}</li>
        </ol>
    </div>
</nav>

<!-- Product Hero -->
<section class="py-12 bg-bg-primary">
    <div class="container mx-auto px-4 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
            <!-- Imagen a la izquierda -->
            <div class="space-y-4">
                <div class="relative overflow-hidden rounded-2xl bg-bg-secondary border border-divider">
                    {
                        imageUrl && (
                            <Image
                                src={imageUrl}
                                alt={product.name}
                                class="w-full h-auto object-cover"
                                width={800}
                                height={800}
                                loading="eager"
                            />
                        )
                    }
                    {
                        product.organic && (
                            <span class="absolute top-4 left-4 px-4 py-2 bg-success text-text-inverse text-sm font-bold rounded-full">
                                Ecológico
                            </span>
                        )
                    }
                    {
                        product.featured && (
                            <span class="absolute top-4 right-4 px-4 py-2 bg-warning text-text-inverse text-sm font-bold rounded-full">
                                Destacado
                            </span>
                        )
                    }
                </div>
            </div>

            <!-- Contenido a la derecha -->
            <div class="space-y-6">
                {
                    product.category && (
                        <a
                            href={`/categoria/${product.category.slug}`}
                            class="inline-block text-sm text-warning font-semibold uppercase tracking-wide hover:underline"
                        >
                            {product.category.name}
                        </a>
                    )
                }

                <h1 class="text-4xl lg:text-5xl font-bold text-text-primary leading-tight">
                    {product.name}
                </h1>

                {
                    product.shortDescription && (
                        <p class="text-lg text-text-secondary leading-relaxed">
                            {product.shortDescription}
                        </p>
                    )
                }

                <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-divider">
                    <div class="flex items-center border border-divider rounded-xl bg-bg-secondary max-w-min">
                        <button
                            class="px-4 py-3 text-text-tertiary hover:text-primary transition-colors focus:outline-none"
                            onclick="this.nextElementSibling.stepDown()"
                            aria-label="Disminuir cantidad"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                fill="currentColor"
                                class="bi bi-dash"
                                viewBox="0 0 16 16"
                            >
                                <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                            </svg>
                        </button>
                        <input
                            type="number"
                            id="quantity-input"
                            value="1"
                            min="1"
                            max="99"
                            class="w-12 text-center bg-transparent border-none focus:ring-0 font-medium text-text-primary"
                            readonly
                        />
                        <button
                            class="px-4 py-3 text-text-tertiary hover:text-primary transition-colors focus:outline-none"
                            onclick="this.previousElementSibling.stepUp()"
                            aria-label="Aumentar cantidad"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                fill="currentColor"
                                class="bi bi-plus"
                                viewBox="0 0 16 16"
                            >
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                        </button>
                    </div>

                    <button
                        id="hero-add-to-cart"
                        class="flex-1 bg-primary hover:bg-primary-dark text-text-primary font-bold py-3 px-8 rounded-xl transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
                        data-product={JSON.stringify(product)}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            fill="currentColor"
                            class="bi bi-cart-plus"
                            viewBox="0 0 16 16"
                        >
                            <path d="M9 5.5a.5.5 0 0 0-1 0V7H6.5a.5.5 0 0 0 0 1H8v1.5a.5.5 0 0 0 1 0V8h1.5a.5.5 0 0 0 0-1H9z" />
                            <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                        </svg>
                        Añadir al Carrito
                    </button>
                </div>

                <slot />
            </div>
        </div>
    </div>
</section>

<script>
    import { addToCart } from "../../../utils/cartService";
    import type { Product } from "../../../types/product";

    const addToCartBtn = document.getElementById("hero-add-to-cart");
    const quantityInput = document.getElementById(
        "quantity-input",
    ) as HTMLInputElement;

    if (addToCartBtn) {
        addToCartBtn.addEventListener("click", async () => {
            try {
                const productData = addToCartBtn.dataset.product;
                const quantity = parseInt(quantityInput?.value || "1");

                if (productData) {
                    const product: Product = JSON.parse(productData);

                    await addToCart({
                        productId: product.documentId,
                        name: product.name,
                        unitPrice: product.price,
                        image: product.mainImage?.url ?? "",
                        quantity,
                    });

                    // Feedback
                    const originalText = addToCartBtn.innerHTML;
                    const originalClasses = addToCartBtn.className;

                    addToCartBtn.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                        ¡Añadido!
                    `;

                    // Toggle classes manually to avoid issues
                    addToCartBtn.classList.remove("bg-primary", "hover:bg-primary-dark");
                    addToCartBtn.classList.add("bg-success", "text-text-inverse");

                    setTimeout(() => {
                        addToCartBtn.innerHTML = originalText;
                        addToCartBtn.className = originalClasses;
                    }, 2000);
                }
            } catch (error) {
                console.error("Error adding to cart:", error);
            }
        });
    }
</script>
