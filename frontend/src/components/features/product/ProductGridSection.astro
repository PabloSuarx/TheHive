---
import ProductCard from "./ProductCard.astro"
import type { Product } from "../../../types/product"

const { products } = Astro.props;
const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

---

    <div class="container mx-auto px-4 lg:px-8">
      <div id="no-results" class="text-center py-16 hidden">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
          class="bi bi-inbox mx-auto mb-4 text-text-tertiary"
          viewBox="0 0 16 16">
          <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm-1.17-.437A1.5 1.5 0 0 1 4.98 3h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .106.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374z"/>
        </svg>
        <p class="text-text-secondary text-lg mb-2 font-medium">No se encontraron productos</p>
        <p class="text-text-tertiary text-sm max-w-md mx-auto">
          Prueba con otro término de búsqueda o cambia los filtros para ver más resultados.
        </p>
      </div>

      <div
        class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
        id="products-grid"
      >
        {
          products.map((product: Product) => {
            return (
              <div
                class="product-item transition-opacity duration-300"
                data-category={product.category?.slug || "sin-categoria"}
                data-name={product.name}
                data-price={product.price}
                data-featured={product.featured ? "1" : "0"}
                data-short={product.shortDescription || ""}
                data-organic={product.organic ? "ecologico organico eco" : ""}
              >
                <ProductCard product={product} />
              </div>
            );
          })
        }
      </div>


    </div>