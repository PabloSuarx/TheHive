---
import Breadcrumbs from "../../ui/Breadcrumbs.astro"

const {
  breadcrumbsSeparator,
  breadcrumbsHomeLabel,
  heroTitle,
  heroDescription,
} = Astro.props;
---
    <div class="container mx-auto px-4 lg:px-8">
      <Breadcrumbs separator={breadcrumbsSeparator} homeLabel={breadcrumbsHomeLabel} />
      <h1 class="text-4xl font-bold text-primary mb-2">{heroTitle}</h1>
      <p class="text-lg text-primary-dark max-w-2xl">
        {heroDescription}
      </p>
    </div>