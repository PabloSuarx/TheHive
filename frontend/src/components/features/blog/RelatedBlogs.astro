---
import BlogCard from "./BlogCard.astro";
import type { Blog } from "../../../types/blog"

interface Props {
  relatedBlogs: Blog[];
  strapiUrl: string;
  title?: string;
}

const { relatedBlogs, strapiUrl, title = "Artículos Relacionados" } = Astro.props;
---

{
  relatedBlogs.length > 0 && (
    <section class="py-16 bg-linear-to-b from-bg-primary to-primary-pale">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-2xl font-bold text-text-primary mb-8">
            {title}
          </h2>
          <div class="grid md:grid-cols-3 gap-8">
            {relatedBlogs.map((blog) => (
              <BlogCard
                title={blog.title}
                slug={blog.slug}
                excerpt={blog.excerpt}
                imageUrl={
                  blog.featuredImage?.url
                    ? `${strapiUrl}${blog.featuredImage.url}`
                    : undefined
                }
                author={blog.author}
                blogPublishedAt={blog.blogPublishedAt}
                categoryName={blog.blog_category?.name}
                readingTime={blog.readingTime}
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
