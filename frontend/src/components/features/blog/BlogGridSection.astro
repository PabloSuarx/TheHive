---
import BlogCard from "./BlogCard.astro"

const {blogs} = Astro.props;

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;


---
    <div class="container mx-auto px-4 lg:px-8">
      <div id="blog-no-results" class="text-center py-16 hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="64"
          height="64"
          fill="currentColor"
          class="bi bi-inbox mx-auto mb-4 text-text-tertiary"
          viewBox="0 0 16 16"
        >
          <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a.5.5 0 0 1 .105.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374z" />
        </svg>
        <p class="text-text-secondary text-lg mb-2">No se encontraron artículos</p>
        <p class="text-text-tertiary text-sm">
          Prueba con otro término de búsqueda o cambia los filtros
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
        {
          blogs.map((blog: any) => {
            const imgUrl = blog.featuredImage?.url
              ? `${PUBLIC_STRAPI_URL}${blog.featuredImage.url}`
              : undefined;

            return (
              <div
                class="blog-item"
                data-category={blog.blog_category?.slug || "sin-categoria"}
                data-title={blog.title}
                data-excerpt={blog.excerpt || ""}
                data-author={blog.author || ""}
                data-date={blog.blogPublishedAt || ""}
              >
                <BlogCard
                  title={blog.title}
                  slug={blog.slug}
                  excerpt={blog.excerpt}
                  imageUrl={imgUrl}
                  author={blog.author}
                  blogPublishedAt={blog.blogPublishedAt}
                  categoryName={blog.blog_category?.name}
                  categorySlug={blog.blog_category?.slug}
                  readingTime={blog.readingTime}
                />
              </div>
            );
          })
        }
      </div>

      <nav
        id="blog-pagination"
        class="flex justify-center items-center gap-2 mt-12"
        aria-label="Paginación del blog"
      >
      </nav>
    </div>