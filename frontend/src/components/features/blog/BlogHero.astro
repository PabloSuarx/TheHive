---
import { Image } from "astro:assets";
import type { Blog } from "../../../types/blog"
import Breadcrumbs from "../../ui/Breadcrumbs.astro"

interface Props {
    blog: Blog;
    breadcrumName?: string;
    breadcrumBlog?: string;
    imageUrl?: string;
    calendarIcon?: string;
    readingTimeIcon?: string;
    readingTimeSuffix?: string;
}

const {
    blog,
    breadcrumName = "Inicio",
    imageUrl,
    calendarIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar3 w-4 h-4" viewBox="0 0 16 16">
      <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857z"/>
      <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
    </svg>`,
    readingTimeIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock w-4 h-4" viewBox="0 0 16 16">
      <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
    </svg>`,
    readingTimeSuffix = "min lectura",
} = Astro.props;

const formatDate = (dateStr: string) => {
    if (!dateStr) return "";
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};

const readTime = blog.readingTime;
---

<section class="relative h-[400px] lg:h-[500px] overflow-hidden">
    {
        imageUrl && (
            <Image
                src={imageUrl}
                alt={blog.title}
                class="absolute inset-0 w-full h-full object-cover"
                width={1920}
                height={1080}
                loading="eager"
            />
        )
    }
    <div
        class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-transparent"
    >
    </div>

    <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-end pb-12"
    >
        <div class="max-w-3xl">
            <Breadcrumbs
                class="mb-4 text-white font-medium"
                separator="/"
                homeLabel={breadcrumName}
                currentClass="truncate max-w-[200px]"
            />

            {
                blog.blog_category && (
                    <span class="inline-block px-4 py-1 bg-primary text-text-inverse text-sm font-semibold rounded-full mb-4">
                        {blog.blog_category.name}
                    </span>
                )
            }
            <h1
                class="text-3xl lg:text-5xl font-bold text-white mb-6 leading-tight"
            >
                {blog.title}
            </h1>

            <div
                class="flex flex-wrap items-center gap-4 text-white/80 text-sm"
            >
                {
                    blog.author && (
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-linear-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white font-bold text-xs">
                                {blog.author.charAt(0).toUpperCase()}
                            </div>
                            <span>{blog.author}</span>
                        </div>
                    )
                }
                {
                    blog.blogPublishedAt && (
                        <div class="flex items-center gap-1">
                            <span set:html={calendarIcon} />
                            <span>{formatDate(blog.blogPublishedAt)}</span>
                        </div>
                    )
                }
                <div class="flex items-center gap-1">
                    <span set:html={readingTimeIcon} />
                    <span>{readTime} {readingTimeSuffix}</span>
                </div>
            </div>
        </div>
    </div>
</section>
