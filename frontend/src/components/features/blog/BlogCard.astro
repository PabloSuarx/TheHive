---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  imageUrl?: string;
  author?: string;
  blogPublishedAt?: string;
  categoryName?: string;
  categorySlug?: string;
  className?: string;
  readingTime?: number;
}

const { title, slug, excerpt, imageUrl, author, blogPublishedAt, categoryName, readingTime, className = '' } = Astro.props;

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const placeholder = '/placeholder.svg';
const imgSrc = imageUrl?.startsWith("http")
  ? imageUrl
  : imageUrl
    ? `${PUBLIC_STRAPI_URL}${imageUrl}`
    : placeholder;

const formatDate = (dateStr?: string) => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
};

const wordCount = excerpt ? excerpt.split(/\s+/).length : 0;
const readTime = readingTime || Math.max(1, Math.ceil(wordCount / 100));

---

<article class={`group ${className}`}>
  <a href={`/blog/${slug}`} class="block">
    <div class="relative overflow-hidden rounded-xl mb-4">
      <Image src={imgSrc} alt={title} width={500} height={500} class="w-full h-48 object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
    </div>

    {categoryName && <span class="text-sm text-primary font-semibold">{categoryName}</span>}
    <h3 class="text-xl font-bold text-text-primary mt-2 mb-2 group-hover:text-primary transition-colors line-clamp-2">{title}</h3>
    
    {excerpt && <p class="text-text-secondary text-sm mb-3 line-clamp-3">{excerpt}</p>}
    
    <div class="flex items-center gap-2 text-sm text-text-tertiary">
      {author && (<><span>{author}</span><span>•</span></>)}
      {blogPublishedAt && (<><span>{formatDate(blogPublishedAt)}</span><span>•</span></>)}
      <span>{readTime} min lectura</span>
    </div>
    
  </a>
</article>