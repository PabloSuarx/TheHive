---
import { Image } from "astro:assets";
import type { Category } from "../../../types/category"

interface Props {
    category: Category;
    breadcrumName?: string;
    breadcrumCategory?: string;
    imageUrl?: string;
    chevronIcon?: string;
}

const {
    category,
    breadcrumName = "Inicio",
    breadcrumCategory = "Categoría",
    imageUrl,
    chevronIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right mx-2 text-text-tertiary" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>`,
} = Astro.props;
---

<section
    class="relative h-[350px] w-full flex items-center overflow-hidden bg-secondary"
>
    {
        imageUrl && (
            <Image
                src={imageUrl}
                alt={category.name}
                class="absolute inset-0 w-full h-full object-cover"
                width={1920}
                height={1080}
            />
        )
    }

    <div
        class="absolute inset-0 bg-linear-to-r from-secondary via-secondary-light/70 to-transparent"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-2xl">
            <nav class="flex items-center mb-4 text-sm font-medium text-primary">
                <a class="hover:text-primary-light transition-colors" href="/">{breadcrumName}</a>
                <span set:html={chevronIcon} />

                <a class="hover:text-primary-light transition-colors" href="/categorias"
                    >{breadcrumCategory}
                </a>
                <span set:html={chevronIcon} />
                <span class="text-text-inverse">{category.name}</span>
            </nav>

            <h1 class="text-5xl font-bold text-text-inverse mb-4 tracking-tight">
                {category.name}
            </h1>
            <p class="text-lg text-text-inverse/90 leading-relaxed">
                {category.description}
            </p>
        </div>
    </div>
</section>
