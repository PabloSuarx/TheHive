---
import { Image } from "astro:assets";
import type { Category } from "../../../types/category"

interface Props {
    category: Category;
    breadcrumName?: string;
    breadcrumCategory?: string;
    imageUrl?: string;
}

const {
    category,
    breadcrumName = "Inicio",
    breadcrumCategory = "Categoría",
    imageUrl,
} = Astro.props;
---

<section
    class="relative h-[350px] w-full flex items-center overflow-hidden bg-gray-900"
>
    {
        imageUrl && (
            <Image
                src={imageUrl}
                alt={category.name}
                class="absolute inset-0 w-full h-full object-cover"
                width={1920}
                height={1080}
            />
        )
    }

    <div
        class="absolute inset-0 bg-linear-to-r from-(--secondary) via-(--secondary-light)/70 to-transparent"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-2xl">
            <nav class="flex mb-4 text-sm font-medium text-primary/80">
                <a class="hover:text-primary" href="/">{breadcrumName}</a>
                <span class="mx-2 text-slate-500">/</span>

                <a class="hover:text-primary" href="/categorias"
                    >{breadcrumCategory}
                </a>
                <span class="mx-2 text-slate-500">/</span>
                <span class="text-white">{category.name}</span>
            </nav>

            <h1 class="text-5xl font-bold text-white mb-4 tracking-tight">
                {category.name}
            </h1>
            <p class="text-lg text-slate-200 leading-relaxed">
                {category.description}
            </p>
        </div>
    </div>
</section>
