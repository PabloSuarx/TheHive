---
import type { Category } from "../../../types/category"

interface Props {
    mainHeading?: string;
    otherCategories: Category[];
    originHeading?: string;
    uniqueOrigins: string[];
}

const {
    mainHeading = "Categorías",
    otherCategories,
    originHeading = "Origen",
    uniqueOrigins,
} = Astro.props;
---

<aside class="w-full lg:w-64 space-y-10 shrink-0">
    <div>
        <h3 class="text-sm font-bold tracking-wider text-primary mb-4">
            {mainHeading}
        </h3>

        <ul class="space-y-3">
            {
                otherCategories.map((category) => (
                    <li>
                        <a
                            class="flex items-center gap-3 text-text-secondary hover:text-primary transition-colors group"
                            href={`/categoria/${category.slug}`}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="bi bi-folder shrink-0"
                                viewBox="0 0 16 16"
                            >
                                <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a2 2 0 0 1 .342-1.31zM2.19 4a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91h10.348a1 1 0 0 0 .995-.91l.637-7A1 1 0 0 0 13.81 4zm4.69-1.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139q.323-.119.684-.12h5.396z" />
                            </svg>
                            <span class="text-sm font-medium">
                                {category.name}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>

    <div>
        <h3
            class="text-sm font-bold uppercase tracking-wider text-primary mb-4"
        >
            {originHeading}
        </h3>
        <div class="space-y-3">
            {
                uniqueOrigins.map((origin) => (
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input
                            type="checkbox"
                            value={origin}
                            class="origin-filter rounded border-divider bg-bg-secondary text-primary focus:ring-primary"
                            checked
                        />
                        <span class="text-sm text-text-secondary group-hover:text-primary transition-colors">
                            {origin}
                        </span>
                    </label>
                ))
            }
        </div>
    </div>
</aside>
