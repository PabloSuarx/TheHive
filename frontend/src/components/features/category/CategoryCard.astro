---
import { Image } from 'astro:assets';
interface Props {
  name: string;
  slug: string;
  description?: string;
  icon?: string;
  imageUrl?: string;
  productCount?: number;
  className?: string;
}

const { 
  name, 
  slug, 
  description, 
  icon, 
  imageUrl, 
  productCount = 0,
  className = '' 
} = Astro.props;

const imgSrc = imageUrl || "/placeholder.svg";
---

<a 
  href={`/categoria/${slug}`} 
  class={`group relative overflow-hidden rounded-2xl border border-divider hover:border-primary transition-all transform hover:scale-105 block ${className}`}
>
  <Image 
    src={imgSrc} 
    alt={name}
    width={600}
    height={400}
    class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 p-6">
    <div class="flex items-center gap-2 mb-2">
      {icon && <span class="text-3xl" set:html={icon} />}
      <h3 class="text-white text-2xl font-bold">{name}</h3>
    </div>
    {description && (
      <p class="text-text-inverse/80 text-sm line-clamp-2">{description}</p>
    )}
    {productCount > 0 && (
      <span class="inline-block mt-2 text-xs text-white/80 bg-white/20 px-3 py-1 rounded-full">
        {productCount} {productCount === 1 ? 'producto' : 'productos'}
      </span>
    )}
  </div>
</a>