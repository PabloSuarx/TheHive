---
---

<div class="space-y-8">
  
  <div>
    <h2 class="text-2xl font-bold text-text-primary mb-6">Información de Contacto</h2>
    <p class="text-text-secondary mb-8">
      Completa el formulario y te responderemos en menos de 24 horas.
    </p>
  </div>

  <!-- Dirección -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse shadow-md">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">Dirección</h3>
      <p class="text-text-secondary text-sm">
        Calle Colmena, 42<br>
        29001 Málaga, España
      </p>
    </div>
  </div>

  <!-- Teléfono -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse shadow-md">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">Teléfono</h3>
      <a href="tel:+34952123456" class="text-primary hover:text-primary-dark text-sm transition-colors">
        +34 952 12 34 56
      </a>
    </div>
  </div>

  <!-- Email -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse shadow-md">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">Email</h3>
      <a href="mailto:hola@thehive.es" class="text-primary hover:text-primary-dark text-sm transition-colors">
        hola@thehive.es
      </a>
    </div>
  </div>

  <!-- Horario -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse shadow-md">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">Horario</h3>
      <p class="text-text-secondary text-sm">
        Lunes a Viernes: 9:00 - 18:00<br>
        Sábados: 10:00 - 14:00
      </p>
    </div>
  </div>


</div>
