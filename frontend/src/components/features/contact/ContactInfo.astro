---
interface Props {
  contactInfoTitle: string;
  contactInfoDescription: string;
  addressTitle: string;
  addressLine1: string;
  addressLine2: string;
  addressIcon: string;
  phoneTitle: string;
  phoneNumber: string;
  phoneHref: string;
  phoneIcon: string;
  emailTitle: string;
  emailAddress: string;
  emailHref: string;
  emailIcon: string;
  scheduleTitle: string;
  scheduleLine1: string;
  scheduleLine2: string;
  scheduleIcon: string;
}

// Desestructuración al 100%
const {
  contactInfoTitle,
  contactInfoDescription,
  addressTitle,
  addressLine1,
  addressLine2,
  addressIcon,
  phoneTitle,
  phoneNumber,
  phoneHref,
  phoneIcon,
  emailTitle,
  emailAddress,
  emailHref,
  emailIcon,
  scheduleTitle,
  scheduleLine1,
  scheduleLine2,
  scheduleIcon,
} = Astro.props;
---

<div class="space-y-8">

  <div>
    <h2 class="text-2xl font-bold text-text-primary mb-6">{contactInfoTitle}</h2>
    <p class="text-text-secondary mb-8">
      {contactInfoDescription}
    </p>
  </div>

  <!-- Dirección -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse">
        <span set:html={addressIcon} />
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">{addressTitle}</h3>
      <p class="text-text-secondary text-sm">
        {addressLine1}<br>
        {addressLine2}
      </p>
    </div>
  </div>

  <!-- Teléfono -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse">
        <span set:html={phoneIcon} />
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">{phoneTitle}</h3>
      <a href={phoneHref} class="text-primary hover:text-primary-dark text-sm transition-colors">
        {phoneNumber}
      </a>
    </div>
  </div>

  <!-- Email -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse">
        <span set:html={emailIcon} />
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">{emailTitle}</h3>
      <a href={emailHref} class="text-primary hover:text-primary-dark text-sm transition-colors">
        {emailAddress}
      </a>
    </div>
  </div>

  <!-- Horario -->
  <div class="flex gap-4">
    <div class="shrink-0">
      <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-text-inverse">
        <span set:html={scheduleIcon} />
      </div>
    </div>
    <div>
      <h3 class="font-semibold text-text-primary mb-1">{scheduleTitle}</h3>
      <p class="text-text-secondary text-sm">
        {scheduleLine1}<br>
        {scheduleLine2}
      </p>
    </div>
  </div>


</div>
