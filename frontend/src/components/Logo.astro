---
import { Image } from 'astro:assets';

interface Props {logoUrl: string; logoAlt: string; className?: string;}

const { logoUrl, logoAlt, className = '' } = Astro.props;
---

<div class={`flex items-center justify-center w-full h-full ${className}`}>
  <Image 
    src={logoUrl} 
    alt={logoAlt} 
    loading="eager"
    inferSize
    class="w-full h-full object-contain"
  />
</div>