---
import Button from "../Button.astro";

interface Props {
  buttonsByName: Record<string, any>;
}

const { buttonsByName } = Astro.props;
---

<section
  class="py-20 bg-linear-to-br from-primary-dark to-warning text-text-inverse relative overflow-hidden"
>
  <div class="absolute inset-0 opacity-10">
    <div class="hexagon-white hex-cta-1"></div>
    <div class="hexagon-white hex-cta-2"></div>
    <div class="hexagon-white hex-cta-3"></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 text-center relative z-10">
    <div class="max-w-3xl mx-auto space-y-8">
      <h2 class="text-text-inverse section-title">¿Listo para Probar la Mejor Miel?</h2>
      <p class="text-xl text-white/90">
        Únete a miles de clientes satisfechos y descubre el auténtico sabor de
        la miel artesanal
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        {
          buttonsByName["Ver todos los productos"] && (
            <Button
              {...buttonsByName["Ver todos los productos"]}
              className="bg-bg-primary text-warning hover:bg-bg-secondary"
            />
          )
        }
        {
          buttonsByName["Contáctanos"] && (
            <Button
              {...buttonsByName["Contáctanos"]}
              variant="outline"
              className="border-text-inverse text-text-inverse hover:bg-bg-primary hover:text-warning"
            />
          )
        }
      </div>

      <div
        class="flex flex-wrap justify-center items-center gap-8 pt-8 text-white/80"
      >
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium">Envío Gratis +50€</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium">Garantía de Calidad</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium">100% Natural</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
      opacity: 0.3;
    }
    50% {
      transform: translateY(-30px) rotate(180deg);
      opacity: 0.1;
    }
  }

  .hexagon-white {
    position: absolute;
    width: 120px;
    height: 69.28px;
    background-color: rgba(255, 255, 255, 0.1);
    margin: 34.64px 0;
  }

  .hexagon-white:before,
  .hexagon-white:after {
    content: "";
    position: absolute;
    width: 0;
    border-left: 60px solid transparent;
    border-right: 60px solid transparent;
  }

  .hexagon-white:before {
    bottom: 100%;
    border-bottom: 34.64px solid rgba(255, 255, 255, 0.1);
  }

  .hexagon-white:after {
    top: 100%;
    border-top: 34.64px solid rgba(255, 255, 255, 0.1);
  }

  .hex-cta-1 {
    top: 20%;
    left: 10%;
    animation: float 20s infinite ease-in-out;
  }
  .hex-cta-2 {
    top: 60%;
    right: 15%;
    animation: float 25s infinite ease-in-out 3s;
  }
  .hex-cta-3 {
    bottom: 20%;
    left: 70%;
    animation: float 25s infinite ease-in-out 6s;
  }
</style>
