---
import { get } from "../../lib/strapi";
import type { Testimonial } from "../../types/home";

// Fetch data from Strapi
const single = await get("testimonials-section", {
  populate: {
    testimonials: true,
  },
});

// Fallback data
const fallbackData = {
  title: "Lo Que Dicen Nuestros Clientes",
  subtitle: "Miles de personas ya disfrutan de nuestra miel",
  testimonials: [
    {
      text: "La mejor miel que he probado nunca. El sabor a azahar es increíble y se nota que es 100% natural. ¡Repito cada mes!",
      author: "María Carmen",
      location: "Málaga",
      rating: 5,
    },
    {
      text: "Excelente calidad y envío rapidísimo. Funciona de maravilla y además está deliciosa. ¡Totalmente recomendable!",
      author: "Javier Pérez",
      location: "Madrid",
      rating: 5,
    },
    {
      text: "Desde que descubrí The Hive no compro otra miel. La de romero es espectacular para el desayuno.",
      author: "Ana Rodríguez",
      location: "Sevilla",
      rating: 5,
    },
  ] as Testimonial[],
};

const data = single || fallbackData;
const testimonials = data.testimonials || [];
---

<section class="py-20 bg-linear-to-b from-bg-primary to-primary-pale">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2>{data.title}</h2>
      <p class="text-lead text-gray-600 mt-4">
        {data.subtitle}
      </p>
    </div>

    {
      testimonials.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-8">
          {testimonials.map((testimonial: Testimonial) => (
            <article class="bg-bg-primary p-8 rounded-2xl border border-divider">
              <div class="flex items-center gap-1 mb-4">
                {[...Array(testimonial.rating)].map(() => (
                  <svg
                    class="w-5 h-5 text-warning"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-gray-700 mb-6 italic">"{testimonial.text}"</p>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-linear-to-br from-primary to-warning rounded-full flex items-center justify-center text-text-inverse font-bold">
                  {testimonial.author
                    .split(" ")
                    .map((n) => n[0])
                    .join("")}
                </div>
                <div>
                  <div class="font-semibold text-text-primary">
                    {testimonial.author}
                  </div>
                  <div class="text-sm text-gray-500">{testimonial.location}</div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-500">No hay testimonios disponibles en este momento.</p>
        </div>
      )
    }
  </div>
</section>
