---
// components/Header.astro
---

<header class="bg-white shadow-md sticky top-0 z-50 border-b border-gray-100">
  <nav class="container mx-auto px-4 lg:px-8 py-4" aria-label="Navegación principal">
    <div class="flex items-center justify-between">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="The Hive - Inicio">
        <div class="w-12 h-12 bbg-linear-to-br from-[#F59E0B] to-[#D97706] rounded-xl flex items-center justify-center shadow-md group-hover:shadow-lg transition-shadow">
          <span class="text-2xl" role="img" aria-label="Abeja">🐝</span>
        </div>
        <div class="hidden sm:block">
          <span class="text-xl font-bold text-gray-900 group-hover:text-[#F59E0B] transition-colors">The Hive</span>
          <p class="text-xs text-gray-500">Miel Artesanal</p>
        </div>
      </a>

      <!-- Navigation Links - Desktop -->
      <ul class="hidden lg:flex items-center gap-8">
        <li>
          <a 
            href="/" 
            class="text-gray-700 hover:text-[#F59E0B] transition-colors font-medium relative group"
          >
            Inicio
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#F59E0B] transition-all group-hover:w-full"></span>
          </a>
        </li>
        <li>
          <a 
            href="/productos" 
            class="text-gray-700 hover:text-[#F59E0B] transition-colors font-medium relative group"
          >
            Productos
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#F59E0B] transition-all group-hover:w-full"></span>
          </a>
        </li>
        <li>
          <a 
            href="/categorias" 
            class="text-gray-700 hover:text-[#F59E0B] transition-colors font-medium relative group"
          >
            Categorías
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#F59E0B] transition-all group-hover:w-full"></span>
          </a>
        </li>
        <li>
          <a 
            href="/blog" 
            class="text-gray-700 hover:text-[#F59E0B] transition-colors font-medium relative group"
          >
            Blog
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#F59E0B] transition-all group-hover:w-full"></span>
          </a>
        </li>
        <li>
          <a 
            href="/contacto" 
            class="text-gray-700 hover:text-[#F59E0B] transition-colors font-medium relative group"
          >
            Contacto
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#F59E0B] transition-all group-hover:w-full"></span>
          </a>
        </li>
      </ul>

      <!-- Carrito y Mobile Menu Button -->
      <div class="flex items-center gap-4">
        <!-- Carrito -->
        <a 
          href="/carrito" 
          class="relative p-2 text-gray-700 hover:text-[#F59E0B] transition-colors rounded-lg hover:bg-[#FEF3C7]"
          aria-label="Carrito de compra"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <!-- Badge del carrito (número de items) -->
          <span class="absolute -top-1 -right-1 bg-[#F59E0B] text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
            0
          </span>
        </a>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-button"
          class="lg:hidden text-gray-700 hover:text-[#F59E0B] focus:outline-none focus:ring-2 focus:ring-[#F59E0B] rounded-lg p-2 transition-colors"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div 
      id="mobile-menu"
      class="hidden lg:hidden mt-4 pb-4 border-t border-gray-200 pt-4"
    >
      <ul class="flex flex-col gap-2">
        <li>
          <a 
            href="/" 
            class="block text-gray-700 hover:text-[#F59E0B] hover:bg-[#FEF3C7] transition-colors font-medium py-3 px-4 rounded-lg"
          >
            Inicio
          </a>
        </li>
        <li>
          <a 
            href="/productos" 
            class="block text-gray-700 hover:text-[#F59E0B] hover:bg-[#FEF3C7] transition-colors font-medium py-3 px-4 rounded-lg"
          >
            Productos
          </a>
        </li>
        <li>
          <a 
            href="/categorias" 
            class="block text-gray-700 hover:text-[#F59E0B] hover:bg-[#FEF3C7] transition-colors font-medium py-3 px-4 rounded-lg"
          >
            Categorías
          </a>
        </li>
        <li>
          <a 
            href="/blog" 
            class="block text-gray-700 hover:text-[#F59E0B] hover:bg-[#FEF3C7] transition-colors font-medium py-3 px-4 rounded-lg"
          >
            Blog
          </a>
        </li>
        <li>
          <a 
            href="/contacto" 
            class="block text-gray-700 hover:text-[#F59E0B] hover:bg-[#FEF3C7] transition-colors font-medium py-3 px-4 rounded-lg"
          >
            Contacto
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuButton && mobileMenu && menuIcon && closeIcon) {
    mobileMenuButton.addEventListener('click', function() {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      
      // Toggle aria-expanded
      mobileMenuButton.setAttribute('aria-expanded', String(!isExpanded));
      
      // Toggle menu visibility
      mobileMenu.classList.toggle('hidden');
      
      // Toggle icons
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close mobile menu when clicking on a link
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>