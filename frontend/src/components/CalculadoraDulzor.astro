---
---
<!-- Calculadora -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-10">

        <!-- Panel izquierdo: Inputs -->
        <div class="bg-gradient-to-br from-[#FEF3C7] to-white p-8 rounded-3xl shadow-xl">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Tu Receta</h2>
          
          <div class="space-y-6">

            <!-- Tipo de miel -->
            <div>
              <label for="honey-type" class="block text-sm font-semibold text-gray-900 mb-2">
                Tipo de miel
              </label>
              <select 
                id="honey-type"
                class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-[#F59E0B] focus:outline-none focus:ring-2 focus:ring-[#F59E0B]/20 transition-colors"
              >
                <option value="">Selecciona un tipo de miel</option>
              </select>
              <p id="honey-description" class="text-sm text-gray-500 mt-2 min-h-[20px]"></p>
            </div>

            <!-- Cantidad de azúcar -->
            <div>
              <label for="sugar-amount" class="block text-sm font-semibold text-gray-900 mb-2">
                Cantidad de azúcar en la receta
              </label>
              <div class="flex gap-3">
                <div class="relative flex-1">
                  <input 
                    type="text" 
                    id="sugar-amount" 
                    placeholder="Ej: 200"
                    class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-[#F59E0B] focus:outline-none focus:ring-2 focus:ring-[#F59E0B]/20 transition-colors"
                    autocomplete="off"
                  />
                </div>
                <select 
                  id="sugar-unit"
                  class="px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-[#F59E0B] focus:outline-none focus:ring-2 focus:ring-[#F59E0B]/20 transition-colors"
                >
                  <option value="g">gramos</option>
                  <option value="cups">tazas</option>
                  <option value="tbsp">cucharadas</option>
                  <option value="tsp">cucharaditas</option>
                </select>
              </div>
              <p id="sugar-error" class="text-red-500 text-sm mt-2 hidden"></p>
            </div>

            <!-- Tiene horno? -->
            <div class="flex items-center gap-3">
              <input 
                type="checkbox" 
                id="uses-oven" 
                class="w-5 h-5 accent-[#F59E0B] rounded"
              />
              <label for="uses-oven" class="text-sm font-medium text-gray-700">
                La receta lleva horneado
              </label>
            </div>

            <!-- Temperatura del horno -->
            <div id="oven-temp-group" class="hidden">
              <label for="oven-temp" class="block text-sm font-semibold text-gray-900 mb-2">
                Temperatura del horno (°C)
              </label>
              <input 
                type="text" 
                id="oven-temp" 
                placeholder="Ej: 180"
                class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-[#F59E0B] focus:outline-none focus:ring-2 focus:ring-[#F59E0B]/20 transition-colors"
                autocomplete="off"
              />
              <p id="temp-error" class="text-red-500 text-sm mt-2 hidden"></p>
            </div>

            <!-- Botón calcular -->
            <button 
              id="calculate-btn"
              class="w-full py-4 bg-[#F59E0B] hover:bg-[#D97706] text-white font-bold text-lg rounded-xl shadow-lg hover:shadow-xl transition-all active:scale-[0.98] disabled:bg-gray-300 disabled:cursor-not-allowed"
            >
              🍯 Calcular Equivalencia
            </button>

            <!-- Botón reset -->
            <button 
              id="reset-btn"
              class="w-full py-3 bg-white text-gray-600 font-medium rounded-xl border-2 border-gray-200 hover:border-gray-300 transition-colors hidden"
            >
              Limpiar y empezar de nuevo
            </button>
          </div>
        </div>

        <!-- Panel derecho: Resultados -->
        <div>
          <!-- Estado inicial -->
          <div id="result-placeholder" class="h-full flex items-center justify-center">
            <div class="text-center space-y-4 py-16">
              <span class="text-7xl block">🍯</span>
              <p class="text-gray-400 text-lg">Introduce los datos de tu receta y pulsa calcular</p>
            </div>
          </div>

          <!-- Loading -->
          <div id="result-loading" class="h-full flex items-center justify-center hidden">
            <div class="text-center space-y-4">
              <div class="w-16 h-16 mx-auto border-4 border-[#FEF3C7] border-t-[#F59E0B] rounded-full animate-spin"></div>
              <p class="text-gray-500">Calculando...</p>
            </div>
          </div>

          <!-- Resultados -->
          <div id="result-panel" class="space-y-6 hidden">
            
            <!-- Resultado principal -->
            <div class="bg-gradient-to-br from-[#F59E0B] to-[#D97706] p-8 rounded-3xl text-white shadow-xl">
              <p class="text-sm text-white/80 mb-1">Necesitas</p>
              <div class="flex items-baseline gap-2">
                <span id="result-amount" class="text-5xl font-bold"></span>
                <span id="result-unit" class="text-xl text-white/90"></span>
              </div>
              <p class="text-white/80 mt-2">
                de <span id="result-honey-name" class="font-semibold text-white"></span>
              </p>
            </div>

            <!-- Ajustes -->
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-blue-50 p-5 rounded-2xl">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-2xl">💧</span>
                  <span class="text-sm font-semibold text-blue-900">Reducir líquidos</span>
                </div>
                <p id="result-liquid" class="text-2xl font-bold text-blue-700"></p>
                <p class="text-xs text-blue-600 mt-1">menos de los líquidos de la receta</p>
              </div>

              <div id="result-temp-card" class="bg-red-50 p-5 rounded-2xl hidden">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-2xl">🌡️</span>
                  <span class="text-sm font-semibold text-red-900">Nueva temperatura</span>
                </div>
                <p id="result-temp" class="text-2xl font-bold text-red-700"></p>
                <p class="text-xs text-red-600 mt-1">la miel se carameliza antes que el azúcar</p>
              </div>

              <div class="bg-green-50 p-5 rounded-2xl">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-2xl">🔥</span>
                  <span class="text-sm font-semibold text-green-900">Calorías ahorradas</span>
                </div>
                <p id="result-calories" class="text-2xl font-bold text-green-700"></p>
                <p class="text-xs text-green-600 mt-1">menos que con azúcar refinado</p>
              </div>

              <div class="bg-amber-50 p-5 rounded-2xl">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-2xl">📊</span>
                  <span class="text-sm font-semibold text-amber-900">Índice de dulzor</span>
                </div>
                <p id="result-sweetness" class="text-2xl font-bold text-amber-700"></p>
                <p class="text-xs text-amber-600 mt-1">respecto al azúcar blanco</p>
              </div>
            </div>

            <!-- Tips -->
            <div class="bg-gray-50 p-6 rounded-2xl">
              <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
                <span>💡</span> Consejos para tu receta
              </h3>
              <ul id="result-tips" class="space-y-2 text-sm text-gray-700"></ul>
            </div>

          </div>
        </div>

      </div>

      <!-- Tabla informativa (Acordeón) -->
      <details class="mt-16 group">
        <summary class="flex items-center justify-between cursor-pointer list-none bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition-all select-none">
          <h2 class="text-2xl font-bold text-gray-900">Tabla de Equivalencias por Tipo de Miel</h2>
          <span class="transform group-open:rotate-180 transition-transform duration-300 text-[#F59E0B]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        
        <div class="mt-6 overflow-x-auto animate-fade-in-up">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-[#FEF3C7]">
                <th class="px-4 py-3 text-left font-semibold text-gray-900 rounded-tl-xl">Tipo de miel</th>
                <th class="px-4 py-3 text-center font-semibold text-gray-900">Dulzor vs azúcar</th>
                <th class="px-4 py-3 text-center font-semibold text-gray-900">Miel por 100g azúcar</th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900">Notas de sabor</th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 rounded-tr-xl">Ideal para</th>
              </tr>
            </thead>
            <tbody id="info-table"></tbody>
          </table>
        </div>
      </details>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {

    // ===== DATOS DE MIELES =====
    const honeyTypes = [
      {
        id: 'acacia',
        name: 'Miel de Acacia',
        sweetness: 1.30,
        flavor: 'Suave, vainilla',
        description: 'Muy dulce y suave, ideal para sustituir azúcar sin alterar el sabor.',
        bestFor: 'Bebidas, postres suaves, yogur',
        tips: [
          'Por su sabor neutro, es la mejor opción para recetas donde no quieras notar la miel.',
          'Se mantiene líquida más tiempo que otras mieles.',
        ]
      },
      {
        id: 'azahar',
        name: 'Miel de Azahar',
        sweetness: 1.25,
        flavor: 'Floral, cítrico',
        description: 'Dulce y aromática con notas florales. Perfecta para repostería.',
        bestFor: 'Bizcochos, galletas, infusiones',
        tips: [
          'Aporta un aroma floral muy agradable a bizcochos y magdalenas.',
          'Combina especialmente bien con limón y naranja.',
        ]
      },
      {
        id: 'romero',
        name: 'Miel de Romero',
        sweetness: 1.20,
        flavor: 'Herbal, intenso',
        description: 'Sabor pronunciado con carácter herbal. Muy versátil en cocina.',
        bestFor: 'Marinados, salsas, quesos',
        tips: [
          'Su sabor intenso funciona mejor en recetas saladas o donde quieras notar la miel.',
          'Excelente para glasear carnes al horno.',
        ]
      },
      {
        id: 'eucalipto',
        name: 'Miel de Eucalipto',
        sweetness: 1.15,
        flavor: 'Balsámico, mentolado',
        description: 'Menos dulce, con notas balsámicas refrescantes.',
        bestFor: 'Infusiones, aliños, remedios caseros',
        tips: [
          'Ideal para endulzar tés e infusiones medicinales.',
          'Su punto balsámico no combina bien con chocolate o vainilla.',
        ]
      },
      {
        id: 'bosque',
        name: 'Miel de Bosque',
        sweetness: 1.10,
        flavor: 'Terroso, malta, roble',
        description: 'Oscura y robusta, la menos dulce pero la más rica en minerales.',
        bestFor: 'Pan, quesos curados, cerveza artesanal',
        tips: [
          'Necesitarás un poco más de cantidad por su menor dulzor.',
          'Su color oscuro teñirá las masas, ten en cuenta la presentación.',
          'Combina espectacularmente con quesos fuertes y nueces.',
        ]
      },
      {
        id: 'lavanda',
        name: 'Miel de Lavanda',
        sweetness: 1.25,
        flavor: 'Floral, perfumado',
        description: 'Aromática y delicada. Muy apreciada en pastelería francesa.',
        bestFor: 'Cremas, helados, macarons',
        tips: [
          'Usarla en cremas y helados resalta su aroma sin necesidad de esencia.',
          'Muy valorada en pastelería fina, ideal para impresionar.',
        ]
      },
      {
        id: 'manuka',
        name: 'Miel de Manuka',
        sweetness: 1.15,
        flavor: 'Terroso, herbal, intenso',
        description: 'Premium con propiedades únicas. Sabor potente y distintivo.',
        bestFor: 'Consumo directo, smoothies, tostadas',
        tips: [
          'Por su precio elevado, no se recomienda para hornear.',
          'Mejor consumirla directa o en preparaciones sin calor para conservar sus propiedades.',
        ]
      },
      {
        id: 'multiflora',
        name: 'Miel Multiflora',
        sweetness: 1.20,
        flavor: 'Equilibrado, floral suave',
        description: 'La más polivalente. Buen equilibrio entre dulzor y sabor.',
        bestFor: 'Todo tipo de recetas, uso diario',
        tips: [
          'La opción más segura si no estás seguro de qué miel usar.',
          'Buen punto medio entre dulzor y sabor para cualquier receta.',
        ]
      },
    ];

    // Conversiones a gramos
    const UNIT_TO_GRAMS: Record<string, number> = {
      'g': 1,
      'cups': 200,    // 1 taza de azúcar ≈ 200g
      'tbsp': 12.5,   // 1 cucharada de azúcar ≈ 12.5g
      'tsp': 4.2,     // 1 cucharadita de azúcar ≈ 4.2g
    };

    const UNIT_LABELS: Record<string, string> = {
      'g': 'gramos',
      'cups': 'tazas',
      'tbsp': 'cucharadas',
      'tsp': 'cucharaditas',
    };

    // Calorías por gramo
    const SUGAR_CAL_PER_G = 4;    // 4 kcal/g
    const HONEY_CAL_PER_G = 3.04; // 3.04 kcal/g

    // ===== ELEMENTOS =====
    const honeySelect = document.getElementById('honey-type') as HTMLSelectElement;
    const honeyDesc = document.getElementById('honey-description') as HTMLElement;
    const sugarInput = document.getElementById('sugar-amount') as HTMLInputElement;
    const sugarUnit = document.getElementById('sugar-unit') as HTMLSelectElement;
    const sugarError = document.getElementById('sugar-error') as HTMLElement;
    const usesOven = document.getElementById('uses-oven') as HTMLInputElement;
    const ovenGroup = document.getElementById('oven-temp-group') as HTMLElement;
    const ovenInput = document.getElementById('oven-temp') as HTMLInputElement;
    const tempError = document.getElementById('temp-error') as HTMLElement;
    const calcBtn = document.getElementById('calculate-btn') as HTMLButtonElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLElement;
    const placeholder = document.getElementById('result-placeholder') as HTMLElement;
    const loadingEl = document.getElementById('result-loading') as HTMLElement;
    const resultPanel = document.getElementById('result-panel') as HTMLElement;
    const infoTableBody = document.getElementById('info-table') as HTMLElement;

    // ===== POBLAR SELECT (desestructuración + map) =====
    honeyTypes
      .sort((a, b) => a.name.localeCompare(b.name, 'es'))
      .forEach(({ id, name, sweetness }) => {
        const option = document.createElement('option');
        option.value = id;
        option.textContent = `${name} (dulzor: ${(sweetness * 100).toFixed(0)}%)`;
        honeySelect.appendChild(option);
      });

    // ===== POBLAR TABLA (map + desestructuración) =====
    honeyTypes
      .sort((a, b) => b.sweetness - a.sweetness)
      .forEach(({ name, sweetness, flavor, bestFor }) => {
        const gramsNeeded = (100 / sweetness).toFixed(0);
        const row = document.createElement('tr');
        row.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors';
        row.innerHTML = `
          <td class="px-4 py-3 font-medium text-gray-900">${name}</td>
          <td class="px-4 py-3 text-center">
            <span class="inline-block px-2 py-1 rounded-full text-xs font-bold ${
              sweetness >= 1.25 ? 'bg-amber-100 text-amber-800' 
              : sweetness >= 1.15 ? 'bg-yellow-100 text-yellow-800' 
              : 'bg-gray-100 text-gray-800'
            }">×${sweetness.toFixed(2)}</span>
          </td>
          <td class="px-4 py-3 text-center font-semibold text-[#D97706]">${gramsNeeded}g</td>
          <td class="px-4 py-3 text-gray-600">${flavor}</td>
          <td class="px-4 py-3 text-gray-600">${bestFor}</td>
        `;
        infoTableBody.appendChild(row);
      });

    // ===== REGEX PARA VALIDACIÓN =====
    const regexNumero = /^\d+([.,]\d{1,2})?$/;
    const regexTemperatura = /^[1-3]\d{2}$/;  // 100-399

    function validateNumber(input: HTMLInputElement, errorEl: HTMLElement, regex: RegExp, msg: string): boolean {
      const value = input.value.trim().replace(',', '.');
      
      if (!value) {
        input.classList.add('border-red-400', 'bg-red-50');
        input.classList.remove('border-green-400');
        errorEl.textContent = 'Este campo es obligatorio';
        errorEl.classList.remove('hidden');
        return false;
      }

      if (!regex.test(value)) {
        input.classList.add('border-red-400', 'bg-red-50');
        input.classList.remove('border-green-400');
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
        return false;
      }

      input.classList.remove('border-red-400', 'bg-red-50');
      input.classList.add('border-green-400');
      errorEl.classList.add('hidden');
      return true;
    }

    // ===== NORMALIZACIÓN (quitar comas, parsear) =====
    function normalizeNumber(value: string): number {
      return parseFloat(
        value.trim()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(',', '.')
      );
    }

    // ===== EVENT: Selección de miel =====
    honeySelect.addEventListener('change', () => {
      const selected = honeyTypes.find(h => h.id === honeySelect.value);
      honeyDesc.textContent = selected ? selected.description : '';
    });

    // ===== EVENT: Toggle horno =====
    usesOven.addEventListener('change', () => {
      ovenGroup.classList.toggle('hidden', !usesOven.checked);
      if (!usesOven.checked) {
        ovenInput.value = '';
        tempError.classList.add('hidden');
        ovenInput.classList.remove('border-red-400', 'bg-red-50', 'border-green-400');
      }
    });

    // ===== VALIDACIÓN EN TIEMPO REAL =====
    sugarInput.addEventListener('blur', () => {
      if (sugarInput.value.trim()) {
        validateNumber(sugarInput, sugarError, regexNumero, 'Introduce un número válido (ej: 200 o 150,5)');
      }
    });
    ovenInput.addEventListener('blur', () => {
      if (ovenInput.value.trim()) {
        validateNumber(ovenInput, tempError, regexTemperatura, 'Introduce una temperatura entre 100 y 399 °C');
      }
    });

    // ===== CALCULAR =====
    calcBtn.addEventListener('click', () => {
      // Validar miel seleccionada
      const honey = honeyTypes.find(({ id }) => id === honeySelect.value);
      if (!honey) {
        honeySelect.classList.add('border-red-400', 'bg-red-50');
        honeySelect.focus();
        return;
      }
      honeySelect.classList.remove('border-red-400', 'bg-red-50');

      // Validar cantidad
      const sugarValid = validateNumber(sugarInput, sugarError, regexNumero, 'Introduce un número válido (ej: 200 o 150,5)');
      if (!sugarValid) return;

      // Validar temperatura si aplica
      if (usesOven.checked && ovenInput.value.trim()) {
        const tempValid = validateNumber(ovenInput, tempError, regexTemperatura, 'Introduce una temperatura entre 100 y 399 °C');
        if (!tempValid) return;
      }

      // ===== CÁLCULOS =====
      const { name, sweetness, tips: honeyTips } = honey;

      const sugarAmount = normalizeNumber(sugarInput.value);
      const unit = sugarUnit.value;
      const sugarInGrams = sugarAmount * UNIT_TO_GRAMS[unit];

      // Cantidad de miel = azúcar / índice de dulzor
      const honeyInGrams = sugarInGrams / sweetness;
      // Convertir de vuelta a la unidad seleccionada
      const honeyInUnit = honeyInGrams / UNIT_TO_GRAMS[unit];

      // Reducción de líquidos: 25% del peso de la miel
      const liquidReduction = honeyInGrams * 0.25;

      // Calorías ahorradas
      const sugarCalories = sugarInGrams * SUGAR_CAL_PER_G;
      const honeyCalories = honeyInGrams * HONEY_CAL_PER_G;
      const caloriesSaved = Math.round(sugarCalories - honeyCalories);

      // Temperatura del horno
      let newTemp: number | null = null;
      if (usesOven.checked && ovenInput.value.trim()) {
        newTemp = normalizeNumber(ovenInput.value) - 15;
      }

      // ===== MOSTRAR LOADING =====
      placeholder.classList.add('hidden');
      resultPanel.classList.add('hidden');
      loadingEl.classList.remove('hidden');

      setTimeout(() => {
        loadingEl.classList.add('hidden');
        resultPanel.classList.remove('hidden');
        resetBtn.classList.remove('hidden');

        // Resultado principal
        const resultAmount = document.getElementById('result-amount') as HTMLElement;
        const resultUnit = document.getElementById('result-unit') as HTMLElement;
        const resultName = document.getElementById('result-honey-name') as HTMLElement;

        resultAmount.textContent = honeyInUnit < 10 
          ? honeyInUnit.toFixed(1) 
          : Math.round(honeyInUnit).toString();
        resultUnit.textContent = UNIT_LABELS[unit];
        resultName.textContent = name;

        // Reducción de líquidos
        const resultLiquid = document.getElementById('result-liquid') as HTMLElement;
        resultLiquid.textContent = `-${Math.round(liquidReduction)}ml`;

        // Temperatura
        const tempCard = document.getElementById('result-temp-card') as HTMLElement;
        const resultTemp = document.getElementById('result-temp') as HTMLElement;
        if (newTemp !== null) {
          tempCard.classList.remove('hidden');
          resultTemp.textContent = `${newTemp}°C`;
        } else {
          tempCard.classList.add('hidden');
        }

        // Calorías
        const resultCal = document.getElementById('result-calories') as HTMLElement;
        resultCal.textContent = caloriesSaved > 0 ? `-${caloriesSaved} kcal` : '~0 kcal';

        // Dulzor
        const resultSweet = document.getElementById('result-sweetness') as HTMLElement;
        resultSweet.textContent = `×${sweetness.toFixed(2)}`;

        // Tips (filter para mostrar solo los relevantes + tips generales)
        const resultTips = document.getElementById('result-tips') as HTMLElement;
        const generalTips = [
          'Añade la miel al final de la mezcla para conservar mejor su aroma.',
          'Engrasa el recipiente medidor con aceite para que la miel no se pegue.',
        ];

        const ovenTip = usesOven.checked 
          ? ['La miel se carameliza a menor temperatura que el azúcar, vigila el horneado.']
          : [];

        const allTips = [...honeyTips, ...ovenTip, ...generalTips];

        resultTips.innerHTML = allTips
          .filter((tip, index) => index < 4)
          .map(tip => `<li class="flex items-start gap-2"><span class="text-[#F59E0B] mt-0.5">✓</span><span>${tip}</span></li>`)
          .join('');

      }, 600);
    });

    // ===== RESET =====
    resetBtn.addEventListener('click', () => {
      honeySelect.value = '';
      honeyDesc.textContent = '';
      sugarInput.value = '';
      ovenInput.value = '';
      usesOven.checked = false;
      ovenGroup.classList.add('hidden');
      resetBtn.classList.add('hidden');
      resultPanel.classList.add('hidden');
      placeholder.classList.remove('hidden');

      // Limpiar validaciones
      [sugarInput, ovenInput, honeySelect].forEach(el => {
        el.classList.remove('border-red-400', 'bg-red-50', 'border-green-400');
      });
      [sugarError, tempError].forEach(el => el.classList.add('hidden'));
    });

  });
</script>

<style>
  .hexagon{position:absolute;width:100px;height:57.74px;background-color:rgba(245,158,11,.05);margin:28.87px 0}
