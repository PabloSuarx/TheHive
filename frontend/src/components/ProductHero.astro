---
import { Image } from "astro:assets";
import type { Product } from "../types/product";

interface Props {
    product: Product;
    breadcrumName?: string;
    breadcrumProducts?: string;
    imageUrl?: string;
}

const {
    product,
    breadcrumName = "Inicio",
    breadcrumProducts = "Productos",
    imageUrl,
} = Astro.props;
---

<!-- Breadcrumb -->
<nav class="bg-gray-50 py-3">
    <div class="container mx-auto px-4 lg:px-8">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
            <li>
                <a href="/" class="hover:text-warning transition-colors">
                    {breadcrumName}
                </a>
            </li>
            <li><span class="mx-1">/</span></li>
            <li>
                <a href="/productos" class="hover:text-warning transition-colors">
                    {breadcrumProducts}
                </a>
            </li>
            {
                product.category && (
                    <>
                        <li>
                            <span class="mx-1">/</span>
                        </li>
                        <li>
                            <a
                                href={`/categoria/${product.category.slug}`}
                                class="hover:text-warning transition-colors"
                            >
                                {product.category.name}
                            </a>
                        </li>
                    </>
                )
            }
            <li><span class="mx-1">/</span></li>
            <li class="text-gray-900 font-medium">{product.name}</li>
        </ol>
    </div>
</nav>

<!-- Product Hero -->
<section class="py-12 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
            <!-- Imagen a la izquierda -->
            <div class="space-y-4">
                <div class="relative overflow-hidden rounded-2xl shadow-lg bg-gray-100">
                    {
                        imageUrl && (
                            <Image
                                src={imageUrl}
                                alt={product.name}
                                class="w-full h-auto object-cover"
                                width={800}
                                height={800}
                                loading="eager"
                            />
                        )
                    }
                    {
                        product.organic && (
                            <span class="absolute top-4 left-4 px-4 py-2 bg-green-500 text-white text-sm font-bold rounded-full shadow-lg">
                                Ecológico
                            </span>
                        )
                    }
                    {
                        product.featured && (
                            <span class="absolute top-4 right-4 px-4 py-2 bg-warning text-white text-sm font-bold rounded-full shadow-lg">
                                Destacado
                            </span>
                        )
                    }
                </div>
            </div>

            <!-- Contenido a la derecha -->
            <div class="space-y-6">
                {
                    product.category && (
                        <a
                            href={`/categoria/${product.category.slug}`}
                            class="inline-block text-sm text-warning font-semibold uppercase tracking-wide hover:underline"
                        >
                            {product.category.name}
                        </a>
                    )
                }

                <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 leading-tight">
                    {product.name}
                </h1>

                {
                    product.shortDescription && (
                        <p class="text-lg text-gray-600 leading-relaxed">
                            {product.shortDescription}
                        </p>
                    )
                }

                <slot />
            </div>
        </div>
    </div>
</section>
