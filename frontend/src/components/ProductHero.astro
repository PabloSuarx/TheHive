---
import { Image } from "astro:assets";
import type { Product } from "../types/product";

interface Props {
    product: Product;
    breadcrumName?: string;
    breadcrumProducts?: string;
    imageUrl?: string;
}

const {
    product,
    breadcrumName = "Inicio",
    breadcrumProducts = "Productos",
    imageUrl,
} = Astro.props;
---

<!-- Breadcrumb -->
<nav class="bg-gray-50 py-3">
    <div class="container mx-auto px-4 lg:px-8">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
            <li>
                <a href="/" class="hover:text-warning transition-colors">
                    {breadcrumName}
                </a>
            </li>
            <li><span class="mx-1">/</span></li>
            <li>
                <a href="/productos" class="hover:text-warning transition-colors">
                    {breadcrumProducts}
                </a>
            </li>
            {
                product.category && (
                    <>
                        <li>
                            <span class="mx-1">/</span>
                        </li>
                        <li>
                            <a
                                href={`/categoria/${product.category.slug}`}
                                class="hover:text-warning transition-colors"
                            >
                                {product.category.name}
                            </a>
                        </li>
                    </>
                )
            }
            <li><span class="mx-1">/</span></li>
            <li class="text-gray-900 font-medium">{product.name}</li>
        </ol>
    </div>
</nav>

<!-- Product Hero -->
<section class="py-12 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
            <!-- Imagen a la izquierda -->
            <div class="space-y-4">
                <div class="relative overflow-hidden rounded-2xl shadow-lg bg-gray-100">
                    {
                        imageUrl && (
                            <Image
                                src={imageUrl}
                                alt={product.name}
                                class="w-full h-auto object-cover"
                                width={800}
                                height={800}
                                loading="eager"
                            />
                        )
                    }
                    {
                        product.organic && (
                            <span class="absolute top-4 left-4 px-4 py-2 bg-green-500 text-white text-sm font-bold rounded-full shadow-lg">
                                Ecológico
                            </span>
                        )
                    }
                    {
                        product.featured && (
                            <span class="absolute top-4 right-4 px-4 py-2 bg-warning text-white text-sm font-bold rounded-full shadow-lg">
                                Destacado
                            </span>
                        )
                    }
                </div>
            </div>

            <!-- Contenido a la derecha -->
            <div class="space-y-6">
                {
                    product.category && (
                        <a
                            href={`/categoria/${product.category.slug}`}
                            class="inline-block text-sm text-warning font-semibold uppercase tracking-wide hover:underline"
                        >
                            {product.category.name}
                        </a>
                    )
                }

                <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 leading-tight">
                    {product.name}
                </h1>

                {
                    product.shortDescription && (
                        <p class="text-lg text-gray-600 leading-relaxed">
                            {product.shortDescription}
                        </p>
                    )
                }

                <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-100">
                    <div class="flex items-center border border-gray-200 rounded-xl bg-gray-50 max-w-min">
                        <button
                            class="px-4 py-3 text-gray-500 hover:text-primary transition-colors focus:outline-none"
                            onclick="this.nextElementSibling.stepDown()"
                            aria-label="Disminuir cantidad"
                        >
                            -
                        </button>
                        <input
                            type="number"
                            id="quantity-input"
                            value="1"
                            min="1"
                            max="99"
                            class="w-12 text-center bg-transparent border-none focus:ring-0 font-medium text-gray-900"
                            readonly
                        />
                        <button
                            class="px-4 py-3 text-gray-500 hover:text-primary transition-colors focus:outline-none"
                            onclick="this.previousElementSibling.stepUp()"
                            aria-label="Aumentar cantidad"
                        >
                            +
                        </button>
                    </div>

                    <button
                        id="hero-add-to-cart"
                        class="flex-1 bg-primary hover:bg-primary-dark text-white font-bold py-3 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
                        data-product={JSON.stringify(product)}
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
                            ></path>
                        </svg>
                        Añadir al Carrito
                    </button>
                </div>

                <slot />
            </div>
        </div>
    </div>
</section>

<script>
    import { cartStore } from "../lib/cartStore";
    import type { Product } from "../types/product";

    const addToCartBtn = document.getElementById("hero-add-to-cart");
    const quantityInput = document.getElementById(
        "quantity-input",
    ) as HTMLInputElement;

    if (addToCartBtn) {
        addToCartBtn.addEventListener("click", () => {
            try {
                const productData = addToCartBtn.dataset.product;
                const quantity = parseInt(quantityInput?.value || "1");

                if (productData) {
                    const product: Product = JSON.parse(productData);
                    cartStore.add(product, quantity);

                    // Feedback
                    const originalText = addToCartBtn.innerHTML;
                    addToCartBtn.innerHTML = `
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        ¡Añadido!
                    `;
                    addToCartBtn.classList.remove("bg-primary", "hover:bg-primary-dark");
                    addToCartBtn.classList.add("bg-green-600", "hover:bg-green-700");

                    setTimeout(() => {
                        addToCartBtn.innerHTML = originalText;
                        addToCartBtn.classList.add("bg-primary", "hover:bg-primary-dark");
                        addToCartBtn.classList.remove("bg-green-600", "hover:bg-green-700");
                    }, 2000);
                }
            } catch (error) {
                console.error("Error adding to cart:", error);
            }
        });
    }
</script>
