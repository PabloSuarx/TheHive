---
import Layout from "../../layouts/Layout.astro";
import ProductHero from "../../components/features/product/ProductHero.astro"
import Map from "../../components/features/contact/map/LeafletMap.astro"
import { Image } from "astro:assets";
import { get } from "../../lib/strapi";
import type { Product, Review, Tag } from "../../types/product";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const { slug } = Astro.params;

const product = await get("products", {
  filters: { slug: { $eq: slug } },
  populate: {
    mainImage: true,
    images: true,
    category: true,
    tags: true,
    seo: true,
    reviews: true,
    beekeeper: {
      populate: {
        origin: {
          fields: ["name", "province", "country", "latitude", "longitude"],
        },
      },
    },
  },
}).then((res) => res?.[0] || null);

if (!product) {
  return Astro.redirect("/404");
}

const imgUrl = product.mainImage?.url?.startsWith("http")
  ? product.mainImage.url
  : product.mainImage?.url
    ? `${PUBLIC_STRAPI_URL}${product.mainImage.url}`
    : "/placeholder.svg";

const reviews = product.reviews || [];
const avgRating =
  reviews.length > 0
    ? (
        reviews.reduce(
          (sum: any, r: { rating: any }) => sum + (r.rating || 0),
          0
        ) / reviews.length
      ).toFixed(1)
    : null;

const outOfStock = (product.stock || 0) <= 0;

const seoTitle = product.seo?.metaTitle || product.name;
const seoDescription =
  product.seo?.metaDescription ||
  product.shortDescription ||
  `Compra ${product.name} - Miel artesanal 100% natural`;

const formatPrice = (p: any) =>
  p.toLocaleString("es-ES", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

export async function getStaticPaths() {
  const products = await get("products");
  return products.map((product: any) => ({
    params: { slug: product.slug },
  }));
}

---

<Layout
  titulo={seoTitle}
  descripcion={seoDescription}
  keywords={`miel ${product.name}, comprar ${product.name}, miel artesanal`}
>
  <ProductHero product={product} imageUrl={imgUrl}>
    {
      avgRating && (
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1">
            {[...Array(5)].map((_, i) => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                fill="currentColor"
                class={`bi ${
                  i < Math.round(Number(avgRating))
                    ? "text-warning"
                    : "text-text-tertiary"
                }`}
                viewBox="0 0 16 16"
              >
                <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
              </svg>
            ))}
          </div>
          <span class="text-sm text-text-secondary">
            {avgRating} ({reviews.length}{" "}
            {reviews.length === 1 ? "reseña" : "reseñas"})
          </span>
        </div>
      )
    }

    <!-- Precio -->
    <div class="flex items-end gap-4">
      <span class="text-4xl font-bold text-warning"
        >{formatPrice(product.price)}€</span
      >
      {
        product.weightValue && product.weightUnit && (
          <span class="text-lg text-text-tertiary mb-1">
            / {product.weightValue}
            {product.weightUnit}
          </span>
        )
      }
    </div>

    <!-- Stock -->
    <div class="flex items-center gap-2">
      {
        outOfStock ? (
          <span class="inline-flex items-center gap-1 text-error font-medium">
            <span class="w-2 h-2 bg-error rounded-full" />
            Agotado
          </span>
        ) : (
          <span class="inline-flex items-center gap-1 text-success font-medium">
            <span class="w-2 h-2 bg-success rounded-full" />
            En stock ({product.stock} disponibles)
          </span>
        )
      }
    </div>

    <!-- <button
      class={`w-full py-4 rounded-xl font-bold text-lg transition-colors ${
        outOfStock
          ? "bg-gray-300 text-gray-500 cursor-not-allowed"
          : "bg-warning hover:bg-warning/90 text-white shadow-lg hover:shadow-xl"
      }`}
      disabled={outOfStock}
    >
      {outOfStock ? "Sin Stock" : "Añadir al Carrito"}
    </button> -->

    <!-- Detalles rápidos -->
    <div class="grid grid-cols-2 gap-4 pt-4 border-t border-divider">
      {
        product.origin && (
          <div>
            <span class="text-xs text-text-tertiary uppercase tracking-wide">
              Origen
            </span>
            <p class="font-medium text-text-primary">{product.origin}</p>
          </div>
        )
      }
      {
        product.beekeeper && (
          <div>
            <span class="text-xs text-text-tertiary uppercase tracking-wide">
              Apicultor
            </span>
            <p class="font-medium text-text-primary">{product.beekeeper.nombre}</p>
          </div>
        )
      }
      {
        product.crystallization && (
          <div>
            <span class="text-xs text-text-tertiary uppercase tracking-wide">
              Textura
            </span>
            <p class="font-medium text-text-primary">{product.crystallization}</p>
          </div>
        )
      }
      {
        product.harvestSeason && (
          <div>
            <span class="text-xs text-text-tertiary uppercase tracking-wide">
              Cosecha
            </span>
            <p class="font-medium text-text-primary">{product.harvestSeason}</p>
          </div>
        )
      }
      {
        product.flavorNotes && (
          <div class="col-span-2">
            <span class="text-xs text-text-tertiary uppercase tracking-wide">
              Notas de sabor
            </span>
            <p class="font-medium text-text-primary">{product.flavorNotes}</p>
          </div>
        )
      }
    </div>

    <!-- Tags -->
    {
      product.tags && product.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {product.tags.map((tag: Tag) => (
            <span class="px-3 py-1 bg-warning/20 text-warning text-xs font-medium rounded-full">
              {tag.name}
            </span>
          ))}
        </div>
      )
    }
  </ProductHero>

  <!-- Descripción, Beneficios y Reseñas -->
  <section class="py-12 bg-bg-primary">
    <div class="container mx-auto px-4 lg:px-8">
      <!-- Descripción completa -->
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Columna Izquierda: Descripción y Beneficios -->
        <div>
          {
            product.description && (
              <div class="max-w-none">
                <h2 class="text-2xl font-bold text-text-primary mb-6">Descripción</h2>
                <div
                  class="prose prose-gray max-w-none"
                  set:html={product.description}
                />
              </div>
            )
          }

          {
            product.benefits && (
              <div class="mt-12 max-w-none">
                <h2 class="text-2xl font-bold text-text-primary mb-6">Beneficios</h2>
                <p class="text-text-secondary leading-relaxed">{product.benefits}</p>
              </div>
            )
          }
        </div>

        <!-- Columna Derecha: Mapa -->
        <div>
          {
            product.beekeeper?.origin.latitude && product.beekeeper?.origin.longitude && (
              <div class="rounded-2xl overflow-hidden border border-divider sticky top-24">
                 <Map
                    lat={product.beekeeper.origin.latitude}
                    lng={product.beekeeper.origin.longitude}
                    zoom={10}
                    containerId={`map-${product.slug}`}
                    className="w-full h-[350px] z-0"
                 />
                 <div class="bg-bg-secondary p-3 text-center text-sm text-text-tertiary border-t border-divider">
                    Colmenas: {product.beekeeper.origin.name}
                 </div>
              </div>
            )
          }
        </div>
      </div>

      <!-- Sección de reseñas (Full Width) -->
      {
        reviews.length > 0 && (
          <div class="mt-16 w-full">
            <h2 class="text-2xl font-bold text-text-primary mb-8">
              Reseñas ({reviews.length})
            </h2>
            <div class="space-y-6">
              {reviews.map((review: Review) => (
                <article class="bg-bg-secondary p-6 rounded-xl">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-warning rounded-full flex items-center justify-center text-text-inverse font-bold text-sm">
                        {review.userName
                          ? review.userName.charAt(0).toUpperCase()
                          : "?"}
                      </div>
                      <span class="font-semibold text-text-primary">
                        {review.userName || "Anónimo"}
                      </span>
                    </div>
                    <div class="flex items-center gap-1">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          fill="currentColor"
                          class={`bi ${
                            i < (review.rating || 0)
                              ? "text-warning"
                              : "text-text-tertiary"
                          }`}
                          viewBox="0 0 16 16"
                        >
                          <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                        </svg>
                      ))}
                    </div>
                  </div>
                  {review.comment && (
                    <p class="text-text-secondary italic">"{review.comment}"</p>
                  )}
                </article>
              ))}
            </div>
          </div>
        )
      }
    </div>


<!-- Volver -->
<section class="py-8 bg-bg-secondary">
  <div class="container mx-auto px-4 lg:px-8 text-center">
    <a
      href="/productos"
      class="inline-flex items-center gap-2 text-warning font-semibold hover:text-primary-dark transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
        class="bi bi-arrow-left"
        viewBox="0 0 16 16"
      >
        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
      </svg>
      Volver a todos los productos
    </a>
  </div>
</section>

    
  </section>
</Layout>
