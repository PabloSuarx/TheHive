---
import Layout from "../layouts/Layout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { get } from "../lib/strapi";
import CategorySection from "../components/category_section/CategorySection.astro";
import CategoryHeroSection from "../components/category_section/CategoryHeroSection.astro";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const categories = (await get("categories", { populate: { image: true } })) || [];
---

<Layout
  titulo="Categorías"
  descripcion="Explora nuestras categorías de miel artesanal: monoflora, multiflora, premium y más."
  keywords="categorías miel, tipos de miel, miel monoflora, miel multiflora, miel premium"
>


  <!-- Hero -->
  <section class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <CategoryHeroSection />
  </section>

  <section class="py-12 bg-linear-to-b from-primary-pale to-bg-primary">
    <CategorySection categories={categories} />
  </section>
</Layout>
