---
import Layout from "../layouts/Layout.astro";
import { get } from "../lib/strapi";

import Hero from "../components/home/Hero.astro";
import CategoriesSection from "../components/home/CategoriesSection.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
import WhyChooseUs from "../components/home/WhyChooseUs.astro";
import Testimonials from "../components/home/Testimonials.astro";
import BlogSection from "../components/home/BlogSection.astro";
import CallToAction from "../components/home/CallToAction.astro";
import CalculadoraDulzor from "../components/CalculadoraDulzor.astro";

const blogs = await get("blogs", {
  populate: {
    featuredImage: true,
    blog_category: true,
    tags: true,
  },
  sort: { blogPublishedAt: "desc" },
});
const latestBlogs = blogs?.slice(0, 3) || [];

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const buttonsData = await get("ui-component");
const buttons = buttonsData?.buttons || [];
const categories =
  (await get("categories", { populate: { image: true } })) || [];

const buttonsByName = buttons.reduce((acc, btn) => {
  acc[btn.content] = btn;
  return acc;
}, {});
---

<Layout
  titulo="Inicio"
  descripcion="The Hive - Miel artesanal de calidad premium directamente de la colmena a tu mesa. Descubre nuestras mieles monoflora, multiflora y productos naturales 100% puros."
  keywords="miel artesanal, miel natural, miel premium, miel pura, apicultura sostenible, productos naturales, miel de azahar, miel multiflora"
>
  <Hero buttonsByName={buttonsByName} />

  <CategoriesSection
    categories={categories}
    publicStrapiUrl={PUBLIC_STRAPI_URL}
  />

  <FeaturedProducts buttonsByName={buttonsByName} />

  <WhyChooseUs />

  <Testimonials />

  <BlogSection latestBlogs={latestBlogs} publicStrapiUrl={PUBLIC_STRAPI_URL} />

  <CalculadoraDulzor />

  <CallToAction buttonsByName={buttonsByName} />

  
</Layout>
