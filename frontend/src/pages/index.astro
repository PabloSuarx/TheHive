---
import Layout from "../layouts/Layout.astro";
import { get } from "../lib/strapi";

import Hero from "../components/features/home/Hero.astro"
import CategoriesSection from "../components/features/home/CategoriesSection.astro"
import FeaturedProducts from "../components/features/home/FeaturedProducts.astro"
import WhyChooseUs from "../components/features/home/WhyChooseUs.astro"
import Testimonials from "../components/features/home/Testimonials.astro"
import BlogSection from "../components/features/home/BlogSection.astro"
import CallToAction from "../components/features/home/CallToAction.astro"
import CalculadoraDulzor from "../components/features/product/CalculadoraDulzor.astro"

const homePageData = await get("home-page", { populate: "*" });

const fallbackData = {
  pageTitle: "Inicio",
  pageDescription: "The Hive - Miel artesanal de calidad premium directamente de la colmena a tu mesa. Descubre nuestras mieles monoflora, multiflora y productos naturales 100% puros.",
  pageKeywords: "miel artesanal, miel natural, miel premium, miel pura, apicultura sostenible, productos naturales, miel de azahar, miel multiflora",

  categoriesSectionTitle: "Nuestras Categorías",
  categoriesSectionSubtitle: "Explora nuestra selección de mieles artesanales, cada una con su carácter único",
  categoriesEmptyIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-grid-3x3-gap mx-auto mb-4 text-text-tertiary" viewBox="0 0 16 16">
            <path d="M4 2v2H2V2zm1 12v-2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m5 10v-2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m5 10v-2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V7a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1"/>
          </svg>`,
  categoriesEmptyMessage: "No hay categorías disponibles todavía.",

  featuredProductsTitle: "Productos Destacados",
  featuredProductsSubtitle: "Las mieles favoritas de nuestros clientes",
  featuredProductsEcoLabel: "Eco",
  featuredProductsFeaturedLabel: "Destacado",
  featuredProductsButtonText: "Ver Producto",
  featuredProductsEmptyMessage: "No hay productos destacados disponibles en este momento.",

  blogSectionTitle: "Últimas del Blog",
  blogSectionSubtitle: "Aprende más sobre la miel y sus beneficios",
  blogSectionLinkText: "Ver todos",
  blogSectionLinkIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
          </svg>`,
  blogSectionEmptyIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-journal-text mx-auto mb-4 text-text-tertiary" viewBox="0 0 16 16">
            <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
            <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2"/>
            <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z"/>
          </svg>`,
  blogSectionEmptyMessage: "Pronto publicaremos artículos.",

  ctaTitle: "¿Listo para Probar la Mejor Miel?",
  ctaSubtitle: "Únete a miles de clientes satisfechos y descubre el auténtico sabor de la miel artesanal",
};

const pageTitle = homePageData?.seo?.metaTitle ?? fallbackData.pageTitle;
const pageDescription = homePageData?.seo?.metaDescription ?? fallbackData.pageDescription;
const pageKeywords = homePageData?.seo?.keywords ?? fallbackData.pageKeywords;

const categoriesSectionTitle = homePageData?.categoriesSectionTitle ?? fallbackData.categoriesSectionTitle;
const categoriesSectionSubtitle = homePageData?.categoriesSectionSubtitle ?? fallbackData.categoriesSectionSubtitle;
const categoriesEmptyIcon = homePageData?.categoriesEmptyIcon ?? fallbackData.categoriesEmptyIcon;
const categoriesEmptyMessage = homePageData?.categoriesEmptyMessage ?? fallbackData.categoriesEmptyMessage;

const featuredProductsTitle = homePageData?.featuredProductsTitle ?? fallbackData.featuredProductsTitle;
const featuredProductsSubtitle = homePageData?.featuredProductsSubtitle ?? fallbackData.featuredProductsSubtitle;
const featuredProductsEcoLabel = homePageData?.featuredProductsEcoLabel ?? fallbackData.featuredProductsEcoLabel;
const featuredProductsFeaturedLabel = homePageData?.featuredProductsFeaturedLabel ?? fallbackData.featuredProductsFeaturedLabel;
const featuredProductsButtonText = homePageData?.featuredProductsButtonText ?? fallbackData.featuredProductsButtonText;
const featuredProductsEmptyMessage = homePageData?.featuredProductsEmptyMessage ?? fallbackData.featuredProductsEmptyMessage;

const blogSectionTitle = homePageData?.blogSectionTitle ?? fallbackData.blogSectionTitle;
const blogSectionSubtitle = homePageData?.blogSectionSubtitle ?? fallbackData.blogSectionSubtitle;
const blogSectionLinkText = homePageData?.blogSectionLinkText ?? fallbackData.blogSectionLinkText;
const blogSectionLinkIcon = homePageData?.blogSectionLinkIcon ?? fallbackData.blogSectionLinkIcon;
const blogSectionEmptyIcon = homePageData?.blogSectionEmptyIcon ?? fallbackData.blogSectionEmptyIcon;
const blogSectionEmptyMessage = homePageData?.blogSectionEmptyMessage ?? fallbackData.blogSectionEmptyMessage;

const ctaTitle = homePageData?.ctaTitle ?? fallbackData.ctaTitle;
const ctaSubtitle = homePageData?.ctaSubtitle ?? fallbackData.ctaSubtitle;

const blogs = await get("blogs", {
  populate: {
    featuredImage: true,
    blog_category: true,
    tags: true,
  },
  sort: { blogPublishedAt: "desc" },
});
const latestBlogs = blogs?.slice(0, 3) || [];

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const buttonsData = await get("ui-component");
const buttons = buttonsData?.buttons || [];
const categories =
  (await get("categories", { populate: { image: true } })) || [];

const buttonsByName = buttons.reduce((total : any, button : any) => {
  total[button.content] = button;
  return total;
}, {});

---

<Layout
  titulo={pageTitle}
  descripcion={pageDescription}
  keywords={pageKeywords}
>
  <section class="relative overflow-hidden bg-linear-to-b from-bg-primary to-primary-pale py-20 lg:py-32">
    <Hero />
  </section>

  <section class="py-20  bg-linear-to-b from-primary-pale to-bg-primary">
    <CategoriesSection
      categories={categories}
      publicStrapiUrl={PUBLIC_STRAPI_URL}
      title={categoriesSectionTitle}
      subtitle={categoriesSectionSubtitle}
      emptyIcon={categoriesEmptyIcon}
      emptyMessage={categoriesEmptyMessage}
    />
  </section>

  <section class="py-20 bg-linear-to-b from-bg-primary to-primary-pale">
    <FeaturedProducts
      buttonsByName={buttonsByName}
      title={featuredProductsTitle}
      subtitle={featuredProductsSubtitle}
      ecoLabel={featuredProductsEcoLabel}
      featuredLabel={featuredProductsFeaturedLabel}
      buttonText={featuredProductsButtonText}
      emptyMessage={featuredProductsEmptyMessage}
    />
  </section>

  <section class="py-20 bg-linear-to-b from-primary-pale to-bg-primary">
    <WhyChooseUs />
  </section>

  <section class="py-20 bg-linear-to-b from-bg-primary to-primary-pale">
    <Testimonials />
  </section>

  <section class="py-20 bg-linear-to-b from-primary-pale to-bg-primary">
    <BlogSection
      latestBlogs={latestBlogs}
      publicStrapiUrl={PUBLIC_STRAPI_URL}
      title={blogSectionTitle}
      subtitle={blogSectionSubtitle}
      linkText={blogSectionLinkText}
      linkIcon={blogSectionLinkIcon}
      emptyIcon={blogSectionEmptyIcon}
      emptyMessage={blogSectionEmptyMessage}
    />
  </section>

  <section class="py-20 bg-linear-to-b from-bg-primary to-primary-pale">
    <CalculadoraDulzor />
  </section>

  <section class="py-20 bg-linear-to-b from-primary-pale to-bg-primary">
    <CallToAction
      buttonsByName={buttonsByName}
      title={ctaTitle}
      subtitle={ctaSubtitle}
    />
  </section>

</Layout>
