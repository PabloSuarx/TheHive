---
import Layout from "../layouts/Layout.astro";
import CustomLoader from "../components/ui/CustomLoader.astro";
import { get } from "../lib/strapi.js";

const registroPageData = await get("registro-page", { populate: "*" });

const fallbackData = {
  heroTitle: "Crear Cuenta",
  heroSubtitle: "Únete a nuestra comunidad",
  errorIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-circle shrink-0" viewBox="0 0 16 16">
    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
    <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
  </svg>`,
  firstNameLabel: "Nombre",
  firstNameIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
  </svg>`,
  firstNamePlaceholder: "Juan",
  lastNameLabel: "Apellido",
  lastNameIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
  </svg>`,
  lastNamePlaceholder: "Pérez",
  usernameLabel: "Nombre de usuario",
  usernameIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-at" viewBox="0 0 16 16">
    <path d="M13.106 7.222c0-2.967-2.249-5.032-5.482-5.032-3.35 0-5.646 2.318-5.646 5.702 0 3.493 2.235 5.708 5.762 5.708.862 0 1.689-.123 2.304-.335v-.862c-.43.199-1.354.328-2.29.328-2.926 0-4.813-1.88-4.813-4.798 0-2.844 1.921-4.881 4.594-4.881 2.735 0 4.608 1.688 4.608 4.156 0 1.682-.554 2.769-1.416 2.769-.492 0-.772-.28-.772-.76V5.206H8.923v.834h-.11c-.266-.595-.881-.964-1.6-.964-1.4 0-2.378 1.162-2.378 2.823 0 1.737.957 2.906 2.379 2.906.8 0 1.415-.39 1.709-1.087h.11c.081.67.703 1.148 1.503 1.148 1.572 0 2.57-1.415 2.57-3.643zm-7.177.704c0-1.197.54-1.907 1.456-1.907.93 0 1.524.738 1.524 1.907S8.308 9.84 7.371 9.84c-.895 0-1.442-.725-1.442-1.914"/>
  </svg>`,
  usernamePlaceholder: "juanperez",
  emailLabel: "Correo electrónico",
  emailIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
  </svg>`,
  emailPlaceholder: "juan@ejemplo.com",
  phoneLabel: "Teléfono (Opcional)",
  phoneIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
    <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
  </svg>`,
  phonePlaceholder: "+34 600 000 000",
  passwordLabel: "Contraseña",
  passwordIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16">
    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
  </svg>`,
  passwordPlaceholder: "Mínimo 6 caracteres",
  confirmPasswordLabel: "Confirmar Contraseña",
  confirmPasswordIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock-fill" viewBox="0 0 16 16">
    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/>
  </svg>`,
  confirmPasswordPlaceholder: "Repite tu contraseña",
  submitButtonText: "Registrarse",
  alreadyAccountText: "¿Ya tienes una cuenta?",
  loginLinkText: "Inicia Sesión",
  loginLinkHref: "/login",
  errorPasswordMismatch: "Las contraseñas no coinciden.",
  errorPasswordLength: "La contraseña debe tener al menos 6 caracteres.",
  errorEmailInvalid: "Por favor, introduce un correo electrónico válido.",
  errorDefault: "Ha ocurrido un error al registrarse.",
  errorEmailTaken: "El correo electrónico o nombre de usuario ya está en uso.",
  errorConnection: "Error de conexión. Inténtalo de nuevo.",
};
const { metaTitle, metaDescription, keywords } = registroPageData.seo;

const pageData = { ...fallbackData, ...registroPageData };

const {
  heroTitle,
  heroSubtitle,
  errorIcon,
  firstNameLabel,
  firstNameIcon,
  firstNamePlaceholder,
  lastNameLabel,
  lastNameIcon,
  lastNamePlaceholder,
  usernameLabel,
  usernameIcon,
  usernamePlaceholder,
  emailLabel,
  emailIcon,
  emailPlaceholder,
  phoneLabel,
  phoneIcon,
  phonePlaceholder,
  passwordLabel,
  passwordIcon,
  passwordPlaceholder,
  confirmPasswordLabel,
  confirmPasswordIcon,
  confirmPasswordPlaceholder,
  submitButtonText,
  alreadyAccountText,
  loginLinkText,
  loginLinkHref,
  errorPasswordMismatch,
  errorPasswordLength,
  errorEmailInvalid,
  errorDefault,
  errorEmailTaken,
  errorConnection,
} = pageData;

---

<Layout
  titulo={metaTitle}
  descripcion={metaDescription}
  keywords={keywords}
>
  <div class="flex items-center justify-center min-h-[70vh] px-4 py-12">
    <div
      class="w-full max-w-lg bg-bg-primary p-8 rounded-2xl border border-border-color"
      data-error-password-mismatch={errorPasswordMismatch}
      data-error-password-length={errorPasswordLength}
      data-error-email-invalid={errorEmailInvalid}
      data-error-default={errorDefault}
      data-error-email-taken={errorEmailTaken}
      data-error-connection={errorConnection}
    >
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-primary mb-2">{heroTitle}</h1>
        <p class="text-text-secondary">{heroSubtitle}</p>
      </div>

      <div
        id="error-container"
        class="mb-6 p-4 rounded-lg bg-bg-tertiary border border-error text-error text-sm items-center gap-3 hidden"
      >
        <Fragment set:html={errorIcon} />
        <span id="error-message"></span>
      </div>

      <form id="register-form" class="space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label
              for="firstName"
              class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
            >
              <Fragment set:html={firstNameIcon} />
              {firstNameLabel}
            </label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              required
              class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
              placeholder={firstNamePlaceholder}
            />
          </div>
          <div>
            <label
              for="lastName"
              class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
            >
              <Fragment set:html={lastNameIcon} />
              {lastNameLabel}
            </label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              required
              class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
              placeholder={lastNamePlaceholder}
            />
          </div>
        </div>

        <div>
           <label
            for="username"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <Fragment set:html={usernameIcon} />
            {usernameLabel}
          </label>
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={usernamePlaceholder}
          />
        </div>

        <div>
          <label
            for="email"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <Fragment set:html={emailIcon} />
            {emailLabel}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={emailPlaceholder}
          />
        </div>

        <div>
          <label
            for="phone"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <Fragment set:html={phoneIcon} />
            {phoneLabel}
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={phonePlaceholder}
          />
        </div>

        <div>
          <label
            for="password"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <Fragment set:html={passwordIcon} />
            {passwordLabel}
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={passwordPlaceholder}
          />
        </div>

        <div>
          <label
            for="confirmPassword"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <Fragment set:html={confirmPasswordIcon} />
            {confirmPasswordLabel}
          </label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="6"
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={confirmPasswordPlaceholder}
          />
        </div>

        <button
          type="submit"
          id="submit-button"
          class="w-full flex items-center justify-center py-3.5 px-4 rounded-lg bg-primary text-text-inverse font-semibold hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors disabled:opacity-70 disabled:cursor-not-allowed mt-2"
        >
          <span id="button-text">{submitButtonText}</span>
          <div id="button-loader" class="hidden ml-2">
           <CustomLoader size={20} color="white" />
          </div>
        </button>
      </form>

      <div class="mt-6 text-center text-sm text-text-secondary">
        {alreadyAccountText} <a
          href={loginLinkHref}
          class="font-medium text-primary hover:text-primary-dark transition-colors"
          >{loginLinkText}</a
        >
      </div>
    </div>
  </div>
</Layout>

<script>
  import { $user } from "../stores/appStore";

  // Configuration
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // DOM Elements
  const form = document.getElementById("register-form") as HTMLFormElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
  const buttonText = document.getElementById("button-text");
  const buttonLoader = document.getElementById("button-loader");
  const errorContainer = document.getElementById("error-container");
  const formWrapper = document.querySelector("[data-error-password-mismatch]") as HTMLElement;

  // Get error messages from data attributes
  const ERROR_MESSAGES = {
    passwordMismatch: formWrapper?.dataset.errorPasswordMismatch || "Las contraseñas no coinciden.",
    passwordLength: formWrapper?.dataset.errorPasswordLength || "La contraseña debe tener al menos 6 caracteres.",
    emailInvalid: formWrapper?.dataset.errorEmailInvalid || "Por favor, introduce un correo electrónico válido.",
    default: formWrapper?.dataset.errorDefault || "Ha ocurrido un error al registrarse.",
    emailTaken: formWrapper?.dataset.errorEmailTaken || "El correo electrónico o nombre de usuario ya está en uso.",
    connection: formWrapper?.dataset.errorConnection || "Error de conexión. Inténtalo de nuevo.",
  };

  // Auth Guard: Redirect if already logged in
  if ($user.get()?.jwt) {
    window.location.assign("/");
  }

  // Helper to show/hide errors
  const showError = (message: string) => {
    const errorMessage = document.getElementById("error-message");
    if (errorContainer && errorMessage) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
      errorContainer.classList.add("flex");
      // Scroll to error
      errorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  const hideError = () => {
    const errorMessage = document.getElementById("error-message");
    if (errorContainer && errorMessage) {
      errorContainer.classList.add("hidden");
      errorContainer.classList.remove("flex");
      errorMessage.textContent = "";
    }
  };

  // Helper to toggle loading state
  const setLoading = (isLoading: boolean) => {
    const inputs = form.querySelectorAll("input");
    if (isLoading) {
      submitButton.disabled = true;
      inputs.forEach(input => input.disabled = true);
      buttonText?.classList.add("hidden");
      buttonLoader?.classList.remove("hidden");
    } else {
      submitButton.disabled = false;
      inputs.forEach(input => input.disabled = false);
      buttonText?.classList.remove("hidden");
      buttonLoader?.classList.add("hidden");
    }
  };

  // Register handler
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();
    setLoading(true);

    const formData = new FormData(form);
    const firstName = formData.get("firstName") as string;
    const lastName = formData.get("lastName") as string;
    const username = formData.get("username") as string;
    const email = formData.get("email") as string;
    const phone = formData.get("phone") as string;
    const password = formData.get("password") as string;
    const confirmPassword = formData.get("confirmPassword") as string;

    // Local Validation
    if (password !== confirmPassword) {
      showError(ERROR_MESSAGES.passwordMismatch);
      setLoading(false);
      return;
    }

    if (password.length < 6) {
        showError(ERROR_MESSAGES.passwordLength);
        setLoading(false);
        return;
    }

    // Basic email validation regex
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        showError(ERROR_MESSAGES.emailInvalid);
        setLoading(false);
        return;
    }

    try {
      const response = await fetch(`${STRAPI_URL}/api/auth/local/register`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          username,
          email,
          password,
          firstName,
          lastName,
          phone,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        // Handle specific Strapi errors
        let errorMessage = ERROR_MESSAGES.default;

        if (data?.error?.message) {
             errorMessage = data.error.message;
             // Translate common Strapi errors if needed
             if (errorMessage.includes("Email or Username are already taken")) {
                 errorMessage = ERROR_MESSAGES.emailTaken;
             }
        }

        throw new Error(errorMessage);
      }

      // Success!
      // Construct User object matching our interface
      const user = {
        ...data.user,
        jwt: data.jwt,
      };

      // Save to store (persistent)
      $user.set(user);

      // Redirect
      window.location.replace("/");
      
    } catch (error: any) {
      console.error("Registration Error:", error);
      showError(error.message || ERROR_MESSAGES.connection);
      setLoading(false);
    }
  });
</script>
