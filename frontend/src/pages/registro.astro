---
import Layout from "../layouts/Layout.astro";
import CustomLoader from "../components/ui/CustomLoader.astro";
import { $user } from "../stores/appStore";

const siteConfig = {
  siteName: "The Hive",
  // ... other needed config
};
---

<Layout
  titulo="Registrarse"
  descripcion="Crea una cuenta en The Hive"
  siteConfig={siteConfig}
>
  <div class="flex items-center justify-center min-h-[70vh] px-4 py-12">
    <div
      class="w-full max-w-lg bg-white p-8 rounded-2xl shadow-lg border border-[var(--border-color)]"
    >
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-[var(--primary)] mb-2">Crear Cuenta</h1>
        <p class="text-[var(--text-secondary)]">Únete a nuestra comunidad</p>
      </div>

      <div
        id="error-container"
        class="hidden mb-6 p-4 rounded-lg bg-red-50 border border-[var(--color-error)] text-[var(--color-error)] text-sm"
      >
        <!-- Error messages will be injected here -->
      </div>

      <form id="register-form" class="space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label
              for="firstName"
              class="block text-sm font-medium text-[var(--text-primary)] mb-1"
              >Nombre</label
            >
            <input
              type="text"
              id="firstName"
              name="firstName"
              required
              class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
              placeholder="Juan"
            />
          </div>
          <div>
            <label
              for="lastName"
              class="block text-sm font-medium text-[var(--text-primary)] mb-1"
              >Apellido</label
            >
            <input
              type="text"
              id="lastName"
              name="lastName"
              required
              class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
              placeholder="Pérez"
            />
          </div>
        </div>

        <div>
           <label
            for="username"
            class="block text-sm font-medium text-[var(--text-primary)] mb-1"
            >Nombre de usuario</label
          >
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
            placeholder="juanperez"
          />
        </div>

        <div>
          <label
            for="email"
            class="block text-sm font-medium text-[var(--text-primary)] mb-1"
            >Correo electrónico</label
          >
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
            placeholder="juan@ejemplo.com"
          />
        </div>

        <div>
          <label
            for="phone"
            class="block text-sm font-medium text-[var(--text-primary)] mb-1"
            >Teléfono (Opcional)</label
          >
          <input
            type="tel"
            id="phone"
            name="phone"
            class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
            placeholder="+34 600 000 000"
          />
        </div>

        <div>
          <label
            for="password"
            class="block text-sm font-medium text-[var(--text-primary)] mb-1"
            >Contraseña</label
          >
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
            placeholder="Mínimo 6 caracteres"
          />
        </div>

        <div>
          <label
            for="confirmPassword"
            class="block text-sm font-medium text-[var(--text-primary)] mb-1"
            >Confirmar Contraseña</label
          >
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="6"
            class="w-full px-4 py-3 rounded-lg border border-[var(--border-color)] focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent outline-none transition-all disabled:bg-gray-100 disabled:cursor-not-allowed"
            placeholder="Repite tu contraseña"
          />
        </div>

        <button
          type="submit"
          id="submit-button"
          class="w-full flex items-center justify-center py-3.5 px-4 rounded-lg bg-[var(--primary)] text-white font-semibold hover:bg-[var(--primary-dark)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)] focus:ring-offset-2 transition-colors disabled:opacity-70 disabled:cursor-not-allowed mt-2"
        >
          <span id="button-text">Registrarse</span>
          <div id="button-loader" class="hidden ml-2">
           <CustomLoader size={20} color="white" />
          </div>
        </button>
      </form>

      <div class="mt-6 text-center text-sm text-[var(--text-secondary)]">
        ¿Ya tienes una cuenta? <a
          href="/login"
          class="font-medium text-[var(--primary)] hover:text-[var(--primary-dark)]"
          >Inicia Sesión</a
        >
      </div>
    </div>
  </div>
</Layout>

<script>
  import { $user } from "../stores/appStore";

  // Configuration
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // DOM Elements
  const form = document.getElementById("register-form") as HTMLFormElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
  const buttonText = document.getElementById("button-text");
  const buttonLoader = document.getElementById("button-loader");
  const errorContainer = document.getElementById("error-container");

  // Auth Guard: Redirect if already logged in
  if ($user.get()?.jwt) {
    window.location.assign("/");
  }

  // Helper to show/hide errors
  const showError = (message: string) => {
    if (errorContainer) {
      errorContainer.textContent = message;
      errorContainer.classList.remove("hidden");
      // Scroll to error
      errorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  const hideError = () => {
    if (errorContainer) {
      errorContainer.classList.add("hidden");
      errorContainer.textContent = "";
    }
  };

  // Helper to toggle loading state
  const setLoading = (isLoading: boolean) => {
    const inputs = form.querySelectorAll("input");
    if (isLoading) {
      submitButton.disabled = true;
      inputs.forEach(input => input.disabled = true);
      buttonText?.classList.add("hidden");
      buttonLoader?.classList.remove("hidden");
    } else {
      submitButton.disabled = false;
      inputs.forEach(input => input.disabled = false);
      buttonText?.classList.remove("hidden");
      buttonLoader?.classList.add("hidden");
    }
  };

  // Register handler
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();
    setLoading(true);

    const formData = new FormData(form);
    const firstName = formData.get("firstName") as string;
    const lastName = formData.get("lastName") as string;
    const username = formData.get("username") as string;
    const email = formData.get("email") as string;
    const phone = formData.get("phone") as string;
    const password = formData.get("password") as string;
    const confirmPassword = formData.get("confirmPassword") as string;

    // Local Validation
    if (password !== confirmPassword) {
      showError("Las contraseñas no coinciden.");
      setLoading(false);
      return;
    }

    if (password.length < 6) {
        showError("La contraseña debe tener al menos 6 caracteres.");
        setLoading(false);
        return;
    }

    // Basic email validation regex
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        showError("Por favor, introduce un correo electrónico válido.");
        setLoading(false);
        return;
    }

    try {
      const response = await fetch(`${STRAPI_URL}/api/auth/local/register`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          username,
          email,
          password,
          firstName,
          lastName,
          phone,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        // Handle specific Strapi errors
        let errorMessage = "Ha ocurrido un error al registrarse.";
        
        if (data?.error?.message) {
             errorMessage = data.error.message;
             // Translate common Strapi errors if needed
             if (errorMessage.includes("Email or Username are already taken")) {
                 errorMessage = "El correo electrónico o nombre de usuario ya está en uso.";
             }
        }
        
        throw new Error(errorMessage);
      }

      // Success!
      // Construct User object matching our interface
      const user = {
        ...data.user,
        jwt: data.jwt,
      };

      // Save to store (persistent)
      $user.set(user);

      // Redirect
      window.location.replace("/");
      
    } catch (error: any) {
      console.error("Registration Error:", error);
      showError(error.message || "Error de conexión. Inténtalo de nuevo.");
      setLoading(false);
    }
  });
</script>
