---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/features/blog/BlogCard.astro"
import BlogHero from "../../components/features/blog/BlogHero.astro"
import RelatedBlogs from "../../components/features/blog/RelatedBlogs.astro"
import MarkdownRenderer from "../../components/ui/MarkdownRenderer.astro"
import { get } from "../../lib/strapi";
import { calculateReadingTime } from "../../utils/readingTime";
import type { Blog } from "../../types/blog";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const STRAPI_TOKEN = import.meta.env.STRAPI_TOKEN;
const { slug } = Astro.params;

// Fetch blog-slug-page data from Strapi
const blogSlugPageData = await get("blog-slug-page", { populate: "*" }).catch(() => null);

// Fallback data with current hardcoded values
const fallbackData = {
  breadcrumbHome: "Inicio",
  breadcrumbBlog: "Blog",
  tagsLabel: "Etiquetas",
  tagsIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-tags" viewBox="0 0 16 16">
  <path d="M3 2v4.586l7 7L14.586 9l-7-7zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586z"/>
  <path d="M5.5 5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m0 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M1 7.086a1 1 0 0 0 .293.707L8.75 15.25l-.043.043a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 0 7.586V3a1 1 0 0 1 1-1z"/>
</svg>`,
  authorLabel: "Escrito por",
  authorTeamLabel: "Equipo The Hive",
  readingTimeIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
  <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
  <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
</svg>`,
  readingTimeSuffix: "min lectura",
  calendarIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar3" viewBox="0 0 16 16">
  <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857z"/>
  <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
</svg>`,
  relatedArticlesTitle: "Artículos Relacionados",
  backToLabel: "Volver al blog",
  arrowLeftIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
  <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
</svg>`,
};

// Merge Strapi data with fallback
const pageData = { ...fallbackData, ...blogSlugPageData };

// Destructure all fields at 100%
const {
  breadcrumbHome,
  breadcrumbBlog,
  tagsLabel,
  tagsIcon,
  authorLabel,
  authorTeamLabel,
  readingTimeIcon,
  readingTimeSuffix,
  calendarIcon,
  relatedArticlesTitle,
  backToLabel,
  arrowLeftIcon,
} = pageData;

const [blog, allBlogs] = (await Promise.all([
  get("blogs", {
    filters: { slug: { $eq: slug } },
    populate: {
      featuredImage: true,
      blog_category: true,
      tags: true,
      seo: true,
    },
  }).then((res: Blog[]) => res?.[0] || null),
  get("blogs", {
    populate: {
      featuredImage: true,
      blog_category: true,
    },
    sort: { blogPublishedAt: "desc" },
  }),
])) as [Blog, Blog[]];

if (!blog) return Astro.redirect("/404");


const calculatedReadingTime = calculateReadingTime(blog.content);

if (blog.content && (blog.readingTime !== calculatedReadingTime) && STRAPI_TOKEN) {
    blog.readingTime = calculatedReadingTime;
    
    fetch(`${PUBLIC_STRAPI_URL}/api/blogs/${blog.documentId}`, {
        method: "PUT",
        headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${STRAPI_TOKEN}`,
        },
        body: JSON.stringify({
            data: {
                readingTime: calculatedReadingTime
            }
        })
    }).catch(err => console.error("Error updating reading time:", err));
}

const imgUrl = blog.featuredImage?.url?.startsWith("http")
  ? blog.featuredImage.url
  : blog.featuredImage?.url
    ? `${PUBLIC_STRAPI_URL}${blog.featuredImage.url}`
    : "/placeholder.svg";

const seoTitle = blog.seo?.metaTitle || blog.title;
const seoDescription =
  blog.seo?.metaDescription ||
  blog.excerpt ||
  `Lee ${blog.title} en el blog de The Hive`;

const relatedBlogs = allBlogs
  .filter(
    (b) =>
      b.slug !== blog.slug && b.blog_category?.slug === blog.blog_category?.slug
  )
  .slice(0, 3);

export async function getStaticPaths() {
  const blogs = await get("blogs");
  return blogs.map((b: any) => ({ params: { slug: b.slug } }));
}
---

<Layout
  titulo={seoTitle}
  descripcion={seoDescription}
  keywords={blog.tags?.map((t) => t.name).join(", ") || "blog miel artesanal"}
>
  <BlogHero
    blog={blog}
    imageUrl={imgUrl}
    breadcrumName={breadcrumbHome}
    calendarIcon={calendarIcon}
    readingTimeIcon={readingTimeIcon}
    readingTimeSuffix={readingTimeSuffix}
  />

  <!-- Contenido -->
  <section class="py-12 bg-bg-primary">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-3xl mx-auto">
        {
          blog.excerpt && (
            <p class="text-xl text-text-secondary leading-relaxed mb-10 border-l-4 border-primary pl-6 italic">
              {blog.excerpt}
            </p>
          )
        }

        {
          blog.content && (
            <MarkdownRenderer content={blog.content} />
          )
        }

        {
          blog.tags && blog.tags.length > 0 && (
            <div class="mt-12 pt-8 border-t border-divider">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-text-tertiary" set:html={tagsIcon} />
                <h4 class="text-sm font-semibold text-text-tertiary uppercase tracking-wide">
                  {tagsLabel}
                </h4>
              </div>
              <div class="flex flex-wrap gap-2">
                {blog.tags.map((tag) => (
                  <span class="px-4 py-2 bg-primary-pale text-primary-dark text-sm font-medium rounded-full">
                    {tag.name}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        {
          blog.author && (
            <div class="mt-10 p-6 bg-bg-secondary rounded-2xl flex items-center gap-4">
              <div class="w-16 h-16 bg-linear-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-text-inverse font-bold text-xl shrink-0">
                {blog.author.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-sm text-text-tertiary">{authorLabel}</p>
                <p class="font-bold text-text-primary text-lg">{blog.author}</p>
                <p class="text-sm text-text-secondary">{authorTeamLabel}</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <RelatedBlogs
    relatedBlogs={relatedBlogs}
    strapiUrl={PUBLIC_STRAPI_URL}
    title={relatedArticlesTitle}
  />

  <!-- Volver -->
  <section class="py-8 bg-bg-secondary">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary-dark transition-colors"
      >
        <span class="w-5 h-5" set:html={arrowLeftIcon} />
        {backToLabel}
      </a>
    </div>
  </section>
</Layout>
