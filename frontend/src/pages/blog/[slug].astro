---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/features/blog/BlogCard.astro"
import BlogHero from "../../components/features/blog/BlogHero.astro"
import RelatedBlogs from "../../components/features/blog/RelatedBlogs.astro"
import MarkdownRenderer from "../../components/ui/MarkdownRenderer.astro"
import { get } from "../../lib/strapi";
import { calculateReadingTime } from "../../utils/readingTime";
import type { Blog } from "../../types/blog";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const STRAPI_TOKEN = import.meta.env.STRAPI_TOKEN;
const { slug } = Astro.params;

const [blog, allBlogs] = (await Promise.all([
  get("blogs", {
    filters: { slug: { $eq: slug } },
    populate: {
      featuredImage: true,
      blog_category: true,
      tags: true,
      seo: true,
    },
  }).then((res: Blog[]) => res?.[0] || null),
  get("blogs", {
    populate: {
      featuredImage: true,
      blog_category: true,
    },
    sort: { blogPublishedAt: "desc" },
  }),
])) as [Blog, Blog[]];

if (!blog) return Astro.redirect("/404");


const calculatedReadingTime = calculateReadingTime(blog.content);

if (blog.content && (blog.readingTime !== calculatedReadingTime) && STRAPI_TOKEN) {
    blog.readingTime = calculatedReadingTime;
    
    fetch(`${PUBLIC_STRAPI_URL}/api/blogs/${blog.documentId}`, {
        method: "PUT",
        headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${STRAPI_TOKEN}`,
        },
        body: JSON.stringify({
            data: {
                readingTime: calculatedReadingTime
            }
        })
    }).catch(err => console.error("Error updating reading time:", err));
}

const imgUrl = blog.featuredImage?.url
  ? `${PUBLIC_STRAPI_URL}${blog.featuredImage.url}`
  : "/placeholder.svg";

const seoTitle = blog.seo?.metaTitle || blog.title;
const seoDescription =
  blog.seo?.metaDescription ||
  blog.excerpt ||
  `Lee ${blog.title} en el blog de The Hive`;

const relatedBlogs = allBlogs
  .filter(
    (b) =>
      b.slug !== blog.slug && b.blog_category?.slug === blog.blog_category?.slug
  )
  .slice(0, 3);

export async function getStaticPaths() {
  const blogs = await get("blogs");
  return blogs.map((b: any) => ({ params: { slug: b.slug } }));
}
---

<Layout
  titulo={seoTitle}
  descripcion={seoDescription}
  keywords={blog.tags?.map((t) => t.name).join(", ") || "blog miel artesanal"}
>
  <BlogHero blog={blog} imageUrl={imgUrl} />

  <!-- Contenido -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-3xl mx-auto">
        {
          blog.excerpt && (
            <p class="text-xl text-gray-600 leading-relaxed mb-10 border-l-4 border-[#F59E0B] pl-6 italic">
              {blog.excerpt}
            </p>
          )
        }

        {
          blog.content && (
            <MarkdownRenderer content={blog.content} />
          )
        }

        {
          blog.tags && blog.tags.length > 0 && (
            <div class="mt-12 pt-8 border-t border-gray-200">
              <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">
                Etiquetas
              </h4>
              <div class="flex flex-wrap gap-2">
                {blog.tags.map((tag) => (
                  <span class="px-4 py-2 bg-warning text-warning text-sm font-medium rounded-full">
                    {tag.name}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        {
          blog.author && (
            <div class="mt-10 p-6 bg-gray-50 rounded-2xl flex items-center gap-4">
              <div class="w-16 h-16 bg-linear-to-br from-warning to-warning rounded-full flex items-center justify-center text-white font-bold text-xl shrink-0">
                {blog.author.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-sm text-gray-500">Escrito por</p>
                <p class="font-bold text-gray-900 text-lg">{blog.author}</p>
                <p class="text-sm text-gray-600">Equipo The Hive</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <RelatedBlogs relatedBlogs={relatedBlogs} strapiUrl={PUBLIC_STRAPI_URL} />

  <!-- Volver -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-warning font-semibold hover:underline"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Volver al blog
      </a>
    </div>
  </section>
</Layout>
