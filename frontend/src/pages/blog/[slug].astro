---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogs, getBlogBySlug } from '../../lib/strapi';

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;
const { slug } = Astro.params;

const blog = await getBlogBySlug(slug);
if (!blog) return Astro.redirect('/404');

const imgUrl = blog.featuredImage?.url 
  ? `${PUBLIC_STRAPI_URL}${blog.featuredImage.url}` 
  : 'https://images.unsplash.com/photo-1587049352846-4a222e784387?w=1200&h=600&fit=crop';

const seoTitle = blog.seo?.metaTitle || blog.title;
const seoDescription = blog.seo?.metaDescription || blog.excerpt || `Lee ${blog.title} en el blog de The Hive`;

const formatDate = (dateStr) => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
};

const wordCount = blog.content ? blog.content.replace(/<[^>]*>/g, '').split(/\s+/).length : 0;
const readTime = Math.max(3, Math.ceil(wordCount / 200));

const allBlogs = await getBlogs();
const relatedBlogs = allBlogs
  .filter(b => b.slug !== blog.slug && b.blog_category?.slug === blog.blog_category?.slug)
  .slice(0, 3);

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((b) => ({ params: { slug: b.slug } }));
}
---

<Layout titulo={seoTitle} descripcion={seoDescription} keywords={blog.tags?.map(t => t.name).join(', ') || 'blog miel artesanal'}>

<!-- Hero -->
<section class="relative">
  <div class="relative h-[400px] lg:h-[500px] overflow-hidden">
    <img src={imgUrl} alt={blog.title} class="w-full h-full object-cover" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
  </div>
  <div class="container mx-auto px-4 lg:px-8 relative z-10 -mt-40">
    <div class="max-w-3xl mx-auto">
      {blog.blog_category && (
        <span class="inline-block px-4 py-1 bg-[#F59E0B] text-white text-sm font-semibold rounded-full mb-4">{blog.blog_category.name}</span>
      )}
      <h1 class="text-3xl lg:text-5xl font-bold text-white mb-6 leading-tight">{blog.title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-white/80 text-sm">
        {blog.author && (
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-gradient-to-br from-[#F59E0B] to-[#D97706] rounded-full flex items-center justify-center text-white font-bold text-xs">
              {blog.author.charAt(0).toUpperCase()}
            </div>
            <span>{blog.author}</span>
          </div>
        )}
        {blog.blogPublishedAt && (
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>{formatDate(blog.blogPublishedAt)}</span>
          </div>
        )}
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>{readTime} min lectura</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Breadcrumb -->
<nav class="bg-gray-50 py-3 mt-8" aria-label="Migas de pan">
  <div class="container mx-auto px-4 lg:px-8">
    <ol class="flex items-center gap-2 text-sm text-gray-500">
      <li><a href="/" class="hover:text-[#F59E0B] transition-colors">Inicio</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/blog" class="hover:text-[#F59E0B] transition-colors">Blog</a></li>
      {blog.blog_category && (<><li><span class="mx-1">/</span></li><li class="text-gray-400">{blog.blog_category.name}</li></>)}
      <li><span class="mx-1">/</span></li>
      <li class="text-gray-900 font-medium truncate max-w-[200px]">{blog.title}</li>
    </ol>
  </div>
</nav>

<!-- Contenido -->
<section class="py-12 bg-white">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="max-w-3xl mx-auto">

      {blog.excerpt && (
        <p class="text-xl text-gray-600 leading-relaxed mb-10 border-l-4 border-[#F59E0B] pl-6 italic">{blog.excerpt}</p>
      )}

      {blog.content && (
        <div class="prose prose-lg prose-gray max-w-none
          prose-headings:text-gray-900 prose-headings:font-bold
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-gray-700 prose-p:leading-relaxed prose-p:mb-6
          prose-a:text-[#F59E0B] prose-a:font-semibold hover:prose-a:text-[#D97706]
          prose-img:rounded-xl prose-img:shadow-lg
          prose-blockquote:border-l-[#F59E0B] prose-blockquote:italic prose-blockquote:text-gray-600
          prose-strong:text-gray-900"
          set:html={blog.content} 
        />
      )}

      {blog.tags && blog.tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Etiquetas</h4>
          <div class="flex flex-wrap gap-2">
            {blog.tags.map((tag) => (
              <span class="px-4 py-2 bg-[#FEF3C7] text-[#D97706] text-sm font-medium rounded-full">{tag.name}</span>
            ))}
          </div>
        </div>
      )}

      {blog.author && (
        <div class="mt-10 p-6 bg-gray-50 rounded-2xl flex items-center gap-4">
          <div class="w-16 h-16 bg-gradient-to-br from-[#F59E0B] to-[#D97706] rounded-full flex items-center justify-center text-white font-bold text-xl shrink-0">
            {blog.author.charAt(0).toUpperCase()}
          </div>
          <div>
            <p class="text-sm text-gray-500">Escrito por</p>
            <p class="font-bold text-gray-900 text-lg">{blog.author}</p>
            <p class="text-sm text-gray-600">Equipo The Hive</p>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<!-- Relacionados -->
{relatedBlogs.length > 0 && (
  <section class="py-16 bg-gradient-to-b from-white to-[#FEF3C7]">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Artículos Relacionados</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {relatedBlogs.map((r) => (
            <BlogCard
              title={r.title}
              slug={r.slug}
              excerpt={r.excerpt}
              imageUrl={r.featuredImage?.url ? `${PUBLIC_STRAPI_URL}${r.featuredImage.url}` : undefined}
              author={r.author}
              blogPublishedAt={r.blogPublishedAt}
              categoryName={r.blog_category?.name}
            />
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<!-- Volver -->
<section class="py-8 bg-gray-50">
  <div class="container mx-auto px-4 lg:px-8 text-center">
    <a href="/blog" class="inline-flex items-center gap-2 text-[#F59E0B] font-semibold hover:underline">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Volver al blog
    </a>
  </div>
</section>

</Layout>