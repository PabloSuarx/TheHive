---
// pages/contacto.astro
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/ui/Breadcrumbs.astro"
import ContactInfo from "../components/features/contact/ContactInfo.astro"
import ContactForm from "../components/features/contact/ContactForm.astro"
---

<Layout 
  titulo="Contacto"
  descripcion="Ponte en contacto con The Hive. Estamos aquí para ayudarte con cualquier pregunta sobre nuestros productos de miel artesanal, envíos o colaboraciones con apicultores."
  keywords="contacto, atención al cliente, dudas miel, colaboración apicultores, servicio cliente"
>


  <!-- Hero -->
  <section class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <div class="container mx-auto px-4 lg:px-8">
      <Breadcrumbs separator="/" homeLabel="Inicio" />
      <h1 class="text-4xl font-bold text-text-primary mb-2">Contacto</h1>
      <p class="text-lg text-text-secondary max-w-2xl">
        Ponte en contacto con The Hive. Estamos aquí para ayudarte con cualquier pregunta sobre nuestros productos de miel artesanal, envíos o colaboraciones con apicultores.
      </p>
    </div>
  </section>

  <!-- Formulario y Info de Contacto -->
  <section class="py-20 bg-linear-to-b from-primary-pale to-bg-primary">
    <div class="container mx-auto px-4 lg:px-8">
    <div class="grid lg:grid-cols-3 gap-12">
      
      <!-- Columna Izquierda: Información de Contacto -->
      <div class="lg:col-span-1">
        <ContactInfo />
      </div>

      <!-- Columna Derecha: Formulario -->
      <div class="lg:col-span-2">
        <ContactForm />
      </div>

    </div>
  </div>
</section>


</Layout>