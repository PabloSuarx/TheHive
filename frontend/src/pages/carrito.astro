---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import CartItem from "../components/features/cart/CartItem.astro";
---

<Layout
  titulo="Carrito de Compra"
  descripcion="Revisa los productos en tu carrito de compra."
>
  <section class="py-12 bg-bg-secondary min-h-[60vh]">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-4xl font-bold text-text-primary mb-8 text-center">
        Tu Carrito
      </h1>

      <!-- Estado vacío -->
      <div id="cart-empty" class="text-center py-16 hidden">
        <div class="text-6xl mb-4">🛒</div>
        <p class="text-xl text-text-secondary mb-8">Tu carrito está vacío</p>
        <Button link="/productos" variant="primary">Ver Productos</Button>
      </div>

      <!-- Contenido del carrito -->
      <div id="cart-content" class="hidden">
        <div class="grid lg:grid-cols-3 gap-8">

          <!-- Lista de productos -->
          <div class="lg:col-span-2 space-y-4" id="cart-items"></div>

          <!-- Resumen del pedido -->
          <div class="lg:col-span-1">
            <div class="bg-bg-primary p-6 rounded-2xl shadow-lg sticky top-24">
              <h2 class="text-2xl font-bold text-text-primary mb-6">Resumen</h2>
              <div class="space-y-3 mb-6">
                <div class="flex justify-between text-text-secondary">
                  <span>Subtotal</span>
                  <span id="cart-subtotal">0,00€</span>
                </div>
                <div class="flex justify-between text-text-secondary">
                  <span>Envío</span>
                  <span class="text-success font-medium">Gratis</span>
                </div>
                <div class="border-t border-border-default pt-3 flex justify-between font-bold text-xl">
                  <span>Total</span>
                  <span id="cart-total" class="text-primary">0,00€</span>
                </div>
              </div>
              <Button
                link="#"
                variant="primary"
                className="w-full justify-center mb-3"
                id="checkout-btn"
              >
                Tramitar Pedido
              </Button>
              <p class="text-xs text-center text-text-tertiary">
                Pagos seguros con tarjeta y PayPal
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Template para items del carrito (renderizado en servidor) -->
  <template id="cart-item-template">
    <CartItem />
  </template>
</Layout>

<script>
  import { $cart, updateQuantity, removeFromCart } from "../stores/appStore";
  import type { CartItem } from "../types/cart";

  const strapiBaseUrl = import.meta.env.PUBLIC_STRAPI_URL;

  // Elementos del DOM
  const cartEmptyState        = document.getElementById("cart-empty");
  const cartContentSection    = document.getElementById("cart-content");
  const cartItemsContainer    = document.getElementById("cart-items");
  const cartSubtotalDisplay   = document.getElementById("cart-subtotal");
  const cartTotalDisplay      = document.getElementById("cart-total");
  const checkoutButton        = document.getElementById("checkout-btn");
  const cartItemTemplate      = document.getElementById("cart-item-template") as HTMLTemplateElement | null;

  // --- Funciones auxiliares ---

  function buildProductImageUrl(imageUrl?: string): string {
    if (!imageUrl) return "/placeholder.svg";
    return imageUrl.startsWith("http") ? imageUrl : `${strapiBaseUrl}${imageUrl}`;
  }

  function formatCurrencyEUR(amount: number): string {
    return `${amount.toLocaleString("es-ES", { minimumFractionDigits: 2 })}€`;
  }

  // --- Renderizado del carrito ---

  function renderCart(cartMap: Record<string, CartItem>) {
    const cartItems = Object.values(cartMap);
    const isCartEmpty = cartItems.length === 0;

    cartEmptyState?.classList.toggle("hidden", !isCartEmpty);
    cartContentSection?.classList.toggle("hidden", isCartEmpty);

    if (!cartItemsContainer || !cartItemTemplate || isCartEmpty) return;

    cartItemsContainer.innerHTML = "";

    cartItems.forEach((cartItem) => {
      try {
        const { product, quantity } = cartItem;
        const productId = product.documentId || product.id.toString();
        const cartItemClone = cartItemTemplate.content.cloneNode(true) as DocumentFragment;

        // Imagen del producto
        const productImageEl = cartItemClone.querySelector(".cart-item-image") as HTMLImageElement | null;
        if (productImageEl) {
          productImageEl.srcset = ""; // Limpiar srcset del placeholder de Astro
          productImageEl.src    = buildProductImageUrl(product.mainImage?.url);
          productImageEl.alt    = product.name;
        }

        // Enlace al producto
        const productLinkEl = cartItemClone.querySelector<HTMLAnchorElement>(".cart-item-link");
        if (productLinkEl) {
          productLinkEl.href        = `/producto/${product.slug}`;
          productLinkEl.textContent = product.name;
        }

        // Variante / peso
        const productVariantEl = cartItemClone.querySelector(".cart-item-variant");
        if (productVariantEl) {
          productVariantEl.textContent = `${product.weightValue}${product.weightUnit}`;
        }

        // Precio unitario
        const productPriceEl = cartItemClone.querySelector(".cart-item-price");
        if (productPriceEl) {
          productPriceEl.textContent = formatCurrencyEUR(product.price);
        }

        // Cantidad actual
        const productQuantityEl = cartItemClone.querySelector(".cart-item-quantity");
        if (productQuantityEl) {
          productQuantityEl.textContent = quantity.toString();
        }

        // Botón: reducir cantidad
        cartItemClone.querySelector(".btn-decrease")?.addEventListener("click", () => {
          if (quantity > 1) updateQuantity(productId, quantity - 1);
        });

        // Botón: aumentar cantidad
        cartItemClone.querySelector(".btn-increase")?.addEventListener("click", () => {
          updateQuantity(productId, quantity + 1);
        });

        // Botón: eliminar del carrito
        cartItemClone.querySelector(".btn-remove")?.addEventListener("click", () => {
          removeFromCart(productId);
        });

        cartItemsContainer.appendChild(cartItemClone);
      } catch (err) {
        console.error("Error al renderizar item del carrito:", err);
      }
    });

    // Calcular y mostrar totales
    const orderTotal = cartItems.reduce(
      (runningTotal, { product, quantity }) => runningTotal + product.price * quantity,
      0
    );
    const formattedTotal = formatCurrencyEUR(orderTotal);

    if (cartSubtotalDisplay) cartSubtotalDisplay.textContent = formattedTotal;
    if (cartTotalDisplay)    cartTotalDisplay.textContent    = formattedTotal;
  }

  // Ir al checkout
  checkoutButton?.addEventListener("click", (e) => {
    e.preventDefault();
    alert("¡Funcionalidad de pago próximamente!");
  });

  // Suscribirse al store y renderizar en cada cambio
  $cart.subscribe(renderCart);
</script>
