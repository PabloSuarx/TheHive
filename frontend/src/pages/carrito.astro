---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import CartItem from "../components/features/cart/CartItem.astro";
---

<Layout
  titulo="Carrito de Compra"
  descripcion="Revisa los productos en tu carrito de compra."
>
  <section class="py-12 bg-bg-secondary min-h-[60vh]">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-4xl font-bold text-text-primary mb-8 text-center">
        Tu Carrito
      </h1>

      <!-- Estado vacío -->
      <div id="cart-empty" class="text-center py-16 hidden">
        <div class="text-6xl mb-4">🛒</div>
        <p class="text-xl text-text-secondary mb-8">Tu carrito está vacío</p>
        <Button link="/productos" variant="primary">Ver Productos</Button>
      </div>

      <!-- Contenido del carrito -->
      <div id="cart-content" class="hidden">
        <div class="grid lg:grid-cols-3 gap-8">

          <!-- Lista de productos -->
          <div class="lg:col-span-2 space-y-4" id="cart-items"></div>

          <!-- Resumen del pedido -->
          <div class="lg:col-span-1">
            <div class="bg-bg-primary p-6 rounded-2xl shadow-lg sticky top-24">
              <h2 class="text-2xl font-bold text-text-primary mb-6">Resumen</h2>
              <div class="space-y-3 mb-6">
                <div class="flex justify-between text-text-secondary">
                  <span>Subtotal</span>
                  <span id="cart-subtotal">0,00€</span>
                </div>
                <div class="flex justify-between text-text-secondary">
                  <span>Envío</span>
                  <span class="text-success font-medium">Gratis</span>
                </div>
                <div class="border-t border-border-default pt-3 flex justify-between font-bold text-xl">
                  <span>Total</span>
                  <span id="cart-total" class="text-primary">0,00€</span>
                </div>
              </div>
              <Button
                link="#"
                variant="primary"
                className="w-full justify-center mb-3"
                id="checkout-btn"
              >
                Tramitar Pedido
              </Button>
              <p class="text-xs text-center text-text-tertiary">
                Pagos seguros con tarjeta y PayPal
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Template para items del carrito (renderizado en servidor) -->
  <template id="cart-item-template">
    <CartItem />
  </template>
</Layout>

<script>
  import { cartStore, updateQuantity, removeFromCart } from "../utils/cartService";
  import type { CartItem } from "../utils/cartService";

  const strapiBaseUrl = import.meta.env.PUBLIC_STRAPI_URL;

  // DOM elements
  const cartEmptyState      = document.getElementById("cart-empty");
  const cartContentSection  = document.getElementById("cart-content");
  const cartItemsContainer  = document.getElementById("cart-items");
  const cartSubtotalDisplay = document.getElementById("cart-subtotal");
  const cartTotalDisplay    = document.getElementById("cart-total");
  const checkoutButton      = document.getElementById("checkout-btn");
  const cartItemTemplate    = document.getElementById("cart-item-template") as HTMLTemplateElement | null;

  // ── Helpers ──────────────────────────────────────────────────────────────────

  function buildImageUrl(imageUrl?: string): string {
    if (!imageUrl) return "/placeholder.svg";
    return imageUrl.startsWith("http") ? imageUrl : `${strapiBaseUrl}${imageUrl}`;
  }

  function fmt(amount: number): string {
    return `${amount.toLocaleString("es-ES", { minimumFractionDigits: 2 })}€`;
  }

  // ── Render ───────────────────────────────────────────────────────────────────

  function renderCart(storeValue: { items: string; count: string; total: string }) {
    let items: CartItem[] = [];
    try { items = JSON.parse(storeValue.items ?? "[]"); } catch { items = []; }

    const isEmpty = items.length === 0;
    cartEmptyState?.classList.toggle("hidden", !isEmpty);
    cartContentSection?.classList.toggle("hidden", isEmpty);

    if (!cartItemsContainer || !cartItemTemplate || isEmpty) return;

    cartItemsContainer.innerHTML = "";

    items.forEach((item) => {
      try {
        const clone = cartItemTemplate.content.cloneNode(true) as DocumentFragment;

        // Image
        const img = clone.querySelector(".cart-item-image") as HTMLImageElement | null;
        if (img) { img.srcset = ""; img.src = buildImageUrl(item.image); img.alt = item.name; }

        // Link / name
        const link = clone.querySelector<HTMLAnchorElement>(".cart-item-link");
        if (link) { link.textContent = item.name; }

        // Price
        const priceEl = clone.querySelector(".cart-item-price");
        if (priceEl) priceEl.textContent = fmt(item.unitPrice);

        // Quantity
        const qtyEl = clone.querySelector(".cart-item-quantity");
        if (qtyEl) qtyEl.textContent = String(item.quantity);

        // Decrease
        clone.querySelector(".btn-decrease")?.addEventListener("click", async () => {
          await updateQuantity(item.productId, item.quantity - 1);
        });

        // Increase
        clone.querySelector(".btn-increase")?.addEventListener("click", async () => {
          await updateQuantity(item.productId, item.quantity + 1);
        });

        // Remove
        clone.querySelector(".btn-remove")?.addEventListener("click", async () => {
          await removeFromCart(item.productId);
        });

        cartItemsContainer.appendChild(clone);
      } catch (err) {
        console.error("Error rendering cart item:", err);
      }
    });

    // Totals
    const subtotal = items.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
    if (cartSubtotalDisplay) cartSubtotalDisplay.textContent = fmt(subtotal);
    if (cartTotalDisplay)    cartTotalDisplay.textContent    = fmt(subtotal);
  }

  // Checkout placeholder
  checkoutButton?.addEventListener("click", (e) => {
    e.preventDefault();
    alert("¡Funcionalidad de pago próximamente!");
  });

  // Subscribe to cartStore
  cartStore.subscribe(renderCart);
</script>
