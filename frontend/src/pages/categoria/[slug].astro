---
/*
 * STRAPI SINGLE TYPE: "CategoriaPage" → endpoint: "categoria-page"
 * Campos:
 * - seo (component shared.seo)
 * - breadcrumbHomeLabel (string)
 * - breadcrumbCategoryLabel (string)
 * - breadcrumbChevronIcon (text - SVG)
 * - resultsTextPrefix (string)
 * - resultsTextMiddle (string)
 * - sortLabel (string)
 * - sortOptions (component categoria.sort-option, repeatable)
 * - sidebarCategoriesHeading (string)
 * - sidebarOriginHeading (string)
 * - sidebarCategoryIcon (text - SVG)
 */
import ProductCard from "../../components/features/product/ProductCard.astro"
import CategoryHero from "../../components/features/category/CategoryHero.astro"
import CategorySidebar from "../../components/features/category/CategorySidebar.astro"
import Layout from "../../layouts/Layout.astro";
import { get } from "../../lib/strapi";
import type { Category } from "../../types/category";
import type { Product } from "../../types/product";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

export async function getStaticPaths() {
  const categories = await get("categories");
  return categories.map((category: Category) => ({
    params: { slug: category.slug },
  }));
}

const { slug } = Astro.params;

const [category, allCategories, categoriaPageData] = (await Promise.all([
  get("categories", {
    filters: { slug: { $eq: slug } },
    populate: {
      image: true,
      seo: true,
      products: {
        populate: {
          mainImage: true,
          category: true,
          reviews: true,
          tags: true,
        },
      },
    },
  }).then((res: Category[]) => res?.[0] || null),
  get("categories"),
  get("categoria-page", { populate: "*" }),
])) as [Category, Category[], any];

if (!category) return Astro.redirect("/404");

const products = category.products || [];
const otherCategories = allCategories.filter((c) => c.slug !== slug);
const uniqueOrigins = [
  ...new Set(products.map((product) => product.origin).filter(Boolean)),
];

const imageUrl = category.image?.url?.startsWith("http")
  ? category.image.url
  : category.image?.url
    ? `${PUBLIC_STRAPI_URL}${category.image.url}`
    : undefined;

// Fallback data con contenido actual hardcodeado
const fallbackData = {
  breadcrumbHomeLabel: "Inicio",
  breadcrumbCategoryLabel: "Categoría",
  breadcrumbChevronIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right mx-2 text-text-tertiary" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>`,
  resultsTextPrefix: "Mostrando",
  resultsTextMiddle: "resultados para",
  sortLabel: "Ordenar por:",
  sortOptions: [
    { label: "Más Populares", value: "popular" },
    { label: "Precio: Menor a Mayor", value: "price-asc" },
    { label: "Precio: Mayor a Menor", value: "price-desc" },
  ],
  sidebarCategoriesHeading: "Categorías",
  sidebarOriginHeading: "Origen",
  sidebarCategoryIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-folder shrink-0" viewBox="0 0 16 16"><path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a2 2 0 0 1 .342-1.31zM2.19 4a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91h10.348a1 1 0 0 0 .995-.91l.637-7A1 1 0 0 0 13.81 4zm4.69-1.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139q.323-.119.684-.12h5.396z" /></svg>`,
};

const pageData = { ...fallbackData, ...categoriaPageData };

const {
  breadcrumbHomeLabel,
  breadcrumbCategoryLabel,
  breadcrumbChevronIcon,
  resultsTextPrefix,
  resultsTextMiddle,
  sortLabel,
  sortOptions,
  sidebarCategoriesHeading,
  sidebarOriginHeading,
  sidebarCategoryIcon,
} = pageData;
---

<Layout
  titulo={category.seo?.metaTitle}
  descripcion={category.seo?.metaDescription}
>
  <CategoryHero
    category={category}
    breadcrumName={breadcrumbHomeLabel}
    breadcrumCategory={breadcrumbCategoryLabel}
    imageUrl={imageUrl}
    chevronIcon={breadcrumbChevronIcon}
  />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col lg:flex-row gap-12">
      <CategorySidebar
        otherCategories={otherCategories}
        uniqueOrigins={uniqueOrigins}
        mainHeading={sidebarCategoriesHeading}
        originHeading={sidebarOriginHeading}
        categoryIcon={sidebarCategoryIcon}
      />

      <div class="flex-1">
        <div
          class="flex items-center justify-between mb-8 pb-6 border-b border-divider"
        >
          <p class="text-sm text-text-secondary">
            {resultsTextPrefix} <span class="text-primary font-medium"
              >{products.length}
            </span> {resultsTextMiddle} <span class="text-primary"
              >{category.name}
            </span>
          </p>
          <div class="flex items-center gap-4">
            <span class="text-sm text-text-secondary">{sortLabel}</span>
            <select
              id="sort-select"
              class="bg-bg-secondary border border-divider rounded-full text-sm text-text-primary px-4 py-2 focus:outline-none focus:border-primary cursor-pointer hover:bg-bg-tertiary transition-all"
            >
              {sortOptions.map((option: any) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
          id="product-grid"
        >
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import type { ProductCardElement } from "../../types/dom";

  const grid = document.getElementById("product-grid");
  const sortSelect = document.getElementById(
    "sort-select"
  ) as HTMLSelectElement | null;
  const originCheckboxes =
    document.querySelectorAll<HTMLInputElement>(".origin-filter");

  if (grid && sortSelect) {
    sortSelect.addEventListener("change", (e) => {
      const target = e.target as HTMLSelectElement;
      const value = target.value;
      const cards = [
        ...grid.querySelectorAll(".product-card"),
      ] as ProductCardElement[];

      cards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.price);
        const priceB = parseFloat(b.dataset.price);

        if (value === "price-asc") return priceA - priceB;
        if (value === "price-desc") return priceB - priceA;
        return 0;
      });

      cards.forEach((card) => grid.appendChild(card));
    });
  }

  if (grid && originCheckboxes.length > 0) {
    originCheckboxes.forEach((cb) => {
      cb.addEventListener("change", () => {
        const checkedOrigins = [...originCheckboxes]
          .filter((c) => c.checked)
          .map((c) => c.value);

        const cards = grid.querySelectorAll(
          ".product-card"
        ) as NodeListOf<ProductCardElement>;

        cards.forEach((card) => {
          const origin = card.dataset.origin;
          const show =
            checkedOrigins.length === 0 || checkedOrigins.includes(origin);
          card.style.display = show ? "" : "none";
        });
      });
    });
  }
</script>
