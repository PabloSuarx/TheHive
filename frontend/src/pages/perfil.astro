---
import Layout from "../layouts/Layout.astro";
import ProfileHero from "../components/profile/ProfileHero.astro";
import OrdersList from "../components/profile/OrdersList.astro";
---

<Layout
  titulo="Mi Perfil"
  descripcion="Gestiona tu perfil y revisa tus pedidos"
>
  <ProfileHero />
  <OrdersList />
</Layout>

<script>
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // ── 1. Auth guard ────────────────────────────────────────────────────────────
  const jwt = localStorage.getItem("jwt");
  if (!jwt) {
    window.location.replace("/login");
  }

  // ── 2. Load user data from /api/users/me and populate DOM ───────────────────
  const profileUsername     = document.getElementById("profile-username");
  const profileEmail        = document.getElementById("profile-email");
  const avatarDisplay       = document.getElementById("avatar-display");
  const avatarUploadTrigger = document.getElementById("avatar-upload-trigger");
  const avatarFileInput     = document.getElementById("avatar-file-input") as HTMLInputElement | null;

  async function loadUserProfile() {
    if (!jwt) return;
    try {
      const res = await fetch(`${STRAPI_URL}/api/users/me?populate=avatar`, {
        headers: { Authorization: `Bearer ${jwt}` },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const user = await res.json();

      if (profileUsername) {
        profileUsername.textContent = user.username || user.firstName || "Usuario";
      }
      if (profileEmail) {
        profileEmail.textContent = user.email || "";
      }

      const avatarUrl = user.avatar?.url;
      if (avatarUrl && avatarDisplay) {
        const fullUrl = avatarUrl.startsWith("http")
          ? avatarUrl
          : `${STRAPI_URL}${avatarUrl}`;
        avatarDisplay.innerHTML = `<img
          src="${fullUrl}"
          alt="Avatar de ${user.username}"
          class="w-full h-full object-cover rounded-full"
        />`;
      }
    } catch (err) {
      console.error("[perfil] loadUserProfile error:", err);
    }
  }

  // ── 3. Avatar upload ─────────────────────────────────────────────────────────
  avatarUploadTrigger?.addEventListener("click", () => {
    avatarFileInput?.click();
  });

  avatarFileInput?.addEventListener("change", async () => {
    const file = avatarFileInput?.files?.[0];
    if (!file || !jwt) return;

    // Preview immediately
    const reader = new FileReader();
    reader.onload = (e) => {
      if (avatarDisplay && e.target?.result) {
        avatarDisplay.innerHTML = `<img
          src="${e.target.result}"
          alt="Avatar preview"
          class="w-full h-full object-cover rounded-full"
        />`;
      }
    };
    reader.readAsDataURL(file);

    // Upload to Strapi
    try {
      const userId = localStorage.getItem("userId");
      const formData = new FormData();
      formData.append("files", file);
      formData.append("ref", "plugin::users-permissions.user");
      if (userId) formData.append("refId", userId);
      formData.append("field", "avatar");

      const uploadRes = await fetch(`${STRAPI_URL}/api/upload`, {
        method: "POST",
        headers: { Authorization: `Bearer ${jwt}` },
        body: formData,
      });

      if (!uploadRes.ok) throw new Error("Upload failed");

      const uploadData = await uploadRes.json();
      if (uploadData?.[0]?.url && avatarDisplay) {
        const newUrl = uploadData[0].url.startsWith("http")
          ? uploadData[0].url
          : `${STRAPI_URL}${uploadData[0].url}`;
        avatarDisplay.innerHTML = `<img
          src="${newUrl}"
          alt="Avatar actualizado"
          class="w-full h-full object-cover rounded-full"
        />`;
      }
    } catch (error) {
      console.error("[perfil] Error uploading avatar:", error);
    }
  });

  // ── Init ─────────────────────────────────────────────────────────────────────
  if (jwt) {
    loadUserProfile();
  }
</script>
