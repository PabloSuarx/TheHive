---
import Layout from "../layouts/Layout.astro";
import ProfileHero from "../components/profile/ProfileHero.astro";
import OrdersList from "../components/profile/OrdersList.astro";
import { get } from "../lib/strapi";

const perfilPageData = await get("perfil-page", { populate: "*" });

const fallbackData = {
  avatarUploadAriaLabel: "Cambiar foto de perfil",
  avatarCameraIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-camera" viewBox="0 0 16 16"><path d="M15 12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1.172a3 3 0 0 0 2.12-.879l.83-.828A1 1 0 0 1 6.827 3h2.344a1 1 0 0 1 .707.293l.828.828A3 3 0 0 0 12.828 5H14a1 1 0 0 1 1 1zM2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4z"/><path d="M8 11a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5m0 1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M3 6.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0"/></svg>`,
  loadingText: "Cargando...",
  ordersTitle: "Mis Pedidos",
  ordersLoadingText: "Cargando tus pedidos...",
  ordersErrorText: "Error al cargar los pedidos.",
  ordersRetryButtonText: "Reintentar",
  ordersEmptyText: "Aún no tienes pedidos",
  ordersEmptyIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="orders-list__state-icon" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.34zm-14 0v7.94l6.5 2.34V6.24z"/></svg>`,
  ordersErrorIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="orders-list__state-icon" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/></svg>`,
  errorMessageExpiredSession: "Tu sesión ha expirado. Vuelve a iniciar sesión.",
  errorMessageDefault: "Error al cargar los pedidos. Inténtalo de nuevo.",
  orderLabelText: "Pedido",
  orderStatusProcessing: "Procesando",
  orderStatusConfirmed: "Confirmado",
  orderStatusShipped: "Enviado",
  orderStatusDelivered: "Entregado",
  orderStatusCancelled: "Cancelado",
  orderIconClock: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/></svg>`,
  orderIconCheck: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/></svg>`,
  orderIconTruck: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456M12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/></svg>`,
  orderIconX: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/></svg>`,
  orderIconBox: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" style="opacity:0.55;flex-shrink:0"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.34zm-14 0v7.94l6.5 2.34V6.24z"/></svg>`,
};

const { metaTitle, metaDescription, keywords} = perfilPageData.seo;

const pageData = { ...fallbackData, ...perfilPageData };

const {
  avatarUploadAriaLabel,
  avatarCameraIcon,
  loadingText,
  ordersTitle,
  ordersLoadingText,
  ordersErrorText,
  ordersRetryButtonText,
  ordersEmptyText,
  ordersEmptyIcon,
  ordersErrorIcon,
  errorMessageExpiredSession,
  errorMessageDefault,
  orderLabelText,
  orderStatusProcessing,
  orderStatusConfirmed,
  orderStatusShipped,
  orderStatusDelivered,
  orderStatusCancelled,
  orderIconClock,
  orderIconCheck,
  orderIconTruck,
  orderIconX,
  orderIconBox,
} = pageData;
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  keywords={keywords}
>
  <ProfileHero
    avatarUploadAriaLabel={avatarUploadAriaLabel}
    avatarCameraIcon={avatarCameraIcon}
    loadingText={loadingText}
  />
  <OrdersList
    ordersTitle={ordersTitle}
    ordersLoadingText={ordersLoadingText}
    ordersErrorText={ordersErrorText}
    ordersRetryButtonText={ordersRetryButtonText}
    ordersEmptyText={ordersEmptyText}
    ordersEmptyIcon={ordersEmptyIcon}
    ordersErrorIcon={ordersErrorIcon}
    errorMessageExpiredSession={errorMessageExpiredSession}
    errorMessageDefault={errorMessageDefault}
    orderLabelText={orderLabelText}
    orderStatusProcessing={orderStatusProcessing}
    orderStatusConfirmed={orderStatusConfirmed}
    orderStatusShipped={orderStatusShipped}
    orderStatusDelivered={orderStatusDelivered}
    orderStatusCancelled={orderStatusCancelled}
    orderIconClock={orderIconClock}
    orderIconCheck={orderIconCheck}
    orderIconTruck={orderIconTruck}
    orderIconX={orderIconX}
    orderIconBox={orderIconBox}
  />
</Layout>

<script>
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // ── 1. Auth guard ────────────────────────────────────────────────────────────
  const jwt = localStorage.getItem("jwt");
  if (!jwt) {
    window.location.replace("/login");
  }

  // ── 2. Load user data from /api/users/me and populate DOM ───────────────────
  const profileUsername     = document.getElementById("profile-username");
  const profileEmail        = document.getElementById("profile-email");
  const avatarDisplay       = document.getElementById("avatar-display");
  const avatarUploadTrigger = document.getElementById("avatar-upload-trigger");
  const avatarFileInput     = document.getElementById("avatar-file-input") as HTMLInputElement | null;

  async function loadUserProfile() {
    if (!jwt) return;
    try {
      const res = await fetch(`${STRAPI_URL}/api/users/me?populate=avatar`, {
        headers: { Authorization: `Bearer ${jwt}` },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const user = await res.json();
      console.log("[avatar] user avatar tras reload:", user.avatar);

      if (profileUsername) {
        profileUsername.textContent = user.username || user.firstName || "Usuario";
      }
      if (profileEmail) {
        profileEmail.textContent = user.email || "";
      }

      if (avatarDisplay) {
        const avatarUrl = user.avatar?.url;
        if (avatarUrl) {
          const fullUrl = avatarUrl.startsWith("http")
            ? avatarUrl
            : `${STRAPI_URL}${avatarUrl}`;
          avatarDisplay.innerHTML = `<img
            src="${fullUrl}"
            alt="Avatar de ${user.username}"
            class="w-full h-full object-cover rounded-full"
          />`;
        }
      }
    } catch (err) {
      console.error("[perfil] loadUserProfile error:", err);
    }
  }

  // ── 3. Avatar upload ─────────────────────────────────────────────────────────
  avatarUploadTrigger?.addEventListener("click", () => {
    avatarFileInput?.click();
  });

  avatarFileInput?.addEventListener("change", async () => {
    const file = avatarFileInput?.files?.[0];
    if (!file || !jwt) return;

    // Preview immediately
    const reader = new FileReader();
    reader.onload = (e) => {
      if (avatarDisplay && e.target?.result) {
        avatarDisplay.innerHTML = `<img
          src="${e.target.result}"
          alt="Avatar preview"
          class="w-full h-full object-cover rounded-full"
        />`;
      }
    };
    reader.readAsDataURL(file);

    // Upload via API endpoint
    try {
      const fd = new FormData();
      fd.append("file", file);
      fd.append("jwt", jwt);
      fd.append("userId", localStorage.getItem("userId") ?? "");

      const uploadRes = await fetch("/api/upload-avatar", {
        method: "POST",
        body: fd,
      });

      if (!uploadRes.ok) throw new Error("Upload failed");

      const { avatarUrl } = await uploadRes.json();
      console.log("[avatar] upload response:", avatarUrl);

      // Guardar en localStorage para el nav
      if (avatarUrl) {
        const fullUrl = avatarUrl.startsWith("http")
          ? avatarUrl
          : `${STRAPI_URL}${avatarUrl}`;
        localStorage.setItem("userAvatar", fullUrl);

        // Disparar evento para actualizar el nav
        window.dispatchEvent(new CustomEvent("avatar-updated", { detail: { url: fullUrl } }));
      }

      // Recargar perfil desde Strapi para confirmar que se guardó
      await loadUserProfile();
    } catch (error) {
      console.error("[perfil] Error uploading avatar:", error);
    }
  });

  // ── Init ─────────────────────────────────────────────────────────────────────
  if (jwt) {
    loadUserProfile();
  }
</script>
