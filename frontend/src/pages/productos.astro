---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/features/product/ProductCard.astro"
import type { Product } from "../types/product";
import { get } from "../lib/strapi";
import ProductHeroSection from "../components/features/product/ProductHeroSection.astro"
import ProductSearchSection from "../components/features/product/ProductSearchSection.astro"
import ProductLoadingSkeletonSection from "../components/features/product/ProductLoadingSkeletonSection.astro"
import ProductGridSection from "../components/features/product/ProductGridSection.astro"
import Pagination from "../components/ui/Pagination.astro";


const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const products =
  (await get("products", {
    populate: {
      mainImage: true,
      category: true,
      tags: true,
      reviews: true,
      beekeeper: true,
    },
  })) || [];
const categories = (await get("categories")) || [];

// Fetch page content from Strapi
const productosPageData = await get("productos-page", { populate: "*" });

// Fallback data con contenido actual hardcodeado
const fallbackData = {
  breadcrumbsSeparator: "/",
  breadcrumbsHomeLabel: "Inicio",
  heroTitle: "Nuestros Productos",
  heroDescription: "Descubre nuestra selección de mieles artesanales 100% naturales, recolectadas con pasión y respeto por la naturaleza.",
  searchIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-text-tertiary" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/></svg>`,
  searchPlaceholder: "Buscar productos... (ej: azahar, romero, ecológico)",
  clearSearchIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg w-4 h-4" viewBox="0 0 16 16"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/></svg>`,
  clearSearchAriaLabel: "Limpiar búsqueda",
  filterAllLabel: "Todas",
  sortLabel: "Ordenar:",
  sortOptions: [
    { label: "Destacados", value: "featured" },
    { label: "Nombre A-Z", value: "name-asc" },
    { label: "Nombre Z-A", value: "name-desc" },
    { label: "Precio ↑", value: "price-asc" },
    { label: "Precio ↓", value: "price-desc" }
  ],
  emptyStateIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-inbox mx-auto mb-4 text-text-tertiary" viewBox="0 0 16 16"><path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm-1.17-.437A1.5 1.5 0 0 1 4.98 3h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .106.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374z"/></svg>`,
  emptyStateTitle: "No se encontraron productos",
  emptyStateDescription: "Prueba con otro término de búsqueda o cambia los filtros para ver más resultados.",
  resultsCountEmpty: "Sin resultados",
  resultsCountTemplate: "Mostrando {start}–{end} de {total} productos",
  paginationPrevAriaLabel: "Página anterior",
  paginationNextAriaLabel: "Página siguiente",
  paginationNavAriaLabel: "Navegación de páginas",
  paginationShowLabel: "Mostrar:",
  paginationChevronLeftIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>`,
  paginationChevronRightIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>`,
};

// Merge con fallback
const pageData = { ...fallbackData, ...productosPageData };

// Desestructuración al 100%
const {
  breadcrumbsSeparator,
  breadcrumbsHomeLabel,
  heroTitle,
  heroDescription,
  searchIcon,
  searchPlaceholder,
  clearSearchIcon,
  clearSearchAriaLabel,
  filterAllLabel,
  sortLabel,
  sortOptions,
  emptyStateIcon,
  emptyStateTitle,
  emptyStateDescription,
  resultsCountEmpty,
  resultsCountTemplate,
  paginationPrevAriaLabel,
  paginationNextAriaLabel,
  paginationNavAriaLabel,
  paginationShowLabel,
  paginationChevronLeftIcon,
  paginationChevronRightIcon,
} = pageData;
---

<Layout
  titulo="Productos"
  descripcion="Descubre nuestra selección completa de mieles artesanales. Miel monoflora, multiflora, premium y más. 100% natural, directamente de la colmena."
  keywords="comprar miel, miel artesanal, miel natural, tienda miel, miel online, miel premium"
>
  <!-- Hero -->
  <section class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <ProductHeroSection
      breadcrumbsSeparator={breadcrumbsSeparator}
      breadcrumbsHomeLabel={breadcrumbsHomeLabel}
      heroTitle={heroTitle}
      heroDescription={heroDescription}
    />
  </section>

  <!-- Controles: Buscador + Filtros + Orden -->
  <section class="py-6 bg-linear-to-b from-primary-pale to-bg-primary  z-30">
    <ProductSearchSection
      categories={categories}
      searchIcon={searchIcon}
      searchPlaceholder={searchPlaceholder}
      clearSearchIcon={clearSearchIcon}
      clearSearchAriaLabel={clearSearchAriaLabel}
      filterAllLabel={filterAllLabel}
      sortLabel={sortLabel}
      sortOptions={sortOptions}
      resultsCountEmpty={resultsCountEmpty}
    />
  </section>

  <!-- Loading skeleton -->
  <section id="loading-skeleton" class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <ProductLoadingSkeletonSection />
  </section>

  <!-- Grid de productos -->
  <section
    id="products-section"
    class="py-12 bg-linear-to-b from-bg-primary to-primary-pale hidden"
    data-results-count-empty={resultsCountEmpty}
    data-results-count-template={resultsCountTemplate}
  >
    <ProductGridSection
      products={products}
      emptyStateIcon={emptyStateIcon}
      emptyStateTitle={emptyStateTitle}
      emptyStateDescription={emptyStateDescription}
    />

    <!-- Paginación -->
    <nav class="flex justify-center items-center gap-2 mt-12">
      <Pagination
        defaultPageSize={8}
        pageSizeOptions={[8, 16, 24, 48]}
        paginationPrevAriaLabel={paginationPrevAriaLabel}
        paginationNextAriaLabel={paginationNextAriaLabel}
        paginationNavAriaLabel={paginationNavAriaLabel}
        paginationShowLabel={paginationShowLabel}
        paginationChevronLeftIcon={paginationChevronLeftIcon}
        paginationChevronRightIcon={paginationChevronRightIcon}
      />
    </nav>
  </section>


</Layout>

<script>
  import type { Product } from "../types/product";

  document.addEventListener("DOMContentLoaded", () => {
    let ITEMS_PER_PAGE = 8;
    let currentPage = 1;
    let currentCategory = "all";
    let currentSort = "featured";
    let currentSearch = "";

    const searchInput = document.getElementById(
      "product-search"
    ) as HTMLInputElement;
    const clearBtn = document.getElementById("clear-search") as HTMLElement;
    const filterBtns = document.querySelectorAll(".filter-btn");
    const sortSelect = document.getElementById(
      "sort-select"
    ) as HTMLSelectElement;
    const allItems = Array.from(
      document.querySelectorAll(".product-item")
    ) as HTMLElement[];
    const grid = document.getElementById("products-grid") as HTMLElement;
    const noResults = document.getElementById("no-results") as HTMLElement;
    const resultsCount = document.getElementById(
      "results-count"
    ) as HTMLElement;
    const loadingSkeleton = document.getElementById(
      "loading-skeleton"
    ) as HTMLElement;
    const productsSection = document.getElementById(
      "products-section"
    ) as HTMLElement;

    // Get text templates from data attributes
    const resultsCountEmpty = productsSection.dataset.resultsCountEmpty || "Sin resultados";
    const resultsCountTemplate = productsSection.dataset.resultsCountTemplate || "Mostrando {start}–{end} de {total} productos";

    /** Normalización de texto: quita tildes, pasa a minúsculas */
    function normalize(text: string): string {
      return text
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    /** Buscador con expresión regular */
    function matchesSearch(item: HTMLElement, query: string): boolean {
      if (!query) return true;
      const safeQuery = normalize(query).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      try {
        const regex = new RegExp(safeQuery, "i");
        const searchable = [
          item.dataset.name,
          item.dataset.short,
          item.dataset.category,
          item.dataset.organic,
        ]
          .map((s) => normalize(s || ""))
          .join(" ");
        return regex.test(searchable);
      } catch {
        return true;
      }
    }

    /** Filtrar items visibles */
    function getVisibleItems(): HTMLElement[] {
      return allItems.filter((item) => {
        const catMatch =
          currentCategory === "all" ||
          item.dataset.category === currentCategory;
        return catMatch && matchesSearch(item, currentSearch);
      });
    }

    /** Ordenar items */
    function sortItems(items: HTMLElement[]): HTMLElement[] {
      return [...items].sort((a, b) => {
        switch (currentSort) {
          case "name-asc":
            return (a.dataset.name || "").localeCompare(
              b.dataset.name || "",
              "es"
            );
          case "name-desc":
            return (b.dataset.name || "").localeCompare(
              a.dataset.name || "",
              "es"
            );
          case "price-asc":
            return (
              parseFloat(a.dataset.price || "0") -
              parseFloat(b.dataset.price || "0")
            );
          case "price-desc":
            return (
              parseFloat(b.dataset.price || "0") -
              parseFloat(a.dataset.price || "0")
            );
          default:
            return (
              parseInt(b.dataset.featured || "0") -
              parseInt(a.dataset.featured || "0")
            );
        }
      });
    }

    /** Render principal */
    function render() {
      const visible = getVisibleItems();
      const sorted = sortItems(visible);
      const totalPages = Math.ceil(sorted.length / ITEMS_PER_PAGE);
      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      const pageItems = sorted.slice(start, start + ITEMS_PER_PAGE);

      // Clear the grid completely before re-appending to avoid DOM order mismatches
      while (grid.firstChild) {
        grid.removeChild(grid.firstChild);
      }

      // Hide all items first
      allItems.forEach((item) => (item.style.display = "none"));

      // Append only current page items (visible and in correct order)
      pageItems.forEach((item) => {
        item.style.display = "";
        grid.appendChild(item);
      });

      // Append remaining hidden items back to the grid to keep DOM references
      allItems.forEach((item) => {
        if (!pageItems.includes(item)) {
          grid.appendChild(item);
        }
      });

      noResults.classList.toggle("hidden", sorted.length > 0);
      resultsCount.textContent =
        sorted.length === 0
          ? resultsCountEmpty
          : resultsCountTemplate
              .replace("{start}", String(start + 1))
              .replace("{end}", String(Math.min(start + ITEMS_PER_PAGE, sorted.length)))
              .replace("{total}", String(sorted.length));
      
      // Emit update event to pagination component
      document.dispatchEvent(
        new CustomEvent("pagination:update", {
            detail: { 
                totalItems: sorted.length,
                currentPage: currentPage
            }
        })
      );
    }

    // --- Events ---
    let debounce: ReturnType<typeof setTimeout>;
    searchInput.addEventListener("input", () => {
      clearBtn.classList.toggle("hidden", !searchInput.value);
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        currentSearch = searchInput.value.trim();
        currentPage = 1;
        render();
      }, 300);
    });
    
    clearBtn.addEventListener("click", () => {
      searchInput.value = "";
      clearBtn.classList.add("hidden");
      currentSearch = "";
      currentPage = 1;
      render();
      searchInput.focus();
    });

    filterBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove(
            "active",
            "bg-[#F59E0B]",
            "text-white",
            "shadow-md"
          );
          b.classList.add("bg-white", "text-gray-700");
        });
        btn.classList.add("active", "bg-[#F59E0B]", "text-white", "shadow-md");
        btn.classList.remove("bg-white", "text-gray-700");
        currentCategory = btn.getAttribute("data-category") || "all";
        currentPage = 1;
        render();
      })
    );

    sortSelect.addEventListener("change", () => {
      currentSort = sortSelect.value;
      currentPage = 1;
      render();
    });

    // Pagination Events
    document.addEventListener("pagination:page-change", ((e: CustomEvent) => {
        currentPage = e.detail.page;
        render();
        // Scroll to top of products
        productsSection.scrollIntoView({ behavior: "smooth" });
    }) as EventListener);

    document.addEventListener("pagination:size-change", ((e: CustomEvent) => {
        ITEMS_PER_PAGE = e.detail.pageSize;
        currentPage = 1; // Reset to first page
        render();
        productsSection.scrollIntoView({ behavior: "smooth" });
    }) as EventListener);

    // Init: loading → render
    setTimeout(() => {
      loadingSkeleton.classList.add("hidden");
      productsSection.classList.remove("hidden");
      render();
    }, 500);
  });
</script>
