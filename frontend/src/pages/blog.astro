---
/*
 * STRAPI SINGLE TYPE: "BlogPage" → endpoint: "blog-page"
 * Campos:
 * - seo (component shared.seo)
 * - heroTitle, heroDescription
 * - breadcrumbsSeparator, breadcrumbsHomeLabel
 * - searchPlaceholder, searchIcon, clearSearchIcon, clearSearchAriaLabel
 * - filterAllLabel, sortLabel
 * - sortOptions (component blog.sort-option, repeatable)
 * - emptyStateIcon, emptyStateTitle, emptyStateDescription
 * - paginationAriaLabel, resultsCountEmpty, resultsCountTemplate
 */
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/features/blog/BlogCard.astro"
import BlogHeroSection from "../components/features/blog/BlogHeroSection.astro"
import BlogSearchSection from "../components/features/blog/BlogSearchSection.astro"
import BlogGridSection from "../components/features/blog/BlogGridSection.astro"
import BlogLoadingSkeleton from "../components/features/blog/BlogLoadingSkeleton.astro"
import { get } from "../lib/strapi";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const blogs =
  (await get("blogs", {
    populate: {
      featuredImage: true,
      blog_category: true,
      tags: true,
    },
    sort: { blogPublishedAt: "desc" },
  })) || [];
const blogCategories = (await get("blog-categories")) || [];

// Fetch Blog Page content from Strapi
const blogPageData = await get("blog-page", { populate: "*" });

// Fallback data con contenido actual hardcodeado
const fallbackData = {
  heroTitle: "Nuestro Blog",
  heroDescription: "Lee nuestros artículos sobre miel artesanal, recetas, beneficios para la salud, sostenibilidad y el mundo de la apicultura.",
  breadcrumbsSeparator: "/",
  breadcrumbsHomeLabel: "Inicio",
  searchPlaceholder: "Buscar artículos... (ej: recetas, beneficios, apicultura)",
  searchIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/></svg>`,
  clearSearchIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/></svg>`,
  clearSearchAriaLabel: "Limpiar búsqueda",
  filterAllLabel: "Todos",
  sortLabel: "Ordenar:",
  sortOptions: [
    { label: "Más recientes", value: "date-desc" },
    { label: "Más antiguos", value: "date-asc" },
    { label: "Título A-Z", value: "title-asc" },
    { label: "Título Z-A", value: "title-desc" }
  ],
  emptyStateIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-inbox" viewBox="0 0 16 16"><path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a.5.5 0 0 1 .105.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374z"/></svg>`,
  emptyStateTitle: "No se encontraron artículos",
  emptyStateDescription: "Prueba con otro término de búsqueda o cambia los filtros",
  paginationAriaLabel: "Paginación del blog",
  resultsCountEmpty: "Sin resultados",
  resultsCountTemplate: "Mostrando {start}–{end} de {total} artículos"
};

const pageData = { ...fallbackData, ...blogPageData };

const {
  heroTitle,
  heroDescription,
  breadcrumbsSeparator,
  breadcrumbsHomeLabel,
  searchPlaceholder,
  searchIcon,
  clearSearchIcon,
  clearSearchAriaLabel,
  filterAllLabel,
  sortLabel,
  sortOptions,
  emptyStateIcon,
  emptyStateTitle,
  emptyStateDescription,
  paginationAriaLabel,
  resultsCountEmpty,
  resultsCountTemplate
} = pageData;
---

<Layout
  titulo="Blog"
  descripcion="Lee nuestros artículos sobre miel artesanal, recetas, beneficios para la salud, sostenibilidad y el mundo de la apicultura."
  keywords="blog miel, recetas miel, beneficios miel, apicultura, miel artesanal blog"
>

  <section class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <BlogHeroSection
      {heroTitle}
      {heroDescription}
      {breadcrumbsSeparator}
      {breadcrumbsHomeLabel}
    />
  </section>

  <section class="py-12 bg-linear-to-b from-primary-pale to-bg-primary">
    <BlogSearchSection
      {blogCategories}
      {searchPlaceholder}
      {searchIcon}
      {clearSearchIcon}
      {clearSearchAriaLabel}
      {filterAllLabel}
      {sortLabel}
      {sortOptions}
    />
  </section>

  <section id="blog-loading" class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <BlogLoadingSkeleton />
  </section>

  <section id="blog-section" class="py-12 bg-linear-to-b from-bg-primary to-primary-pale">
    <BlogGridSection
      {blogs}
      {emptyStateIcon}
      {emptyStateTitle}
      {emptyStateDescription}
      {paginationAriaLabel}
    />
  </section>
</Layout>

<script define:vars={{ resultsCountEmpty, resultsCountTemplate }}>
  document.addEventListener("DOMContentLoaded", () => {
    const PER_PAGE = 6;
    let page = 1,
      category = "all",
      sort = "date-desc",
      search = "";

    const searchInput = document.getElementById(
      "blog-search"
    );
    const clearBtn = document.getElementById("clear-search");
    const filterBtns = document.querySelectorAll(".filter-btn");
    const sortSelect = document.getElementById("blog-sort");
    const allItems = Array.from(
      document.querySelectorAll(".blog-item")
    );
    const grid = document.getElementById("blog-grid");
    const paginationEl = document.getElementById(
      "blog-pagination"
    );
    const noResults = document.getElementById("blog-no-results");
    const countEl = document.getElementById(
      "blog-results-count"
    );
    const loading = document.getElementById("blog-loading");
    const section = document.getElementById("blog-section");

    function normalize(t) {
      return t
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function matches(item, q) {
      if (!q) return true;
      const safe = normalize(q).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      try {
        const re = new RegExp(safe, "i");
        const text = [
          item.dataset.title,
          item.dataset.excerpt,
          item.dataset.author,
          item.dataset.category,
        ]
          .map((s) => normalize(s || ""))
          .join(" ");
        return re.test(text);
      } catch {
        return true;
      }
    }

    function getVisible() {
      return allItems.filter(
        (i) =>
          (category === "all" || i.dataset.category === category) &&
          matches(i, search)
      );
    }

    function sortItems(items) {
      return [...items].sort((a, b) => {
        switch (sort) {
          case "date-asc":
            return (a.dataset.date || "").localeCompare(b.dataset.date || "");
          case "title-asc":
            return (a.dataset.title || "").localeCompare(
              b.dataset.title || "",
              "es"
            );
          case "title-desc":
            return (b.dataset.title || "").localeCompare(
              a.dataset.title || "",
              "es"
            );
          default:
            return (b.dataset.date || "").localeCompare(a.dataset.date || "");
        }
      });
    }

    function renderPagination(total) {
      const pages = Math.ceil(total / PER_PAGE);
      paginationEl.innerHTML = "";
      if (pages <= 1) return;

      const btn = (html, p, dis, act) => {
        const b = document.createElement("button");
        b.innerHTML = html;
        b.disabled = dis;
        b.className = act
          ? "w-10 h-10 rounded-lg text-sm font-bold bg-[#F59E0B] text-white shadow-md"
          : dis
          ? "px-4 py-2 rounded-lg text-sm bg-gray-100 text-gray-400 cursor-not-allowed"
          : "px-4 py-2 rounded-lg text-sm bg-white text-gray-700 hover:bg-[#FEF3C7] border border-gray-200";
        if (!dis && !act)
          b.addEventListener("click", () => {
            page = p;
            render();
          });
        return b;
      };

      paginationEl.appendChild(btn("&larr;", page - 1, page === 1, false));
      for (let i = 1; i <= pages; i++) {
        if (pages > 7 && i > 2 && i < pages - 1 && Math.abs(i - page) > 1) {
          if (i === 3 || i === pages - 2) {
            const d = document.createElement("span");
            d.textContent = "…";
            d.className = "px-2 text-gray-400";
            paginationEl.appendChild(d);
          }
          continue;
        }
        paginationEl.appendChild(btn(String(i), i, false, i === page));
      }
      paginationEl.appendChild(btn("&rarr;", page + 1, page === pages, false));
    }

    function render() {
      const visible = sortItems(getVisible());
      const pages = Math.ceil(visible.length / PER_PAGE);
      if (page > pages) page = Math.max(1, pages);
      const start = (page - 1) * PER_PAGE;
      const items = visible.slice(start, start + PER_PAGE);

      allItems.forEach((i) => (i.style.display = "none"));
      items.forEach((i) => {
        i.style.display = "";
        grid.appendChild(i);
      });

      noResults.classList.toggle("hidden", visible.length > 0);
      countEl.textContent =
        visible.length === 0
          ? resultsCountEmpty
          : resultsCountTemplate
              .replace("{start}", String(start + 1))
              .replace("{end}", String(Math.min(start + PER_PAGE, visible.length)))
              .replace("{total}", String(visible.length));
      renderPagination(visible.length);
    }

    let debounce;
    searchInput.addEventListener("input", () => {
      clearBtn.classList.toggle("hidden", !searchInput.value);
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        search = searchInput.value.trim();
        page = 1;
        render();
      }, 300);
    });
    clearBtn.addEventListener("click", () => {
      searchInput.value = "";
      clearBtn.classList.add("hidden");
      search = "";
      page = 1;
      render();
      searchInput.focus();
    });
    filterBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove(
            "active",
            "bg-[#F59E0B]",
            "text-white",
            "shadow-md"
          );
          b.classList.add("bg-white", "text-gray-700");
        });
        btn.classList.add("active", "bg-[#F59E0B]", "text-white", "shadow-md");
        btn.classList.remove("bg-white", "text-gray-700");
        category = btn.getAttribute("data-category") || "all";
        page = 1;
        render();
      })
    );
    sortSelect.addEventListener("change", () => {
      sort = sortSelect.value;
      page = 1;
      render();
    });

    setTimeout(() => {
      loading.classList.add("hidden");
      section.classList.remove("hidden");
      render();
    }, 500);
  });
</script>
