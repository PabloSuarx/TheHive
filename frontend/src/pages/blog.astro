---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { get } from "../lib/strapi";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

const blogs =
  (await get("blogs", {
    populate: {
      featuredImage: true,
      blog_category: true,
      tags: true,
    },
    sort: { blogPublishedAt: "desc" },
  })) || [];
const blogCategories = (await get("blog-categories")) || [];
---

<Layout
  titulo="Blog"
  descripcion="Lee nuestros artículos sobre miel artesanal, recetas, beneficios para la salud, sostenibilidad y el mundo de la apicultura."
  keywords="blog miel, recetas miel, beneficios miel, apicultura, miel artesanal blog"
>


  <!-- Hero -->
  <section class="py-12 bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 lg:px-8">
      <Breadcrumbs class="text-gray-500 font-medium mb-4" separator="/" homeLabel="Inicio" />
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Nuestro Blog</h1>
      <p class="text-lg text-gray-600 max-w-2xl">
        Lee nuestros artículos sobre miel artesanal, recetas, beneficios para la salud, sostenibilidad y el mundo de la apicultura.
      </p>
    </div>
  </section>

  <!-- Controles: Buscador + Filtros -->
  <section class="py-6 bg-gray-50 border-b border-gray-200 sticky top-0 z-30">
    <div class="container mx-auto px-4 lg:px-8">

      <!-- Buscador -->
      <div class="max-w-xl mx-auto mb-5 relative">
        <svg
          class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="blog-search"
          placeholder="Buscar artículos... (ej: recetas, beneficios, apicultura)"
          class="w-full pl-12 pr-10 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-[#F59E0B] focus:outline-none focus:ring-2 focus:ring-[#F59E0B]/20 transition-colors"
          autocomplete="off"
        />
        <button
          id="clear-search"
          class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 hidden"
          aria-label="Limpiar búsqueda"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="flex flex-wrap justify-between items-center gap-4">
        <!-- Filtros categoría -->
        <div class="flex flex-wrap gap-2" id="blog-filters">
          <button
            class="filter-btn active px-4 py-2 rounded-full text-sm font-medium transition-all bg-[#F59E0B] text-white shadow-md"
            data-category="all">Todos</button
          >
          {
            blogCategories.map((cat) => (
              <button
                class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white text-gray-700 hover:bg-[#FEF3C7] hover:text-[#D97706] border border-gray-200"
                data-category={cat.slug}
              >
                {cat.icon && <span class="mr-1">{cat.icon}</span>}
                {cat.name}
              </button>
            ))
          }
        </div>

        <!-- Ordenación -->
        <div class="flex items-center gap-2">
          <label for="blog-sort" class="text-sm text-gray-500 whitespace-nowrap"
            >Ordenar:</label
          >
          <select
            id="blog-sort"
            class="px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm focus:border-[#F59E0B] focus:outline-none"
          >
            <option value="date-desc">Más recientes</option>
            <option value="date-asc">Más antiguos</option>
            <option value="title-asc">Título A-Z</option>
            <option value="title-desc">Título Z-A</option>
          </select>
        </div>
      </div>

      <p class="text-sm text-gray-500 mt-4" id="blog-results-count"></p>
    </div>
  </section>

  <!-- Loading skeleton -->
  <section id="blog-loading" class="py-12 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          [...Array(6)].map(() => (
            <div class="animate-pulse">
              <div class="h-48 bg-gray-200 rounded-xl mb-4" />
              <div class="h-3 bg-gray-200 rounded w-1/4 mb-2" />
              <div class="h-5 bg-gray-200 rounded w-3/4 mb-2" />
              <div class="h-3 bg-gray-200 rounded w-full mb-2" />
              <div class="h-3 bg-gray-200 rounded w-1/2" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Grid de artículos -->
  <section id="blog-section" class="py-12 bg-white hidden">
    <div class="container mx-auto px-4 lg:px-8">
      <div id="blog-no-results" class="text-center py-16 hidden">
        <span class="text-6xl mb-4 block">🔍</span>
        <p class="text-gray-500 text-lg mb-2">No se encontraron artículos</p>
        <p class="text-gray-400 text-sm">
          Prueba con otro término de búsqueda o cambia los filtros
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
        {
          blogs.map((blog) => {
            const imgUrl = blog.featuredImage?.url
              ? `${PUBLIC_STRAPI_URL}${blog.featuredImage.url}`
              : undefined;

            return (
              <div
                class="blog-item"
                data-category={blog.blog_category?.slug || "sin-categoria"}
                data-title={blog.title}
                data-excerpt={blog.excerpt || ""}
                data-author={blog.author || ""}
                data-date={blog.blogPublishedAt || ""}
              >
                <BlogCard
                  title={blog.title}
                  slug={blog.slug}
                  excerpt={blog.excerpt}
                  imageUrl={imgUrl}
                  author={blog.author}
                  blogPublishedAt={blog.blogPublishedAt}
                  categoryName={blog.blog_category?.name}
                  categorySlug={blog.blog_category?.slug}
                />
              </div>
            );
          })
        }
      </div>

      <nav
        id="blog-pagination"
        class="flex justify-center items-center gap-2 mt-12"
        aria-label="Paginación del blog"
      >
      </nav>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const PER_PAGE = 6;
    let page = 1,
      category = "all",
      sort = "date-desc",
      search = "";

    const searchInput = document.getElementById(
      "blog-search"
    ) as HTMLInputElement;
    const clearBtn = document.getElementById("clear-search") as HTMLElement;
    const filterBtns = document.querySelectorAll(".filter-btn");
    const sortSelect = document.getElementById(
      "blog-sort"
    ) as HTMLSelectElement;
    const allItems = Array.from(
      document.querySelectorAll(".blog-item")
    ) as HTMLElement[];
    const grid = document.getElementById("blog-grid") as HTMLElement;
    const paginationEl = document.getElementById(
      "blog-pagination"
    ) as HTMLElement;
    const noResults = document.getElementById("blog-no-results") as HTMLElement;
    const countEl = document.getElementById(
      "blog-results-count"
    ) as HTMLElement;
    const loading = document.getElementById("blog-loading") as HTMLElement;
    const section = document.getElementById("blog-section") as HTMLElement;

    function normalize(t: string): string {
      return t
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function matches(item: HTMLElement, q: string): boolean {
      if (!q) return true;
      const safe = normalize(q).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      try {
        const re = new RegExp(safe, "i");
        const text = [
          item.dataset.title,
          item.dataset.excerpt,
          item.dataset.author,
          item.dataset.category,
        ]
          .map((s) => normalize(s || ""))
          .join(" ");
        return re.test(text);
      } catch {
        return true;
      }
    }

    function getVisible(): HTMLElement[] {
      return allItems.filter(
        (i) =>
          (category === "all" || i.dataset.category === category) &&
          matches(i, search)
      );
    }

    function sortItems(items: HTMLElement[]): HTMLElement[] {
      return [...items].sort((a, b) => {
        switch (sort) {
          case "date-asc":
            return (a.dataset.date || "").localeCompare(b.dataset.date || "");
          case "title-asc":
            return (a.dataset.title || "").localeCompare(
              b.dataset.title || "",
              "es"
            );
          case "title-desc":
            return (b.dataset.title || "").localeCompare(
              a.dataset.title || "",
              "es"
            );
          default:
            return (b.dataset.date || "").localeCompare(a.dataset.date || "");
        }
      });
    }

    function renderPagination(total: number) {
      const pages = Math.ceil(total / PER_PAGE);
      paginationEl.innerHTML = "";
      if (pages <= 1) return;

      const btn = (html: string, p: number, dis: boolean, act: boolean) => {
        const b = document.createElement("button");
        b.innerHTML = html;
        b.disabled = dis;
        b.className = act
          ? "w-10 h-10 rounded-lg text-sm font-bold bg-[#F59E0B] text-white shadow-md"
          : dis
          ? "px-4 py-2 rounded-lg text-sm bg-gray-100 text-gray-400 cursor-not-allowed"
          : "px-4 py-2 rounded-lg text-sm bg-white text-gray-700 hover:bg-[#FEF3C7] border border-gray-200";
        if (!dis && !act)
          b.addEventListener("click", () => {
            page = p;
            render();
          });
        return b;
      };

      paginationEl.appendChild(btn("&larr;", page - 1, page === 1, false));
      for (let i = 1; i <= pages; i++) {
        if (pages > 7 && i > 2 && i < pages - 1 && Math.abs(i - page) > 1) {
          if (i === 3 || i === pages - 2) {
            const d = document.createElement("span");
            d.textContent = "…";
            d.className = "px-2 text-gray-400";
            paginationEl.appendChild(d);
          }
          continue;
        }
        paginationEl.appendChild(btn(String(i), i, false, i === page));
      }
      paginationEl.appendChild(btn("&rarr;", page + 1, page === pages, false));
    }

    function render() {
      const visible = sortItems(getVisible());
      const pages = Math.ceil(visible.length / PER_PAGE);
      if (page > pages) page = Math.max(1, pages);
      const start = (page - 1) * PER_PAGE;
      const items = visible.slice(start, start + PER_PAGE);

      allItems.forEach((i) => (i.style.display = "none"));
      items.forEach((i) => {
        i.style.display = "";
        grid.appendChild(i);
      });

      noResults.classList.toggle("hidden", visible.length > 0);
      countEl.textContent =
        visible.length === 0
          ? "Sin resultados"
          : `Mostrando ${start + 1}–${Math.min(
              start + PER_PAGE,
              visible.length
            )} de ${visible.length} artículos`;
      renderPagination(visible.length);
    }

    let debounce: ReturnType<typeof setTimeout>;
    searchInput.addEventListener("input", () => {
      clearBtn.classList.toggle("hidden", !searchInput.value);
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        search = searchInput.value.trim();
        page = 1;
        render();
      }, 300);
    });
    clearBtn.addEventListener("click", () => {
      searchInput.value = "";
      clearBtn.classList.add("hidden");
      search = "";
      page = 1;
      render();
      searchInput.focus();
    });
    filterBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove(
            "active",
            "bg-[#F59E0B]",
            "text-white",
            "shadow-md"
          );
          b.classList.add("bg-white", "text-gray-700");
        });
        btn.classList.add("active", "bg-[#F59E0B]", "text-white", "shadow-md");
        btn.classList.remove("bg-white", "text-gray-700");
        category = btn.getAttribute("data-category") || "all";
        page = 1;
        render();
      })
    );
    sortSelect.addEventListener("change", () => {
      sort = sortSelect.value;
      page = 1;
      render();
    });

    setTimeout(() => {
      loading.classList.add("hidden");
      section.classList.remove("hidden");
      render();
    }, 500);
  });
</script>

<style>
  .hexagon {
    position: absolute;
    width: 100px;
    height: 57.74px;
    background-color: rgba(245, 158, 11, 0.05);
    margin: 28.87px 0;
  }
  .hexagon:before,
  .hexagon:after {
    content: "";
    position: absolute;
    width: 0;
    border-left: 50px solid transparent;
    border-right: 50px solid transparent;
  }
  .hexagon:before {
    bottom: 100%;
    border-bottom: 28.87px solid rgba(245, 158, 11, 0.05);
  }
  .hexagon:after {
    top: 100%;
    border-top: 28.87px solid rgba(245, 158, 11, 0.05);
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.3;
    }
    50% {
      transform: translateY(-30px) rotate(180deg);
      opacity: 0.1;
    }
  }
  .hex-1 {
    top: 10%;
    left: 5%;
    animation: float 25s infinite ease-in-out;
  }
  .hex-2 {
    top: 60%;
    left: 80%;
    animation: float 20s infinite ease-in-out 2s;
  }
  .hex-3 {
    top: 30%;
    right: 10%;
    animation: float 22s infinite ease-in-out 4s;
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
