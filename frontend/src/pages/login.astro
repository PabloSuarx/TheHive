---
/*
 * STRAPI SINGLE TYPE: "LoginPage" → endpoint: "login-page"
 * Campos:
 * - seo (component)
 * - heroTitle (string)
 * - heroSubtitle (string)
 * - errorIcon (text - SVG)
 * - emailLabel (string)
 * - emailIcon (text - SVG)
 * - emailPlaceholder (string)
 * - passwordLabel (string)
 * - passwordIcon (text - SVG)
 * - passwordPlaceholder (string)
 * - submitButtonText (string)
 * - noAccountText (string)
 * - registerLinkText (string)
 * - registerLinkHref (string)
 * - errorMessageDefault (string)
 * - errorMessageConnection (string)
 */

import Layout from "../layouts/Layout.astro";
import CustomLoader from "../components/ui/CustomLoader.astro";
import { $user } from "../stores/appStore";
import { get } from "../lib/strapi";

const siteConfig = {
  siteName: "The Hive"
};

// Fetch data from Strapi
const loginPageData = await get("login-page", { populate: "*" });

// Fallback data with current hardcoded content
const fallbackData = {
  heroTitle: "Bienvenido",
  heroSubtitle: "Inicia sesión en tu cuenta",
  errorIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-circle flex-shrink-0" viewBox="0 0 16 16">
  <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
  <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
</svg>`,
  emailLabel: "Correo electrónico",
  emailIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
  <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
</svg>`,
  emailPlaceholder: "tu@email.com",
  passwordLabel: "Contraseña",
  passwordIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16">
  <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
</svg>`,
  passwordPlaceholder: "••••••••",
  submitButtonText: "Iniciar Sesión",
  noAccountText: "¿No tienes una cuenta?",
  registerLinkText: "Regístrate",
  registerLinkHref: "/registro",
  errorMessageDefault: "Ha ocurrido un error al iniciar sesión.",
  errorMessageConnection: "Error de conexión. Inténtalo de nuevo."
};

// Merge with fallback
const pageData = { ...fallbackData, ...loginPageData };

// 100% Destructuring
const {
  heroTitle,
  heroSubtitle,
  errorIcon,
  emailLabel,
  emailIcon,
  emailPlaceholder,
  passwordLabel,
  passwordIcon,
  passwordPlaceholder,
  submitButtonText,
  noAccountText,
  registerLinkText,
  registerLinkHref,
  errorMessageDefault,
  errorMessageConnection
} = pageData;
---

<Layout
  titulo="Iniciar Sesión"
  descripcion="Accede a tu cuenta en The Hive"
  siteConfig={siteConfig}
>
  <div class="flex items-center justify-center min-h-[60vh] px-4 py-12">
    <div
      class="w-full max-w-md bg-bg-primary p-8 rounded-2xl border border-border-color"
      data-error-default={errorMessageDefault}
      data-error-connection={errorMessageConnection}
    >
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-primary mb-2">{heroTitle}</h1>
        <p class="text-text-secondary">{heroSubtitle}</p>
      </div>

      <div
        id="error-container"
        class="hidden mb-6 p-4 rounded-lg bg-bg-tertiary border border-error text-error text-sm flex items-center gap-3"
      >
        <span set:html={errorIcon} />
        <span id="error-message"></span>
      </div>

      <form id="login-form" class="space-y-6">
        <div>
          <label
            for="email"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <span set:html={emailIcon} />
            {emailLabel}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={emailPlaceholder}
          />
        </div>

        <div>
          <label
            for="password"
            class="flex items-center gap-2 text-sm font-medium text-text-primary mb-1"
          >
            <span set:html={passwordIcon} />
            {passwordLabel}
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full px-4 py-3 rounded-lg border border-border-color bg-bg-primary text-text-primary focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all disabled:bg-bg-tertiary disabled:cursor-not-allowed"
            placeholder={passwordPlaceholder}
          />
        </div>

        <button
          type="submit"
          id="submit-button"
          class="w-full flex items-center justify-center py-3.5 px-4 rounded-lg bg-primary text-text-inverse font-semibold hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors disabled:opacity-70 disabled:cursor-not-allowed"
        >
          <span id="button-text">{submitButtonText}</span>
          <div id="button-loader" class="hidden ml-2">
           <CustomLoader size={20} color="white" />
          </div>
        </button>
      </form>

      <div class="mt-6 text-center text-sm text-text-secondary">
        {noAccountText} <a
          href={registerLinkHref}
          class="font-medium text-primary hover:text-primary-dark transition-colors"
          >{registerLinkText}</a
        >
      </div>
    </div>
  </div>
</Layout>

<script>
  import { $user } from "../stores/appStore";
  import { syncCartAfterLogin } from "../utils/cartService";

  // Configuration
  const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

  // DOM Elements
  const form = document.getElementById("login-form") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
  const buttonText = document.getElementById("button-text");
  const buttonLoader = document.getElementById("button-loader");
  const errorContainer = document.getElementById("error-container");
  const containerDiv = form?.closest('[data-error-default]') as HTMLElement;

  // Error messages from Strapi
  const errorMessageDefault = containerDiv?.dataset.errorDefault || "Ha ocurrido un error al iniciar sesión.";
  const errorMessageConnection = containerDiv?.dataset.errorConnection || "Error de conexión. Inténtalo de nuevo.";

  // Auth Guard: Redirect if already logged in
  if ($user.get()?.jwt) {
    window.location.assign("/");
  }

  // Helper to show/hide errors
  const showError = (message: string) => {
    const errorMessage = document.getElementById("error-message");
    if (errorContainer && errorMessage) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }
  };

  const hideError = () => {
    const errorMessage = document.getElementById("error-message");
    if (errorContainer && errorMessage) {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }
  };

  // Helper to toggle loading state
  const setLoading = (isLoading: boolean) => {
    if (isLoading) {
      submitButton.disabled = true;
      emailInput.disabled = true;
      passwordInput.disabled = true;
      buttonText?.classList.add("hidden");
      buttonLoader?.classList.remove("hidden");
    } else {
      submitButton.disabled = false;
      emailInput.disabled = false;
      passwordInput.disabled = false;
      buttonText?.classList.remove("hidden");
      buttonLoader?.classList.add("hidden");
    }
  };

  // Login handler
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();
    setLoading(true);

    const identifier = emailInput.value;
    const password = passwordInput.value;

    try {
      const response = await fetch(`${STRAPI_URL}/api/auth/local`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          identifier,
          password,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        // Handle specific Strapi errors
        const errorMessage =
          data?.error?.message || errorMessageDefault;
        throw new Error(errorMessage);
      }

      // Success!
      const { jwt, user: userData } = data;

      // 1. Save JWT, userId and userDocumentId to localStorage
      localStorage.setItem("jwt", jwt);
      localStorage.setItem("userId", String(userData.id));
      localStorage.setItem("userDocumentId", userData.documentId);

      // 2. Sync guest cart → Strapi BEFORE setting user (prevents initCartService from wiping guest items)
      try {
        await syncCartAfterLogin(jwt, userData.documentId);
      } catch (syncErr) {
        console.error("Cart sync failed (non-fatal):", syncErr);
      }

      // 3. Save to Nano Store (persistent) — after sync so cart is preserved
      $user.set({ ...userData, jwt });

      // 4. Redirect to profile
      window.location.replace("/perfil");
      
    } catch (error: any) {
      console.error("Login Error:", error);
      showError(error.message || errorMessageConnection);
      setLoading(false);
      // Logic for failed login: focus password for easy retry
      passwordInput.value = "";
      passwordInput.focus();
    }
  });
</script>
