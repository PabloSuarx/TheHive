---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { get } from "../lib/strapi";

const checkoutPageData = await get("checkout-page", { populate: "*" });

const fallbackData = {
  pageTitle: "Finalizar Pedido",
  addressSectionTitle: "Dirección de envío",
  orderSummaryTitle: "Resumen del pedido",
  shippingCost: 4.99,
  freeShippingThreshold: 50,
  freeShippingText: "Gratis",
  confirmButtonText: "Confirmar Pedido",
  successMessage: "Tu pedido ha sido confirmado con éxito",
  aliasLabel: "Alias",
  streetLabel: "Calle",
  cityLabel: "Ciudad",
  stateLabel: "Provincia",
  countryStateLabel: "Comunidad Autónoma",
  zipCodeLabel: "Código Postal",
  countryLabel: "País",
  notesLabel: "Notas adicionales",
  aliasPlaceholder: "Casa, Trabajo, etc.",
  streetPlaceholder: "Calle Principal, 123",
  cityPlaceholder: "Madrid",
  statePlaceholder: "Madrid",
  countryStatePlaceholder: "Comunidad de Madrid",
  zipCodePlaceholder: "28001",
  countryPlaceholder: "España",
  notesPlaceholder: "Instrucciones de entrega, portero automático, etc.",
  addressIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-geo-alt text-primary" viewBox="0 0 16 16">
    <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
    <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4m0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
  </svg>`,
  summaryIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-receipt text-primary" viewBox="0 0 16 16">
    <path d="M1.92.506a.5.5 0 0 1 .434.14L3 1.293l.646-.647a.5.5 0 0 1 .708 0L5 1.293l.646-.647a.5.5 0 0 1 .708 0L7 1.293l.646-.647a.5.5 0 0 1 .708 0L9 1.293l.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .801.13l.5 1A.5.5 0 0 1 15 2v12a.5.5 0 0 1-.053.224l-.5 1a.5.5 0 0 1-.8.13L13 14.707l-.646.647a.5.5 0 0 1-.708 0L11 14.707l-.646.647a.5.5 0 0 1-.708 0L9 14.707l-.646.647a.5.5 0 0 1-.708 0L7 14.707l-.646.647a.5.5 0 0 1-.708 0L5 14.707l-.646.647a.5.5 0 0 1-.708 0L3 14.707l-.646.647a.5.5 0 0 1-.801-.13l-.5-1A.5.5 0 0 1 1 14V2a.5.5 0 0 1 .053-.224l.5-1a.5.5 0 0 1 .367-.27m.217 1.338L2 2.118v11.764l.137.274.51-.51a.5.5 0 0 1 .707 0l.646.647.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.509.509.137-.274V2.118l-.137-.274-.51.51a.5.5 0 0 1-.707 0L12 1.707l-.646.647a.5.5 0 0 1-.708 0L10 1.707l-.646.647a.5.5 0 0 1-.708 0L8 1.707l-.646.647a.5.5 0 0 1-.708 0L6 1.707l-.646.647a.5.5 0 0 1-.708 0L4 1.707l-.646.647a.5.5 0 0 1-.708 0z"/>
    <path d="M3 4.5a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5m8-6a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5"/>
  </svg>`,
  confirmIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag-check mr-2" viewBox="0 0 16 16">
    <path fill-rule="evenodd" d="M10.854 8.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
    <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
  </svg>`,
  shippingIcon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-truck" viewBox="0 0 16 16">
    <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456M12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
  </svg>`,
  subtotalLabel: "Subtotal",
  shippingLabel: "Envío",
  totalLabel: "Total",
  emptyCartMessage: "Tu carrito está vacío. Añade productos antes de continuar.",
  loadingText: "Procesando...",
  errorMessage: "Ha ocurrido un error al procesar tu pedido. Por favor, inténtalo de nuevo.",
};

const pageData = { ...fallbackData, ...checkoutPageData };

const {
  pageTitle,
  addressSectionTitle,
  orderSummaryTitle,
  shippingCost,
  freeShippingThreshold,
  freeShippingText,
  confirmButtonText,
  aliasLabel,
  streetLabel,
  cityLabel,
  stateLabel,
  countryStateLabel,
  zipCodeLabel,
  countryLabel,
  notesLabel,
  aliasPlaceholder,
  streetPlaceholder,
  cityPlaceholder,
  statePlaceholder,
  countryStatePlaceholder,
  zipCodePlaceholder,
  countryPlaceholder,
  notesPlaceholder,
  addressIcon,
  summaryIcon,
  confirmIcon,
  shippingIcon,
  subtotalLabel,
  shippingLabel,
  totalLabel,
  emptyCartMessage,
  loadingText,
  errorMessage,
} = pageData;

const { metaTitle, metaDescription, keywords } = pageData.seo;
---

<Layout titulo={metaTitle} descripcion={metaDescription} keywords={keywords}>
  <section class="py-12 bg-bg-secondary min-h-[60vh]">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-4xl font-bold text-text-primary mb-8 text-center">
        {pageTitle}
      </h1>

      <!-- Error / Empty cart message -->
      <div id="error-container" class="hidden mb-6 p-4 bg-error-bg border border-error text-error rounded-lg">
        <p id="error-text"></p>
      </div>

      <!-- Main content -->
      <div class="grid lg:grid-cols-3 gap-8">

        <!-- Address Form (Left - 2 columns) -->
        <div class="lg:col-span-2">
          <div class="bg-bg-primary p-6 rounded-2xl border border-divider">
            <div class="flex items-center gap-2 mb-6">
              <Fragment set:html={addressIcon} />
              <h2 class="text-2xl font-bold text-text-primary">{addressSectionTitle}</h2>
            </div>

            <form id="checkout-form" class="space-y-4">

              <div>
                <label for="alias" class="block text-sm font-medium text-text-secondary mb-1">
                  {aliasLabel}
                </label>
                <input
                  type="text"
                  id="alias"
                  name="alias"
                  placeholder={aliasPlaceholder}
                  class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>

              <div>
                <label for="street" class="block text-sm font-medium text-text-secondary mb-1">
                  {streetLabel} <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  id="street"
                  name="street"
                  required
                  placeholder={streetPlaceholder}
                  class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>

              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label for="city" class="block text-sm font-medium text-text-secondary mb-1">
                    {cityLabel} <span class="text-error">*</span>
                  </label>
                  <input
                    type="text"
                    id="city"
                    name="city"
                    required
                    placeholder={cityPlaceholder}
                    class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>

                <div>
                  <label for="state" class="block text-sm font-medium text-text-secondary mb-1">
                    {stateLabel} <span class="text-error">*</span>
                  </label>
                  <input
                    type="text"
                    id="state"
                    name="state"
                    required
                    placeholder={statePlaceholder}
                    class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label for="countryState" class="block text-sm font-medium text-text-secondary mb-1">
                    {countryStateLabel}
                  </label>
                  <input
                    type="text"
                    id="countryState"
                    name="countryState"
                    placeholder={countryStatePlaceholder}
                    class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>

                <div>
                  <label for="zipCode" class="block text-sm font-medium text-text-secondary mb-1">
                    {zipCodeLabel} <span class="text-error">*</span>
                  </label>
                  <input
                    type="text"
                    id="zipCode"
                    name="zipCode"
                    required
                    placeholder={zipCodePlaceholder}
                    class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div>
                <label for="country" class="block text-sm font-medium text-text-secondary mb-1">
                  {countryLabel} <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  id="country"
                  name="country"
                  required
                  value="España"
                  placeholder={countryPlaceholder}
                  class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>

              <div>
                <label for="notes" class="block text-sm font-medium text-text-secondary mb-1">
                  {notesLabel}
                </label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  placeholder={notesPlaceholder}
                  class="w-full px-4 py-2 rounded-lg border border-divider bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-primary resize-none"
                ></textarea>
              </div>

            </form>
          </div>
        </div>

        <!-- Order Summary (Right - 1 column) -->
        <div class="lg:col-span-1">
          <div class="bg-bg-primary p-6 rounded-2xl border border-divider sticky top-24">
            <div class="flex items-center gap-2 mb-6">
              <Fragment set:html={summaryIcon} />
              <h2 class="text-2xl font-bold text-text-primary">{orderSummaryTitle}</h2>
            </div>

            <!-- Product list -->
            <div id="order-items" class="space-y-3 mb-6 max-h-60 overflow-y-auto">
              <!-- Products rendered by JS -->
            </div>

            <!-- Summary totals -->
            <div class="space-y-3 mb-6 border-t border-divider pt-4">
              <div class="flex justify-between text-text-secondary">
                <span>{subtotalLabel}</span>
                <span id="summary-subtotal">0,00€</span>
              </div>
              <div class="flex justify-between text-text-secondary items-center">
                <span class="flex items-center gap-2">
                  <Fragment set:html={shippingIcon} />
                  {shippingLabel}
                </span>
                <span id="summary-shipping">0,00€</span>
              </div>
              <div class="border-t border-divider pt-3 flex justify-between font-bold text-xl">
                <span>{totalLabel}</span>
                <span id="summary-total" class="text-primary">0,00€</span>
              </div>
            </div>

            <!-- Confirm button -->
            <button
              type="button"
              id="confirm-order-btn"
              class="w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-hover transition-colors flex items-center justify-center"
            >
              <Fragment set:html={confirmIcon} />
              {confirmButtonText}
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script
  define:vars={{
    shippingCost,
    freeShippingThreshold,
    freeShippingText,
    emptyCartMessage,
    loadingText,
    errorMessage,
  }}
>
  window.__checkoutConfig = {
    shippingCost,
    freeShippingThreshold,
    freeShippingText,
    emptyCartMessage,
    loadingText,
    errorMessage,
  };
</script>

<script>
  import { cartStore, clearCartOnLogout, initCartService } from "../utils/cartService";
  import type { CartItem } from "../utils/cartService";

  const {
    shippingCost,
    freeShippingThreshold,
    freeShippingText,
    emptyCartMessage,
    loadingText,
    errorMessage,
  } = (window as any).__checkoutConfig;

  const strapiBaseUrl = import.meta.env.PUBLIC_STRAPI_URL;

  // Verificar autenticación
  const jwt = localStorage.getItem('jwt');
  const userDocumentId = localStorage.getItem('userDocumentId');

  if (!jwt) {
    window.location.href = '/login?redirect=/checkout';
  }

  // Autorellenar formulario con direcciones guardadas
  async function loadUserAddress() {
    if (!jwt) return;

    try {
      const userRes = await fetch(`${strapiBaseUrl}/api/users/me?populate=addresses`, {
        headers: { Authorization: `Bearer ${jwt}` }
      });

      if (userRes.ok) {
        const userData = await userRes.json();
        const { addresses } = userData;

        if (addresses?.length > 0) {
          const defaultAddress = addresses.find((a: any) => a.isDefault) ?? addresses[0];
          const { alias, street, city, state, countryState, zipCode, country } = defaultAddress;

          const aliasInput = document.getElementById('alias') as HTMLInputElement;
          const streetInput = document.getElementById('street') as HTMLInputElement;
          const cityInput = document.getElementById('city') as HTMLInputElement;
          const stateInput = document.getElementById('state') as HTMLInputElement;
          const countryStateInput = document.getElementById('countryState') as HTMLInputElement;
          const zipCodeInput = document.getElementById('zipCode') as HTMLInputElement;
          const countryInput = document.getElementById('country') as HTMLInputElement;

          if (aliasInput && alias) aliasInput.value = alias;
          if (streetInput && street) streetInput.value = street;
          if (cityInput && city) cityInput.value = city;
          if (stateInput && state) stateInput.value = state;
          if (countryStateInput && countryState) countryStateInput.value = countryState;
          if (zipCodeInput && zipCode) zipCodeInput.value = zipCode;
          if (countryInput && country) countryInput.value = country;
        }
      }
    } catch (error) {
      console.error('[checkout] Error loading user address:', error);
    }
  }

  // DOM Elements
  const orderItemsContainer = document.getElementById("order-items");
  const summarySubtotal = document.getElementById("summary-subtotal");
  const summaryShipping = document.getElementById("summary-shipping");
  const summaryTotal = document.getElementById("summary-total");
  const confirmButton = document.getElementById("confirm-order-btn") as HTMLButtonElement | null;
  const checkoutForm = document.getElementById("checkout-form") as HTMLFormElement;
  const errorContainer = document.getElementById("error-container");
  const errorText = document.getElementById("error-text");

  // Helpers
  function fmt(amount: number): string {
    return `${amount.toLocaleString("es-ES", { minimumFractionDigits: 2 })}€`;
  }

  function showError(message: string) {
    if (errorText) errorText.textContent = message;
    errorContainer?.classList.remove("hidden");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function hideError() {
    errorContainer?.classList.add("hidden");
  }

  // Render order summary
  function renderOrderSummary(items: CartItem[]) {
    console.log('[checkout] renderOrderSummary llamado con items:', items);

    if (items.length === 0) {
      showError(emptyCartMessage);
      setTimeout(() => {
        window.location.href = "/carrito";
      }, 1000);
      return;
    }

    // Render product list
    if (orderItemsContainer) {
      orderItemsContainer.innerHTML = items
        .map(
          (item) => `
        <div class="flex justify-between text-sm">
          <span class="text-text-secondary">
            ${item.name} <span class="text-text-tertiary">x${item.quantity}</span>
          </span>
          <span class="text-text-primary font-medium">${fmt(item.unitPrice * item.quantity)}</span>
        </div>
      `
        )
        .join("");
    }

    // Calculate totals
    const subtotal = items.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);
    const shipping = subtotal >= freeShippingThreshold ? 0 : shippingCost;
    const total = subtotal + shipping;

    console.log('[checkout] Cálculos:', { subtotal, shipping, total, freeShippingThreshold, shippingCost });

    if (summarySubtotal) summarySubtotal.textContent = fmt(subtotal);
    if (summaryShipping) {
      summaryShipping.textContent = shipping === 0 ? freeShippingText : fmt(shipping);
      if (shipping === 0) {
        summaryShipping.classList.add("text-success", "font-medium");
      }
    }
    if (summaryTotal) summaryTotal.textContent = fmt(total);
  }

  // Handle order confirmation
  confirmButton?.addEventListener("click", async () => {
    hideError();

    // Validate form
    if (!checkoutForm.checkValidity()) {
      checkoutForm.reportValidity();
      return;
    }

    // Get form data
    const formData = new FormData(checkoutForm);
    const addressData = {
      alias: (formData.get("alias") as string | null) || "",
      street: (formData.get("street") as string | null) || "",
      city: (formData.get("city") as string | null) || "",
      state: (formData.get("state") as string | null) || "",
      countryState: (formData.get("countryState") as string | null) || "",
      zipCode: (formData.get("zipCode") as string | null) || "",
      country: (formData.get("country") as string | null) || "",
      isDefault: false,
    };

    const notes = (formData.get("notes") as string | null) || "";

    // Get cart items
    const storeValue = cartStore.get();
    let items: CartItem[] = [];
    try {
      items = JSON.parse(storeValue.items ?? "[]");
    } catch {
      items = [];
    }

    if (items.length === 0) {
      showError(emptyCartMessage);
      return;
    }

    // Calculate totals
    const subtotal = items.reduce((sum, item) => sum + item.unitPrice * item.quantity, 0);
    const shipping = subtotal >= freeShippingThreshold ? 0 : shippingCost;
    const total = subtotal + shipping;

    // Get JWT from localStorage
    const jwt = localStorage.getItem('jwt');

    if (!jwt) {
      window.location.href = "/login?redirect=/checkout";
      return;
    }

    // Disable button and show loading
    if (confirmButton) {
      confirmButton.disabled = true;
      confirmButton.textContent = loadingText;
    }

    try {
      const response = await fetch("/api/checkout", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          jwt,
          items,
          address: addressData,
          notes,
          subtotal,
          shippingCost: shipping,
          total,
        }),
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || errorMessage);
      }

      // Clear cart and redirect
      clearCartOnLogout();
      window.location.href = "/perfil";
    } catch (error) {
      console.error("Checkout error:", error);
      showError(error instanceof Error ? error.message : errorMessage);

      // Re-enable button
      if (confirmButton) {
        confirmButton.disabled = false;
        confirmButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag-check mr-2" viewBox="0 0 16 16">
    <path fill-rule="evenodd" d="M10.854 8.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
    <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
  </svg> ${confirmButton.textContent}`;
      }
    }
  });

  // Leer el store inmediatamente (ya fue cargado por Navigation)
  const readAndRender = () => {
    const state = cartStore.get();
    let items: CartItem[] = [];
    try {
      items = JSON.parse(state.items ?? "[]");
    } catch {
      items = [];
    }
    if (items.length > 0) {
      renderOrderSummary(items);
      return true;
    }
    return false;
  };

  // Suscribirse para cambios futuros
  cartStore.subscribe((state) => {
    let items: CartItem[] = [];
    try {
      items = JSON.parse(state.items ?? "[]");
    } catch {
      items = [];
    }
    renderOrderSummary(items);
  });

  // Intentar render inmediato
  if (!readAndRender()) {
    // Si el store está vacío, esperar a que initCartService cargue
    initCartService().then(() => {
      readAndRender();
    });
  }

  // Cargar dirección guardada del usuario
  loadUserAddress();
</script>
