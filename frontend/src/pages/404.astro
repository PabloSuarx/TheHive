---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro"
---

<Layout
  titulo="404 - Página no encontrada"
  descripcion="La página que buscas no existe. Vuelve al inicio para explorar nuestros productos de miel artesanal."
>
  <main
    class="min-h-screen flex items-center justify-center bg-linear-to-br from-warning/5 via-white to-warning/10"
  >
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-2xl mx-auto text-center">
        <!-- Icono animado -->
        <div class="mb-8 animate-swing">
          <img src="/bee-svgrepo-com.svg" alt="Abeja" class="w-32 h-32 mx-auto" />
        </div>

        <!-- Código de error -->
        <h1
          class="text-8xl lg:text-9xl font-bold text-transparent bg-clip-text bg-linear-to-r from-warning to-warning/60 mb-6"
        >
          404
        </h1>

        <!-- Título -->
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          ¡Ups! Esta colmena está vacía
        </h2>

        <!-- Descripción -->
        <p class="text-lg text-gray-600 mb-8 max-w-md mx-auto leading-relaxed">
          Parece que las abejas no han construido nada aquí todavía
        </p>

        <!-- Botones de acción -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <Button link="/" variant="primary">
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
            Volver al inicio
          </Button>

          <Button link="/productos" variant="outline">
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            Ver productos
          </Button>
        </div>

        <!-- Enlaces adicionales -->
        <div class="mt-12 pt-8 border-t border-gray-200">
          <p class="text-sm text-gray-500 mb-4">¿Necesitas ayuda?</p>
          <div class="flex flex-wrap gap-4 justify-center text-sm">
            <a href="/blog" class="text-warning hover:underline font-medium">
              Blog
            </a>
            <span class="text-gray-300">•</span>
            <a
              href="/categorias"
              class="text-warning hover:underline font-medium"
            >
              Categorías
            </a>
            <span class="text-gray-300">•</span>
            <a href="/contacto" class="text-warning hover:underline font-medium">
              Contacto
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes swing {
    0% {
      transform: rotate(-15deg);
    }
    50% {
      transform: rotate(15deg);
    }
    100% {
      transform: rotate(-15deg);
    }
  }

  .animate-swing {
    animation: swing 2s ease-in-out infinite;
  }
</style>