---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 - Página no encontrada | TheHive">
    <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-yellow-50 to-orange-50">
        <div class="text-center px-4">
            <div class="mb-8">
                <span class="text-9xl">🐝</span>
            </div>
            
            <h1 class="text-6xl font-bold text-gray-800 mb-4">404</h1>
            
            <h2 class="text-2xl font-semibold text-gray-600 mb-6">
                ¡Ups! Esta colmena está vacía
            </h2>
            
            <p class="text-gray-500 mb-8 max-w-md mx-auto">
                Parece que las abejas no han construido nada aquí todavía. 
                La página que buscas no existe.
            </p>
            
            <div class="flex gap-4 justify-center">
                <a 
                    href="/" 
                    class="px-6 py-3 bg-yellow-500 text-white font-semibold rounded-lg hover:bg-yellow-600 transition"
                >
                    🏠 Volver al inicio
                </a>
                
                <a 
                    href="/test-api" 
                    class="px-6 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition"
                >
                    🔌 Test API
                </a>
            </div>
        </div>
    </main>
</Layout>