---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro"
---

<Layout
  titulo="404 - Página no encontrada"
  descripcion="La página que buscas no existe. Vuelve al inicio para explorar nuestros productos de miel artesanal."
>
  <main
    class="min-h-screen flex items-center justify-center bg-linear-to-br from-warning/5 via-bg-primary to-warning/10"
  >
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-2xl mx-auto text-center">
        <!-- Icono animado -->
        <div class="mb-8 animate-swing">
          <img src="/bee-svgrepo-com.svg" alt="Abeja" class="w-32 h-32 mx-auto" />
        </div>

        <!-- Código de error -->
        <h1
          class="text-8xl lg:text-9xl font-bold text-transparent bg-clip-text bg-linear-to-r from-warning to-warning/60 mb-6"
        >
          404
        </h1>

        <!-- Título -->
        <h2 class="text-3xl lg:text-4xl font-bold text-text-primary mb-4">
          ¡Ups! Esta colmena está vacía
        </h2>

        <!-- Descripción -->
        <p class="text-lg text-text-secondary mb-8 max-w-md mx-auto leading-relaxed">
          Parece que las abejas no han construido nada aquí todavía
        </p>

        <!-- Botones de acción -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <Button link="/" variant="primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-door mr-2" viewBox="0 0 16 16">
              <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
            </svg>
            Volver al inicio
          </Button>

          <Button link="/productos" variant="outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag mr-2" viewBox="0 0 16 16">
              <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
            </svg>
            Ver productos
          </Button>
        </div>

        <!-- Enlaces adicionales -->
        <div class="mt-12 pt-8 border-t border-divider">
          <p class="text-sm text-text-tertiary mb-4">¿Necesitas ayuda?</p>
          <div class="flex flex-wrap gap-4 justify-center text-sm">
            <a href="/blog" class="text-text-secondary hover:text-primary font-medium transition-colors">
              Blog
            </a>
            <span class="text-divider">•</span>
            <a
              href="/categorias"
              class="text-text-secondary hover:text-primary font-medium transition-colors"
            >
              Categorías
            </a>
            <span class="text-divider">•</span>
            <a href="/contacto" class="text-text-secondary hover:text-primary font-medium transition-colors">
              Contacto
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>


<style>
  @keyframes swing {
    0% {
      transform: rotate(-15deg);
    }
    50% {
      transform: rotate(15deg);
    }
    100% {
      transform: rotate(-15deg);
    }
  }

  .animate-swing {
    animation: swing 2s ease-in-out infinite;
  }
</style>