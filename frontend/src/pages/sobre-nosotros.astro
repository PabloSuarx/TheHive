---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro"
import { get } from "../lib/strapi";
import { Image } from "astro:assets";

const PUBLIC_STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL;

// Fetch data from Strapi 'sobre-nosotros' single type
const sobreNosotrosData = await get("sobre-nosotros", {
  populate: "*",
});

// Fallback data if Strapi content is not yet created
const fallbackData = {
  title: "Sobre Nosotros",
  subtitle: "Nuestra historia, misión y valores",
  content: `
    <p>En The Hive, nos dedicamos a ofrecer la miel más pura y natural, directamente de apicultores locales comprometidos con la sostenibilidad y el bienestar de las abejas.</p>
    <p>Nuestra historia comenzó con una simple pasión por los productos naturales y el deseo de conectar a las personas con el origen de sus alimentos. Hoy, trabajamos con una red de apicultores artesanos que comparten nuestra visión.</p>
    <p>Creemos en la transparencia, la calidad y el respeto por la naturaleza. Cada frasco de miel que ofrecemos es un testimonio del trabajo arduo de las abejas y del cuidado de quienes las protegen.</p>
  `,
  heroImage: null,
  metaDescription: "Conoce la historia detrás de The Hive, nuestra misión y los valores que nos guían.",
  CardComponent: [
    { id: 1, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-patch-check text-primary mb-2" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M10.354 6.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                <path d="m10.273 2.513-.921-.944.715-.698.622.637.89-.011a2.89 2.89 0 0 1 2.924 2.924l-.01.89.636.622a2.89 2.89 0 0 1 0 4.134l-.637.622.011.89a2.89 2.89 0 0 1-2.924 2.924l-.89-.01-.622.636a2.89 2.89 0 0 1-4.134 0l-.622-.637-.89.011a2.89 2.89 0 0 1-2.924-2.924l.01-.89-.636-.622a2.89 2.89 0 0 1 0-4.134l.637-.622-.011-.89a2.89 2.89 0 0 1 2.924-2.924l.89.01.622-.636a2.89 2.89 0 0 1 4.134 0l-.715.698a1.89 1.89 0 0 0-2.704 0l-.92.944-1.32-.016a1.89 1.89 0 0 0-1.911 1.912l.016 1.318-.944.921a1.89 1.89 0 0 0 0 2.704l.944.92-.016 1.32a1.89 1.89 0 0 0 1.912 1.911l1.318-.016.921.944a1.89 1.89 0 0 0 2.704 0l.92-.944 1.32.016a1.89 1.89 0 0 0 1.911-1.912l-.016-1.318.944-.921a1.89 1.89 0 0 0 0-2.704l-.944-.92.016-1.32a1.89 1.89 0 0 0-1.912-1.911z"/>
              </svg>`, title: "100% Natural", description: "Sin aditivos ni procesados." },
    { id: 2, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-heart text-primary mb-2" viewBox="0 0 16 16">
                <path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01zM8 15C-7.333 4.868 3.279-3.04 7.824 1.143q.09.083.176.171a3 3 0 0 1 .176-.17C12.72-3.042 23.333 4.867 8 15"/>
              </svg>`, title: "Comercio Justo", description: "Apoyo a apicultores locales." }
  ],
  seo: {
    metaTitle: "Sobre Nosotros",
    metaDescription: "Conoce la historia detrás de The Hive, nuestra misión y los valores que nos guían.",
    keywords: ""
  }
};

// Combine Strapi data with fallback
const pageData = { ...fallbackData, ...sobreNosotrosData };

// Destructure all fields
const {
  title,
  subtitle,
  content,
  heroImage,
  metaDescription,
  CardComponent,
  seo,
} = pageData;

// Process hero image URL
const heroImageUrl = heroImage?.url
  ? (heroImage.url.startsWith('http') ? heroImage.url : `${PUBLIC_STRAPI_URL}${heroImage.url}`)
  : "/placeholder.svg";
---

<Layout
  titulo={seo?.metaTitle || title}
  descripcion={seo?.metaDescription || metaDescription}
>
  <!-- Hero Section -->
  <section class="py-12 bg-bg-primary border-b border-border-default">
    <div class="container mx-auto px-4 lg:px-8">
      <Breadcrumbs separator="/" homeLabel="Inicio" />
      <h1 class="text-4xl font-bold text-text-primary mb-2">{title}</h1>
      <p class="text-lg text-text-secondary max-w-2xl">
        {subtitle}
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-bg-primary">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">

        <!-- Image Column -->
        <div class="relative rounded-2xl overflow-hidden aspect-square lg:aspect-4/3 group">
          <div class="absolute inset-0 bg-primary/10 group-hover:bg-transparent transition-colors duration-500"></div>
           <Image
            src={heroImageUrl}
            alt="Sobre Nosotros"
            width={800}
            height={600}
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            loading="eager"
          />
        </div>

        <!-- Text Column -->
        <div>
           <div class="prose prose-lg prose-amber text-text-secondary">
             <Fragment set:html={content} />
           </div>

           <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
             {CardComponent.map((card :any) => (
               <div class="bg-bg-secondary p-4 lg:p-6 rounded-xl border border-border-default transition-colors hover:bg-bg-tertiary">
                 <span class="flex items-center justify-center" set:html={card.icon} />
                 <h3 class="font-bold text-text-primary mb-1">{card.title}</h3>
                 <p class="text-sm text-text-tertiary">{card.description}</p>
               </div>
             ))}
           </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
